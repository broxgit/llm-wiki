# ---- glab: the one way to GitLab -------------------------------------------------------------

class GlabMissing(Exception):
    pass


class GlabTimeout(Exception):
    pass


class GlabTooBig(Exception):
    pass


class NotGitLab(Exception):
    """The folder isn't a clone of a project GitLab knows, or the project can't be seen."""


def run_glab(args, timeout=30, cwd=None, tail=None):
    """(exit code, stdout, stderr) of one glab call, as bytes for stdout. Never asks a question, never waits for ever.
    With tail, only the last `tail` bytes of the answer are kept as it is read, so a huge log is never held whole, and
    glab is stopped after TOTAL_BYTES of it. Without it, an answer of more than JSON_BYTES is refused. At most 64 KB of
    what glab says on stderr is kept, and the rest is read and thrown away."""
    env = cc.git_env()   # the environment, without the variables that would point git at another repository
    env["NO_PROMPT"] = "1"
    env["NO_COLOR"] = "1"
    env["GLAB_CHECK_UPDATE"] = "false"
    env["GLAB_SEND_TELEMETRY"] = "false"
    timed_out = []
    try:
        p = subprocess.Popen([GLAB_BIN] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd, env=env)
    except (FileNotFoundError, PermissionError):
        raise GlabMissing()
    errors = bytearray()

    def drain():
        while True:
            chunk = p.stderr.read(65536)
            if not chunk:
                break
            if len(errors) < ERR_BYTES:
                errors.extend(chunk[:ERR_BYTES - len(errors)])

    def stop():
        timed_out.append(1)
        try:
            p.kill()
        except OSError:
            pass

    reader = threading.Thread(target=drain, daemon=True)
    reader.start()
    timer = threading.Timer(timeout, stop)
    timer.start()
    buf = bytearray()
    cut = False
    big = False
    total = 0
    try:
        while True:
            chunk = p.stdout.read(65536)
            if not chunk:
                break
            total += len(chunk)
            buf += chunk
            if tail and len(buf) > tail:
                del buf[:len(buf) - tail]
                cut = True
            elif not tail and len(buf) > JSON_BYTES:
                big = True
            if tail and total > TOTAL_BYTES:
                big = True
            if big:
                p.kill()
                break
        code = p.wait()
    finally:
        timer.cancel()
        p.stdout.close()
        if p.poll() is None:
            p.kill()
            p.wait()
    reader.join(5)
    p.stderr.close()
    if timed_out:
        raise GlabTimeout()
    if big:
        raise GlabTooBig()
    out = bytes(buf)
    if cut and b"\n" in out:
        out = out.split(b"\n", 1)[1]
    return code, out, bytes(errors).decode("utf-8", "replace")


def glab_missing():
    if EVENT:
        not_now("glab isn't installed")
    die("glab isn't installed, so GitLab can't be read. Do: install the GitLab CLI from https://gitlab.com/gitlab-org/cli, then run: glab auth login")


def need_sign_in():
    if EVENT:
        not_now("glab isn't signed in to GitLab")
    die("glab isn't signed in to GitLab. Run: glab auth login")


NETWORK = ("error connecting", "dial tcp", "no such host", "could not resolve", "timeout", "timed out", "network is unreachable",
           "connection refused", "connection reset", "tls handshake", "i/o timeout", "unexpected eof", "proxyconnect", "service unavailable",
           "bad gateway", "gateway timeout", "502", "503", "504")
SIGNED_OUT = ("401", "unauthorized", "not logged in", "no token", "glab auth login", "authentication", "invalid token", "token expired")


def looks_offline(err):
    low = err.lower()
    return any(p in low for p in NETWORK)


def looks_signed_out(err):
    low = err.lower()
    return any(p in low for p in SIGNED_OUT)


def signed_in(cwd=None):
    """Whether glab holds a sign-in that works. Offline is no answer: it is for later."""
    try:
        code, _, err = run_glab(["auth", "status"], timeout=20, cwd=cwd)
    except GlabMissing:
        glab_missing()
    except GlabTimeout:
        unreachable("glab took more than 20 seconds to check the sign-in")
    except GlabTooBig:
        return True
    if code != 0 and looks_offline(err):
        unreachable(f"glab couldn't check the sign-in: {first_line(err)}")
    return code == 0


def glab_failed(what, err, soft, cwd, first=False):
    if looks_offline(err):
        unreachable(f"glab couldn't {what}: {first_line(err)}")
    if looks_signed_out(err) or not signed_in(cwd):
        need_sign_in()
    if first:
        raise NotGitLab(first_line(err))
    if soft:
        return None
    unreachable(f"glab couldn't {what}: {first_line(err) or 'no reason given'}")


def glab_get(endpoint, what, timeout=30, cwd=None, soft=False, tail=None, first=False):
    """The answer to one GET of `glab api`, as bytes. When it didn't work: NotGitLab for a folder GitLab doesn't know
    (only when first), an exit for no glab, no sign-in or no network, or None when soft and that is all. The
    endpoint is built here from numbers and from names that have been checked, and goes to glab as one argument."""
    try:
        code, out, err = run_glab(["api", "--method", "GET", endpoint], timeout, cwd, tail=tail)
    except GlabMissing:
        glab_missing()
    except GlabTimeout:
        unreachable(f"glab took more than {timeout} seconds to {what}")
    except GlabTooBig:
        if soft:
            return None
        unreachable(f"glab answered with more than {JSON_BYTES // 1024 // 1024} MB when asked to {what}")
    if code != 0:
        return glab_failed(what, err, soft, cwd, first)
    return out


def glab_json(endpoint, what, **kw):
    out = glab_get(endpoint, what, **kw)
    if out is None:
        return None
    try:
        return json.loads(out.decode("utf-8", "replace"))
    except (ValueError, RecursionError):
        unreachable(f"glab didn't answer with JSON when asked to {what}")


# ---- the project, its branches and its newest pipelines -----------------------------------------------

PROJECT_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)+$")
BRANCH_OK = re.compile(r"^[A-Za-z0-9._/-]+$")


def branch_ok(b):
    """A branch name that can go into an address and be passed as an argument: no .., no leading -."""
    return isinstance(b, str) and 0 < len(b) <= 250 and bool(BRANCH_OK.fullmatch(b)) and ".." not in b and not b.startswith("-")


def git(folder, *args):
    return cc.git(folder, *args)


def int_or_none(v):
    """A positive integer, which is what every id from GitLab is, or nothing."""
    return v if isinstance(v, int) and not isinstance(v, bool) and v > 0 else None


class OutOfTime(Exception):
    """One project has used the time a tick gives it."""


DEADLINE = [0.0]


def budget():
    if DEADLINE[0] and time.time() > DEADLINE[0]:
        raise OutOfTime()


def local_name(folder):
    """<namespace>/<project> from the clone's own origin address, which is the clone's word and not the server's: the
    path after the host, without .git. Nothing if there is no origin, or it isn't a name GitLab could have."""
    url = git(folder, "config", "--get", "remote.origin.url").strip()
    path = ""
    if "://" in url:
        path = urllib.parse.urlsplit(url).path
    elif re.match(r"^[^/@\s]+@[^:/\s]+:", url) or re.match(r"^[^/@\s:]+:[^/]", url):
        path = url.split(":", 1)[1]
    path = path.strip("/")
    if path.endswith(".git"):
        path = path[:-4]
    return path if PROJECT_NAME.fullmatch(path) else ""


def repo_info(folder):
    """The project the folder is a clone of: its path as the clone's origin says it, which the server must agree with,
    its default branch and address."""
    mine = local_name(folder)
    if not mine:
        raise NotGitLab("the clone has no origin address that names a GitLab project")
    d = glab_json("projects/:fullpath", "look up the project", cwd=folder, first=True)
    name = d.get("path_with_namespace") if isinstance(d, dict) else ""
    if not isinstance(name, str) or not PROJECT_NAME.fullmatch(name):
        raise NotGitLab("glab didn't name a project")
    if name.lower() != mine.lower():
        raise NotGitLab("glab found another project than the clone's origin names")
    default = d.get("default_branch") if isinstance(d.get("default_branch"), str) else ""
    return {"name": mine, "default": clean(default, 250), "url": clean(d.get("web_url") or "", 300)}


def iso_z(text):
    """A GitLab time as the form stale() reads, or nothing."""
    m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d+)?(Z|[+-]\d\d:?\d\d)?$", text or "")
    if not m:
        return ""
    base, zone = m.group(1), m.group(2)
    try:
        when = datetime.datetime.strptime(base, "%Y-%m-%dT%H:%M:%S")
        if zone and zone != "Z":
            sign = 1 if zone[0] == "+" else -1
            digits = zone[1:].replace(":", "")
            when = when - sign * datetime.timedelta(hours=int(digits[:2]), minutes=int(digits[2:]))
        return when.strftime("%Y-%m-%dT%H:%M:%SZ")
    except (ValueError, OverflowError):
        return ""


def fetch(folder, info):
    """(branches, [newest pipeline of each kind on each branch], {branch: merge request number}). A merge request
    from a fork is left out: its branch is not this project's. Every item the server sends is checked before it is used."""
    prs = {}
    budget()
    listed = glab_json(f"projects/:id/merge_requests?scope=created_by_me&state=opened&per_page={MAX_MRS}",
                       "list your open merge requests", cwd=folder, soft=True)
    info["mrs_listed"] = isinstance(listed, list)
    for m in (listed if isinstance(listed, list) else [])[:MAX_MRS]:
        if not isinstance(m, dict):
            continue
        n, b = int_or_none(m.get("iid")), m.get("source_branch")
        if n is None or not branch_ok(b):
            continue
        src, dst = m.get("source_project_id"), m.get("target_project_id")
        if src is None or src != dst:
            continue
        prs[b] = n
        info.setdefault("mrs", {})[n] = {"branch": b, "notes": count_or_none(m.get("user_notes_count")), "me": user_of(m.get("author"))}
    branches = []
    for b in [clean(git(folder, "branch", "--show-current"), 250), info["default"]] + list(prs):
        if branch_ok(b) and b not in branches:
            branches.append(b)
    runs = []
    for b in branches:
        # A merge request's own pipelines are on refs/merge-requests/<number>/head, not on its branch.
        refs = [b] + ([f"refs/merge-requests/{prs[b]}/head"] if b in prs else [])
        by_kind = {}
        for ref in refs:
            budget()
            rows = glab_json(f"projects/:id/pipelines?ref={urllib.parse.quote(ref, safe='')}&per_page=20", f"list the pipelines on {b}", cwd=folder)
            for r in (rows if isinstance(rows, list) else [])[:MAX_ROWS]:
                if not isinstance(r, dict):
                    continue
                rid = int_or_none(r.get("id"))
                if rid is None:
                    continue
                kind = clean(r.get("source") or "unknown", 40)
                sha = clean(r.get("sha") or "", 64)
                o = {"id": rid, "wfid": kind, "source": kind, "workflow": f"pipeline ({kind})", "branch": b,
                     "status": clean(r.get("status") or "", 30), "conclusion": clean(r.get("status") or "", 30),
                     "sha": sha if re.fullmatch(r"[0-9a-fA-F]{7,64}", sha) else "",
                     "url": clean(r.get("web_url") or "", 300), "pr": prs.get(b), "created": iso_z(clean(r.get("created_at") or "", 40))}
                if kind not in by_kind or rid > by_kind[kind]["id"]:
                    by_kind[kind] = o
        newest = sorted(by_kind, key=lambda k: by_kind[k]["id"], reverse=True)[:MAX_KINDS]
        runs.extend(by_kind[k] for k in sorted(newest))
    return branches, runs, prs


def failing(o):
    return o["status"] in FAILING


def passing(o):
    return o["status"] in PASSING


# ---- the failing job, its log, its signature ---------------------------------------------------------

SECTION = re.compile(r"section_(?:start|end):\d+:[A-Za-z0-9_.-]+(?:\[[^\]\r\n]*\])?\r?")


def failure_detail(info, o, folder):
    """Why a pipeline failed: its first failing job, the signature of the error and the saved excerpt. Reads GitLab only."""
    repo = info["name"]
    budget()
    rows = glab_json(f"projects/:id/pipelines/{int(o['id'])}/jobs?scope%5B%5D=failed&per_page=100", "read the pipeline's jobs", cwd=folder)
    jobs = [j for j in rows if isinstance(j, dict)] if isinstance(rows, list) else []
    failed = [j for j in jobs if j.get("status") == "failed"]
    bad = sorted((j for j in failed if not j.get("allow_failure")), key=lambda j: int_or_none(j.get("id")) or 0)
    job = bad[0] if bad else {}
    job_name = clean(job.get("name") or "-", 100)
    stage = clean(job.get("stage") or "-", 100)
    job_id = int_or_none(job.get("id")) or 0
    lines = []
    if job_id:
        raw = glab_get(f"projects/:id/jobs/{job_id}/trace", "read the failing job's log", timeout=60, cwd=folder, soft=True, tail=TRACE_BYTES)
        lines = cc.excerpt_lines(cc.log_lines(raw, SECTION)) if raw else []
    path = cc.save_excerpt(STATE_DIR, LOG_DIR, repo.replace("/", "__"), f"{int(o['id'])}-{job_id}.txt", lines) if lines else ""
    sig = signature_of(lines, job_name, "job") if job_id else "the pipeline failed, with no failing job to read"
    return {"job": job_name, "stage": stage, "signature": sig, "excerpt": path, "more": max(0, len(bad) - 1),
            "allowed": len(failed) - len(bad)}


# ---- check ---------------------------------------------------------------------------------------

def check_project(info, folder):
    branches, runs, prs = fetch(folder, info)
    repo = info["name"]
    bad = [o for o in runs if failing(o)]
    running = [o for o in runs if o["status"] in RUNNING]
    print(f"== {repo}  (looked at: {', '.join(branches) or 'no branch'})")
    for o in bad:
        d = failure_detail(info, o, folder)
        where = known_in_wikis(d["signature"])
        print(f"FAILING  {o['workflow']} on {o['branch']}" + (f" (merge request !{o['pr']})" if o["pr"] else ""))
        print(f"  pipeline: {o['url'] or o['id']}")
        print(f"  job:      {d['job']}" + (f"  (and {d['more']} more failing job(s))" if d["more"] else ""))
        print(f"  stage:    {d['stage']}")
        print(f"  error:    {d['signature']}")
        if where is None:
            print("  known:    not looked up (no wiki command to ask)")
        elif where:
            print(f"  known:    yes, in {where}")
        else:
            print("  known:    no wiki or note holds it yet")
        print(f"  log:      {d['excerpt'] or 'none kept: GitLab has no log for this job'}")
        if d["allowed"]:
            print(f"  allowed:  {d['allowed']} job(s) that are allowed to fail also failed, and are not counted")
    if not bad:
        print(f"Nothing is failing in CI for {repo}." if runs else f"No pipelines were found for {repo} on those branches.")
    if running:
        print("Still running: " + "; ".join(f"{o['workflow']} on {o['branch']}" for o in running) + ".")
    return 0


def cmd_check(args):
    rest = [a for a in args]
    if any(a.startswith("-") for a in rest) or len(rest) > 1:
        die_usage(f"check takes one folder, and no option. Run: {CMD} gitlab --help")
    folder = os.path.abspath(os.path.expanduser(rest[0])) if rest else os.getcwd()
    if not os.path.isdir(folder):
        die_usage(f"{rest[0] if rest else folder} isn't a command or a folder. Run: {CMD} gitlab --help")
    try:
        info = repo_info(folder)
    except NotGitLab as e:
        die(f"{folder} isn't a clone of a GitLab project" + (f" (glab says: {e})" if str(e) else "")
            + f". Do: run this in a clone, or name one: {CMD} gitlab check <folder>")
    DEADLINE[0] = time.time() + FOLDER_SECONDS
    try:
        return check_project(info, folder)
    except OutOfTime:
        die(f"{info['name']} took more than {FOLDER_SECONDS} seconds to read. Do: run it again, or later: {CMD} gitlab check {folder}")
    finally:
        DEADLINE[0] = 0.0


# ---- watch ---------------------------------------------------------------------------------------

def folder_arg(args, what):
    return cc.folder_arg(args, what, "gitlab")


def write_watch(paths):
    cc.write_watch(CONFIG, paths)


def clone_top(folder):
    return cc.clone_top(folder)


def cmd_watch(args):
    if args == ["--list"]:
        paths = watched()
        if not paths:
            print(f"No folders are watched. Run: {CMD} gitlab watch <folder>")
        for p in paths:
            print(p + ("" if os.path.isdir(p) else "  (gone)"))
        return 0
    folder = folder_arg(args, "watch")
    top = clone_top(folder)
    if not top:
        die(f"{folder} isn't in a git clone. Do: run this in a clone of a GitLab project, or name one")
    if "," in top or "#" in top:
        die(f"{top} has a comma or a # in its path, which the settings file can't hold. Do: watch a clone whose path has neither")
    paths = watched()
    if top in [os.path.realpath(p) for p in paths]:
        print(f"{top} is already watched.")
        return 0
    write_watch(paths + [top])
    print(f"Watching {top}. The tick event looks at it with the other watched folders, once a day unless {CMD} extensions every gitlab says otherwise.")
    print(f"To look now: {CMD} gitlab check {top}")
    return 0


def cmd_unwatch(args):
    folder = folder_arg(args, "unwatch")
    top = clone_top(folder) or folder
    paths = watched()
    keep = [p for p in paths if os.path.realpath(p) != top and p != top and p != folder]
    if len(keep) == len(paths):
        print(f"{top} wasn't watched.")
        return 0
    write_watch(keep)
    print(f"No longer watching {top}.")
    return 0


def cmd_config(args):
    if args:
        die_usage("config takes no arguments")
    conf = settings()
    exe = shutil.which(GLAB_BIN)
    print(f"file      {CONFIG}{'' if os.path.isfile(CONFIG) else ' (not there yet)'}")
    print(f"glab      {exe or 'not installed'}")
    ok = False
