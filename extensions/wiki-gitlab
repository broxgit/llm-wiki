# True while llm-wiki runs this for an event, in the background, with nobody watching.
EVENT = False


def not_now(msg):
    """During an event, no glab or no sign-in or no network is for later: 75 asks llm-wiki to try again."""
    print(f"not now: {msg}")
    sys.exit(75)


def unreachable(msg):
    if EVENT:
        not_now(msg)
    die(f"{msg}. Do: check the network, then run: {CMD} gitlab check")


