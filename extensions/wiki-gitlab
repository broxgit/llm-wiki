        except (GlabMissing, GlabTimeout, GlabTooBig):
            ok = False
    print(f"signed in {'yes' if ok else 'no'}")
    print(f"watch     {', '.join(conf['watch']) or 'none'}")
    print(f"remember  {'yes' if conf['remember'] else 'no'}")
    print(f"notice    {'yes' if conf['notice'] else 'no'}")
    print(f"desktop   {'yes' if conf['desktop'] else 'no'}")
    print(f"comments  {'yes' if conf['comments'] else 'no'}")
