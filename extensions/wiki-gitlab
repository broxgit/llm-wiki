TOTAL_BYTES = 64 * 1024 * 1024        # and the most of a log that glab is let to send before it is stopped
ERR_BYTES = 64 * 1024                # the most of glab's own messages that is kept
FOLDER_SECONDS = min(60, int(os.environ.get("LLM_WIKI_FOLDER_SECONDS") or 60))   # one project's time in a tick; a test can only lower it
