NOTE_LINES = 12                      # lines of one comment that are shown
NOTE_CHARS = 1200                    # and characters
TRACE_BYTES = 2000000                # the most of a job's log that is read: its end
JSON_BYTES = 32 * 1024 * 1024        # the most of any other answer that is read
DEFAULTS = {"remember": "no", "notice": "yes", "desktop": "yes"}
# A pipeline that failed. canceled, skipped and manual say nothing about whether the code is fine, so they leave the
