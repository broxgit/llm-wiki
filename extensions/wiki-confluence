            set_conf(SHARED, "token_cmd", "security find-generic-password -s atlassian -w")
    else:
        cmd = ask("A command that prints the token, such as: pass show atlassian", "")
        set_conf(SHARED, "token_cmd", cmd)


def origin(url):
    u = urllib.parse.urlsplit(url)
    port = u.port or (443 if u.scheme == "https" else 80)
    return (u.scheme, (u.hostname or "").lower(), port)


class SameOrigin(urllib.request.HTTPRedirectHandler):
    """A redirect is followed only to the same address it came from: the sign-in is never sent
    anywhere else. urllib's own handler carries the Authorization header to wherever a
    redirect points, another host or plain http included."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        try:
            if origin(urllib.parse.urljoin(req.full_url, newurl)) != origin(req.full_url):
                return None
        except ValueError:
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


# What a server's certificate is checked against: Python's own list and what the user chose, with wiki extensions certs.
TRUST_PROBLEM = ""
_handlers = [SameOrigin]
if tls_trust:
    try:
        _handlers.append(tls_trust.https_handler())
    except tls_trust.Problem as e:
        TRUST_PROBLEM = str(e)
OPENER = urllib.request.build_opener(*_handlers)


def no_answer(e, url):
    """A request that got no answer. A certificate that was refused says so, with the command that fixes it."""
    unreachable((tls_trust.hint(e, url) if tls_trust else None) or f"can't reach {url}: {getattr(e, 'reason', e)}")


def address_trouble():
    """The first address that is set, from the environment or a file, and can't be used, as "<setting> <why>", or nothing.
    An address that fails is not used: nothing is asked of Confluence, and no token is fetched."""
    shared = read_conf(SHARED)
    own = read_conf(CONFIG)
    jira = read_conf(os.path.join(CONFIG_DIR, "jira"))
    for name, value in (("CONFLUENCE_URL", os.environ.get("CONFLUENCE_URL")), ("ATLASSIAN_SITE", os.environ.get("ATLASSIAN_SITE")),
                        (f"url in {CONFIG}", own.get("url")), (f"site in {SHARED}", shared.get("site")),
                        (f"url in {os.path.join(CONFIG_DIR, 'jira')}", jira.get("url"))):
        # As written, not stripped: a leading space is a fault here, and would otherwise
        # pass this check and fail later, after the token was fetched.
        if value and address_problem(value):
            return f"{name} {address_problem(value)}"
    return ""


def sign_in_missing(conf):
    """What the sign-in lacks, in a few words, or nothing."""
    if address_trouble():
        return address_trouble()
    if not conf["url"]:
        site = os.environ.get("ATLASSIAN_SITE") or read_conf(SHARED).get("site") or ""
        if site:
            return f"no Confluence address yet: {site} isn't on Atlassian Cloud, so Confluence's own address is needed"
        return "no Confluence address yet"
    if not has_token(conf):
        return "no API token yet"
    return ""


def need_sign_in(conf):
    msg = sign_in_missing(conf)
    if msg:
        die(f"Confluence isn't set up: {msg}. Run: {CMD} extensions setup confluence. {GUIDE}")


def watch_lists(conf):
    """{wiki: [what it watches, as written]} from the watch.<wiki> settings."""
    out = {}
    for k in sorted(conf):
        if k.startswith("watch.") and conf[k].strip():
            out[k[len("watch."):]] = [t.strip() for t in conf[k].split(",") if t.strip()]
    return out


def done_states(conf):
    return [x.strip().lower() for x in (conf.get("done_states") or "Verified").split(",") if x.strip()]


def not_ready(conf):
    """What it lacks before it can do anything, in a few words, or nothing."""
    msg = sign_in_missing(conf)
    if msg:
        return msg
    if not watch_lists(conf) and not conf.get("space"):
        return "nothing chosen yet: no pages to watch, and no space to publish into"
    return ""


