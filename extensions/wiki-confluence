# Where a value came from, in the words --wiki-settings uses.
SOURCES = {"this file": "file", "the shared file": "shared file", "token_cmd": "file",
           "token_cmd in the shared file": "shared file", "Jira's settings": "file",
           "token_cmd in Jira's settings": "file"}


def source_name(src):
    if not src:
        return "default"
    if src in SOURCES:
        return SOURCES[src]
    return f"environment ({src})"


def own_value(own, env_name, key):
    """A setting of Confluence's own, from the environment (where there is a name for it) or its file."""
    if env_name and os.environ.get(env_name):
        return os.environ[env_name], source_name(env_name)
    if own.get(key):
        return own[key], "file"
    return "", "default"


PUBLISH = "Publishing writes to Confluence, so the user sets it in a terminal: " + f"{CMD} extensions setup confluence"


def on_mac():
    """Whether the keychain preset fits this machine. LLM_WIKI_TEST_OS lets the tests see both answers."""
    return (os.environ.get("LLM_WIKI_TEST_OS") or sys.platform) == "darwin"


def setting_rows():
    """One row for each setting a session may look at: key, value, where from, meaning, and
    whether a session can change it. Reads files and the environment only: it never runs
    token_cmd and never touches the network, and a token's value is never in it."""
    own = read_conf(CONFIG)
    shared = read_conf(SHARED)
    jira = read_conf(os.path.join(CONFIG_DIR, "jira"))
    conf = settings()
    src = conf["_from"]
    mac = on_mac()
    if os.environ.get("ATLASSIAN_SITE"):
        site, site_from = os.environ["ATLASSIAN_SITE"], "environment (ATLASSIAN_SITE)"
    elif shared.get("site"):
        site, site_from = shared["site"], "shared file"
    else:
        site, site_from = jira.get("url", ""), ("file" if jira.get("url") else "default")
    rows = [
        ("site", site.rstrip("/"), site_from, "The Atlassian site, such as https://your-company.atlassian.net. On Cloud, Confluence is at its /wiki", "set"),
        ("email", conf.get("email", ""), source_name(src["email"]), "Your Atlassian account's email. Empty on Data Center", "set"),
    ]
    tok_env = next((n for n in TOKEN_ENV if os.environ.get(n)), "")
    tok_from = source_name(tok_env) if tok_env else (source_name(src["token_cmd"]) if conf.get("token_cmd") else "")
    rows.append(("token", "set" if tok_env else ("not checked (token_cmd is set)" if conf.get("token_cmd") else "not set"), tok_from,
                 "The user makes one at https://id.atlassian.com/manage-profile/security/api-tokens "
                 "(Data Center: a personal access token) and "
                 + ("runs in their own terminal: security add-generic-password -a \"$USER\" -s atlassian -U -w \"$(pbpaste)\""
                    if mac else "keeps it in their own password manager, such as pass"), "terminal"))
    cmd = conf.get("token_cmd", "")
    shown = "keychain" if cmd == KEYCHAIN_CMD else ("custom command" if cmd else "")
    if mac:
        what = f"Then set this to keychain, and run {CMD} confluence config, which contacts the site, to test sign-in"
    else:
        what = f"A command that prints the token, such as pass show atlassian. The user sets it in a terminal: {CMD} extensions setup confluence"
    rows.append(("token_cmd", shown, source_name(src["token_cmd"]) if cmd else "default", what, "set" if mac else "terminal"))
    url, url_from = own_value(own, "CONFLUENCE_URL", "url")
    rows.append(("url", url, url_from, "Confluence's own address, only where the site isn't on Atlassian Cloud", "set"))
    watching = sorted(k for k in own if k.startswith("watch.") and own[k].strip())
    watch_what = "Pages that wiki hears about when they change: page addresses or ids, or space:KEY for a whole space. Watching only reads"
    for k in watching:
        rows.append((k, own[k], "file", watch_what, "set"))
    if not watching:
        rows.append(("watch.<wiki>", "", "default", watch_what, "set"))
    value, where = own_value(own, "", "done_states")
    rows.append(("done_states", value, where, "Page statuses that mean finished, which close an open item that links the page. Verified if unset", "set"))
    for key, env_name in (("space", "CONFLUENCE_SPACE"), ("auto", "CONFLUENCE_AUTO")):
        value, where = own_value(own, env_name, key)
        rows.append((key, value, where, PUBLISH, "terminal"))
    for k in sorted(own):
        if k.startswith(("space.", "parent")) and own[k]:
            rows.append((k, own[k], "file", PUBLISH, "terminal"))
    if not own.get("parent"):
        rows.append(("parent", "", "default", PUBLISH, "terminal"))
    return rows


def wiki_settings():
    for row in setting_rows():
        print("\t".join(" ".join(str(f).split()) for f in row))
    return 0


def secret_key(key):
    k = key.lower()
    if k == "token_cmd":
        return False
    return any(w in k for w in ("token", "password", "passwd", "secret", "api_key", "apikey"))


def wiki_set(args):
    """--wiki-set <key> <value>: check the key and the shape of the value, then write it where
    the interactive setup would. A - clears it. Exit 2, and one line why, for what it refuses.
    Publishing is never set from here: it sends a wiki to a space."""
    if len(args) != 2:
        die_usage("usage: --wiki-set <key> <value>")
    for what, text in (("key", args[0]), ("value", args[1])):
        if unfit(text):
            die_usage(f"the {what} {unfit(text)}, so nothing was written")
    key, value = args[0].strip(), args[1].strip()
    if secret_key(key):
        die_usage(f"{key} is a secret, and a session never sets one. The user puts the token in their keychain themselves, and then {CMD} extensions set confluence token_cmd keychain")
    if key in ("space", "parent", "auto") or key.startswith(("space.", "parent.")):
        die_usage(f"{key} is for publishing, which writes to Confluence. The user sets it in a terminal: {CMD} extensions setup confluence")
    fixed = ("site", "email", "token_cmd", "url", "done_states")
    if key not in fixed and not (key.startswith("watch.") and len(key) > 6):
        die_usage(f"no setting a session can change is called {key}. Settings: site, email, token_cmd, url, watch.<wiki>, done_states")
    if not value:
        die_usage(f"give {key} a value, or - to clear it")
    if "#" in value:
        die_usage(f"{key} can't hold a #, which starts a comment in the settings file")
    clear = value == "-"
    path = CONFIG
    if key == "site":
        path = SHARED
        if not clear and (not value.startswith(("http://", "https://")) or len(value.split()) != 1 or value.count("://") != 1):
            die_usage("site isn't an address: it starts with https:// or http://, with no spaces")
        out = "" if clear else value.rstrip("/")
    elif key == "url":
        if not clear and (not value.startswith(("http://", "https://")) or len(value.split()) != 1 or value.count("://") != 1):
            die_usage("url isn't an address: it starts with https:// or http://, with no spaces")
        out = "" if clear else value.rstrip("/")
    elif key == "email":
        path = SHARED
        if not clear and (len(value.split()) != 1 or "@" not in value):
            die_usage(f"{key} isn't an email address: it needs an @ and no spaces")
        out = "" if clear else value
    elif key == "token_cmd":
        path = SHARED
        if clear:
            out = ""
        elif value != "keychain":
            die_usage(f"token_cmd takes only the preset keychain from a session. The user sets a command of their own in a terminal: {CMD} extensions setup confluence")
        elif not on_mac():
            die_usage(f"the keychain preset is macOS's. On this machine the user sets token_cmd in a terminal: {CMD} extensions setup confluence")
        else:
            out = KEYCHAIN_CMD
    elif key == "done_states":
        out = "" if clear else value
    else:
        wiki = key[len("watch."):]
        if not is_wiki(wiki):
            die_usage(f"{wiki} isn't one of your wikis, so it can't hear about pages. {CMD} list shows them")
        out = ""
        if not clear:
            kept = []
            for t in [x.strip() for x in value.split(",") if x.strip()]:
                kind, ref = target(t)
                if kind is None:
                    die_usage(f"each entry of {key} is a page's address, an id, or space:KEY")
                kept.append(f"space:{ref}" if kind == "space" else ref)
            out = ", ".join(kept)
    set_conf(path, key, out)
    line = f"{key} {'cleared' if not out else 'set'} in {path}"
    wins = {"site": ("ATLASSIAN_SITE",), "email": ("CONFLUENCE_EMAIL", "ATLASSIAN_EMAIL"), "url": ("CONFLUENCE_URL",)}
    for name in wins.get(key, ()):
        if os.environ.get(name):
            line += f", but {name} is set, and it wins"
            break
    print(line)
    return 0


def main(argv):
    if argv and argv[0] == "--wiki-settings":
        return wiki_settings()
    if argv and argv[0] == "--wiki-set":
        return wiki_set(argv[1:])
    if argv and argv[0] == "--wiki-event":
        return on_event(argv[1:])
    if argv and argv[0] == "--wiki-ready":
        msg = not_ready(settings())
        if msg:
            print(msg)
        return 1 if msg else 0
    if argv and argv[0] == "--wiki-setup":
        return setup()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0 if argv else 1
    cmds = {"check": cmd_check, "publish": cmd_publish, "render": cmd_render, "config": cmd_config}
    if argv[0] not in cmds:
        die_usage(f"confluence takes check, publish, render or config. {CMD} confluence --help")
    return cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
