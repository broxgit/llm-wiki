# True while llm-wiki runs this for an event, in the background, with nobody watching.
EVENT = False


def die(msg, code=1):
    sys.stdout.flush()
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def die_usage(msg):
    """Called wrongly: an unknown command or option, a missing argument. Exits 2."""
    die(msg, 2)


def unreachable(msg):
    """No network is not a failure during an event: 75 asks llm-wiki to try again later."""
    if EVENT:
        print(f"not now: {msg}")
        sys.exit(75)
    die(msg)


# ---- settings ----------------------------------------------------------------

def conf_lines(path):
    """The lines of a settings file, by the one rule everything that reads or writes it shares:
    a line ends at a newline, and a trailing carriage return is dropped. Nothing else splits one.
    Bytes that aren't UTF-8 are kept as they are."""
    with open(path, encoding="utf-8", errors="surrogateescape", newline="") as f:
        text = f.read()
    lines = [l[:-1] if l.endswith("\r") else l for l in text.split("\n")]
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def read_conf(path):
    conf = {}
    try:
        for line in conf_lines(path):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return conf


def pick(*choices):
    """The first value that is set, and where it came from."""
    for value, where in choices:
        if value:
            return value, where
    return "", ""


def came_from(conf, key):
    """For config: where a value came from, when it wasn't this extension's own file."""
    where = conf["_from"].get(key, "")
    return f"  (from {where})" if where and where != "this file" else ""


def wiki_url(site):
    """Cloud serves Confluence under /wiki on the site Jira is on. A server's address differs. Whether the site is on
    Cloud is decided by its parsed host, not by how the string ends."""
    site = (site or "").rstrip("/")
    return site + "/wiki" if is_cloud(site) else ""


def settings():
    """This extension's settings. The sign-in comes, for each value, from the first of:
    Confluence's environment, Atlassian's, Confluence's file, the file every Atlassian
    extension shares, and last the Jira extension's file, which it read before there was one."""
    conf = read_conf(CONFIG)
    shared = read_conf(SHARED)
    jira = read_conf(os.path.join(CONFIG_DIR, "jira"))
    env = os.environ.get
    src = {}
    conf["url"], src["url"] = pick((env("CONFLUENCE_URL"), "CONFLUENCE_URL"), (wiki_url(env("ATLASSIAN_SITE")), "ATLASSIAN_SITE"),
                                   (conf.get("url"), "this file"), (wiki_url(shared.get("site")), "the shared file"),
                                   (wiki_url(jira.get("url")), "Jira's settings"))
    conf["email"], src["email"] = pick((env("CONFLUENCE_EMAIL"), "CONFLUENCE_EMAIL"), (env("ATLASSIAN_EMAIL"), "ATLASSIAN_EMAIL"),
                                       (conf.get("email"), "this file"), (shared.get("email"), "the shared file"),
                                       (jira.get("email"), "Jira's settings"))
    conf["token_cmd"], src["token_cmd"] = pick((conf.get("token_cmd"), "token_cmd"),
                                               (shared.get("token_cmd"), "token_cmd in the shared file"),
                                               (jira.get("token_cmd"), "token_cmd in Jira's settings"))
    conf["_from"] = src
    for k, name in (("space", "CONFLUENCE_SPACE"), ("auto", "CONFLUENCE_AUTO")):
        if env(name):
            conf[k] = env(name)
    conf["url"] = conf["url"].rstrip("/")
    return conf


def token(conf):
    """The API token and where it came from. Never printed."""
    for name in ("CONFLUENCE_API_TOKEN", "ATLASSIAN_API_TOKEN", "JIRA_API_TOKEN"):
        if os.environ.get(name):
            return os.environ[name], name
    if conf.get("token_cmd"):
        try:
            out = subprocess.run(conf["token_cmd"], shell=True, capture_output=True, text=True, timeout=30)
        except subprocess.TimeoutExpired:
            die("token_cmd took more than 30 seconds")
        if out.returncode != 0 or not out.stdout.strip():
            die(f"token_cmd printed no token (exit {out.returncode}). Run it yourself to see why: {conf['token_cmd']}")
        return out.stdout.strip(), conf["_from"]["token_cmd"]
    return "", ""


TOKEN_ENV = ("CONFLUENCE_API_TOKEN", "ATLASSIAN_API_TOKEN", "JIRA_API_TOKEN")


