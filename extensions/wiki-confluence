def style_on(fd=1):
    o = os.environ.get("LLM_WIKI_STYLE", "")
    if o in ("on", "off"):
        return o == "on"
    return os.isatty(fd) and not os.environ.get("NO_COLOR") and os.environ.get("TERM", "dumb") != "dumb"


def sgr(code, text, fd=1):
    return "\033[%sm%s\033[0m" % (code, text) if style_on(fd) else text


def typed(text):
    return sgr("36", text)


def bold(text):
    return sgr("1", text)


def done(text):
    """A line saying something was done: the tick in front, where style is on."""
    if not style_on():
        return text
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_CTYPE") or os.environ.get("LANG") or ""
    return sgr("32", "\u2713" if "utf" in loc.lower() else "+") + " " + text


def warn(text):
    """A line that leaves something for the person: the warning mark in front."""
    return (sgr("1;33", "!") + " " if style_on() else "") + text


def read_line():
    """One line from standard input, a byte at a time, so nothing meant for whoever
    reads next is taken. None when the input has ended."""
    buf = b""
    while True:
        c = os.read(0, 1)
        if not c:
            return buf.decode(errors="replace") if buf else None
        if c == b"\n":
            return buf.decode(errors="replace")
        buf += c


def ask(prompt, default=""):
    """Enter keeps the value in brackets, and - clears it."""
    sys.stdout.write(f"{prompt} [{default or 'none'}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    line = line.strip()
    return default if line == "" else ("" if line == "-" else line)


def ask_yn(prompt, default=False):
    sys.stdout.write(f"{prompt} [{'Y/n' if default else 'y/N'}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    line = line.strip().lower()
    return default if line == "" else line.startswith("y")


# What no setting's value may hold: a character that ends a line in any reader's eyes
# (str.splitlines splits on more than a newline), or any other control character.
SEPARATORS = "\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029"


def unfit(text):
    """Why a key or value can't be written to a settings file, in words that don't repeat it, or nothing."""
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        return "isn't valid UTF-8"
    for c in text:
        cat = unicodedata.category(c)
        if c in SEPARATORS or cat[0] == "C" or cat in ("Zl", "Zp"):
            return "can't hold a control character or a line separator"
    return ""


def set_conf(path, key, value):
    """Set one `name = value` line in a settings file, or take it out when value is empty.
    Every other line stays as it is. The file is written beside itself and moved into place,
    so a write that fails leaves the old one."""
    why = unfit(key) or unfit(value) or ("is more than one line" if len(value.splitlines()) > 1 else "")
    if why:
        die_usage(f"the value of {key} {why}, so nothing was written")
    try:
        lines = conf_lines(path)
    except FileNotFoundError:
        lines = []
    kept = [l for l in lines if l.split("#", 1)[0].split("=", 1)[0].strip() != key or "=" not in l.split("#", 1)[0]]
    if value:
        kept.append(f"{key} = {value}")
    # A settings file that is a link, as with dotfiles kept elsewhere, stays one: the file it names is replaced.
    path = os.path.realpath(path)
    folder = os.path.dirname(path)
    tmp = None
    try:
        os.makedirs(folder, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=folder, prefix=".settings-")
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape", newline="") as f:
            f.write("\n".join(kept) + ("\n" if kept else ""))
        try:
            mode = stat.S_IMODE(os.stat(path).st_mode)
        except FileNotFoundError:
            mask = os.umask(0)
            os.umask(mask)
            mode = 0o666 & ~mask
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError as e:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        die(f"can't write {path}: {e.strerror or e}. The old file is as it was")


def has_token(conf):
    """Whether a token is set to come from somewhere. The command isn't run to find out."""
    return bool(conf.get("token_cmd")) or any(os.environ.get(n) for n in TOKEN_ENV)


def atlassian_setup():
    """Ask for the sign-in every Atlassian extension shares, and keep it in the shared file."""
    shared = read_conf(SHARED)
    conf = settings()
    if conf["url"] and has_token(conf):
        print(f"The Atlassian sign-in is already set: {conf['url']}" + (f", as {conf['email']}" if conf.get("email") else "") + ".")
        if not ask_yn("Change it?", False):
            return
    print(f"Jira and Confluence share one Atlassian sign-in, kept in {SHARED}.")
    print("Enter keeps the value in brackets.")
    site = ask("Site, such as https://your-company.atlassian.net", shared.get("site", ""))
    if site and not site.startswith(("https://", "http://")):
        print("  " + warn(f"{site} isn't an address, so it wasn't saved. An address starts with https://"))
    else:
        set_conf(SHARED, "site", site.rstrip("/"))
    email = ask("Email of your Atlassian account. Leave it empty on Data Center", shared.get("email", ""))
    set_conf(SHARED, "email", email)
    if has_token(settings()):
        return
    print()
    print("The API token is kept out of this file. Create one at")
    print("  https://id.atlassian.com/manage-profile/security/api-tokens")
    print("or, on Data Center, a personal access token in your profile. Copy it.")
    if sys.platform == "darwin":
        print("Then put it in your keychain from the clipboard. In another terminal, run:")
        print("  " + typed('security add-generic-password -a "$USER" -s atlassian -U -w "$(pbpaste)"'))
        sys.stdout.write("Press Enter when that is done, or type skip to do it later: ")
        sys.stdout.flush()
        answer = read_line()
        if answer is None:
            print()
        if answer is not None and answer.strip().lower() != "skip":
            set_conf(SHARED, "token_cmd", "security find-generic-password -s atlassian -w")
    else:
        cmd = ask("A command that prints the token, such as: pass show atlassian", "")
        set_conf(SHARED, "token_cmd", cmd)


def sign_in_missing(conf):
    """What the sign-in lacks, in a few words, or nothing."""
    if not conf["url"]:
        site = os.environ.get("ATLASSIAN_SITE") or read_conf(SHARED).get("site") or ""
        if site:
            return f"no Confluence address yet: {site} isn't on Atlassian Cloud, so Confluence's own address is needed"
        return "no Confluence address yet"
    if not has_token(conf):
        return "no API token yet"
    return ""


def need_sign_in(conf):
    msg = sign_in_missing(conf)
    if msg:
        die(f"Confluence isn't set up: {msg}. Run: {CMD} extensions setup confluence. {GUIDE}")


def watch_lists(conf):
    """{wiki: [what it watches, as written]} from the watch.<wiki> settings."""
    out = {}
    for k in sorted(conf):
        if k.startswith("watch.") and conf[k].strip():
            out[k[len("watch."):]] = [t.strip() for t in conf[k].split(",") if t.strip()]
    return out


def done_states(conf):
    return [x.strip().lower() for x in (conf.get("done_states") or "Verified").split(",") if x.strip()]


def not_ready(conf):
    """What it lacks before it can do anything, in a few words, or nothing."""
    msg = sign_in_missing(conf)
    if msg:
        return msg
    if not watch_lists(conf) and not conf.get("space"):
        return "nothing chosen yet: no pages to watch, and no space to publish into"
    return ""


def step(n, of, title):
    print()
    print(bold(f"== Step {n} of {of}: {title}"))


def setup():
    """Run by `wiki setup` and `wiki extensions setup confluence`, at a terminal. Every
    setting is asked for here, with what it does, and nothing happens that isn't chosen."""
    print(bold("Confluence, for your wikis"))
    print("It can do two separate things. Neither happens until you choose it here.")
    print()
    print("  Watch     Reads Confluence. When a page you name changes, or its status changes,")
    print("            a note goes into one of your wikis, so your agent knows. It writes nothing")
    print("            to Confluence.")
    print("  Publish   Writes to Confluence. Copies one of your wikis into a space, for people who")
    print("            read there. Off unless you turn it on in step 3.")
    print()
    print("Enter keeps the value in brackets, and a dash, -, clears it. You can run this again at any")
    print(f"time to change an answer: {typed(CMD + ' extensions setup confluence')}")

    step(1, 3, "sign in")
    atlassian_setup()
    own = read_conf(CONFIG)
    if not settings()["url"]:
        print("On Atlassian Cloud, Confluence is at the site's address with /wiki after it. This site isn't,")
        print("so Confluence's own address is needed.")
        url = ask("Confluence's address", own.get("url", ""))
        if url and not url.startswith(("https://", "http://")):
            print("  " + warn(f"{url} isn't an address, so it wasn't saved. An address starts with https://"))
        else:
            set_conf(CONFIG, "url", url.rstrip("/"))
    conf = settings()
    c = None
    if sign_in_missing(conf):
        print("  " + warn(f"Confluence can't sign in yet: {sign_in_missing(conf)}. The pages you name below can't be checked until it can."))
    else:
        try:
            c = Confluence(conf)
            me = c.call("GET", "/rest/api/user/current")
            print("  " + done(f"Signed in to Confluence as {me.get('displayName') or me.get('username') or '?'}."))
        except Refused as e:
            c = None
            print("  " + warn(f"{conf['url']} has no Confluence API at /rest/api ({e.code}). On Cloud the address ends in /wiki."))
        except SystemExit:
            c = None
            print("  " + warn("The sign-in didn't work. The line above says why."))

    step(2, 3, "watch pages")
    print("What it does   For each page you name, it remembers the version your wiki last heard about.")
    print("               When the page's text changes, or its status changes (such as In progress to")
    print("               Verified), it saves a note in the wiki: who changed it, when, and what changed.")
    print("               The next compile works that into the wiki's pages.")
    print("When it runs   By itself, in the background, once a day. Nobody has to ask.")
    print(f"               {CMD} extensions every confluence 4h makes that every four hours.")
    print("What it costs  One request a page. A note is saved only when something changed.")
    print("What it sends  Nothing. Watching only reads.")
    wikis = sorted(n for n in os.listdir(os.environ.get("WIKIS_DIR", ".")) if is_wiki(n)) if os.path.isdir(os.environ.get("WIKIS_DIR", "")) else []
    if wikis:
        print()
        print("Your wikis: " + ", ".join(wikis))
    lists = watch_lists(own)
    first = True
    while True:
        default = next(iter(lists), "") if first else ""
        first = False
        print()
        wiki = ask("Which wiki should hear about Confluence pages? Leave empty to skip watching", default)
        if not wiki:
            break
        if not is_wiki(wiki):
            print("  " + warn(f"{wiki} isn't one of your wikis, so nothing was saved for it."))
        else:
            print(f"Name the pages for {wiki}. Paste a page's address from your browser, or its id, and separate")
            print("several with commas. To watch every page in a space from now on, write space: and its key,")
            print("such as space:ENG.")
            raw = ask(f"Pages to watch for {wiki}", ", ".join(lists.get(wiki, [])))
            kept = []
            for t in [x.strip() for x in raw.split(",") if x.strip()]:
                kind, ref = target(t)
                if kind is None:
                    print("  " + warn(f"{t} isn't a page's address, an id, or space:KEY, so it was left out."))
                elif kind == "space":
                    kept.append(f"space:{ref}")
                    print("  " + done(f"space {ref}: every page in it, from now on"))
                elif c is None:
                    kept.append(ref)
                    print(f"  page {ref}: saved, and not checked, since Confluence can't be reached yet")
                else:
                    page = fetch_page(c, ref)
                    if page is None:
                        print("  " + warn(f"{ref} isn't a page you can read, so it was left out."))
                    else:
                        kept.append(ref)
                        st = page_state(c, ref)
                        print("  " + done(f"{page['title']} (version {page['version']}" + (f", {st}" if st else "") + ")"))
            set_conf(CONFIG, f"watch.{wiki}", ", ".join(kept))
            lists[wiki] = kept
        if not ask_yn("Watch pages for another wiki?", False):
            break
    print()
    print("A page's status can also close an open item. When a note says something is waiting on a")
    print("Confluence page, and the item's heading has the page's address in it, the item closes by")
    print("itself once the page's status is one that means finished.")
    names = []
    if c is not None:
        for refs in lists.values():
            for ref in refs:
                if not ref.startswith("space:"):
                    names = available_states(c, ref)
                    break
            if names:
                break
    if names:
        print("Statuses your Confluence offers: " + ", ".join(names))
    states = ask("Statuses that mean a page is finished, separated by commas", own.get("done_states", "") or "Verified")
    set_conf(CONFIG, "done_states", "" if states == "Verified" else states)

    step(3, 3, "publish (optional)")
    print("What it does   Copies a wiki's pages into a Confluence space, as pages under one called")
    print("               \"<wiki> wiki\", so people who don't use your wikis can read them there.")
    print("What it sends  The wiki's pages, to everyone who can read that space. A wiki holds whatever")
    print("               its sessions noted, so choose a space whose readers may see all of it.")
    print("What it never  It never changes a page it didn't make, and never deletes one.")
    print("does")
    has = bool(own.get("space"))
    if ask_yn("Set up publishing?", has):
        space = ask("Key of the space to publish into. It is in the space's address: .../spaces/ENG/...", own.get("space", ""))
        set_conf(CONFIG, "space", space)
        print("A wiki named next is published by itself, seconds after a sync changes its pages. Any other")
        print(f"is published only when you run {CMD} confluence publish <wiki>.")
        auto = ask("Wikis to publish by themselves, separated by commas. Leave empty for none", own.get("auto", ""))
        set_conf(CONFIG, "auto", auto)
    elif has:
        print(f"  Publishing stays as it is: the space {own['space']}. To turn it off, answer yes and clear the space with -.")
    else:
        print("  Publishing stays off. Nothing of yours goes to Confluence.")

    conf = settings()
    print()
    print(bold("What is set"))
    for line in summary(conf):
        print("  " + line)
    print()
    print(bold("What happens now"))
    lists = watch_lists(conf)
    if lists:
        print("  Once a day, in the background, the watched pages are checked, and a change is noted in its wiki.")
        print(f"  To check now, and see what it would note: {typed(CMD + ' confluence check')}")
    if auto_wikis(conf):
        print("  A sync that changes a page of " + ", ".join(auto_wikis(conf)) + " publishes that wiki.")
    if not lists and not conf.get("space"):
        print("  Nothing: no pages are watched and publishing is off.")
    print(f"  To see what the last run did: {typed(CMD + ' extensions log confluence')}")
    print(f"  Every setting is in {CONFIG}, and {CMD} confluence --help lists them.")
    return 0


def summary(conf):
    """What is set, a line for each lever, in words."""
    out = []
    missing = sign_in_missing(conf)
    out.append("Sign-in      " + (f"not set up: {missing}" if missing else conf["url"] + (f", as {conf['email']}" if conf.get("email") else "")))
    lists = watch_lists(conf)
    if lists:
        for wiki, refs in lists.items():
            pages = sum(1 for r in refs if not r.startswith("space:"))
            spaces = [r[len("space:"):] for r in refs if r.startswith("space:")]
            parts = ([f"{pages} page(s)"] if pages else []) + ([f"the space {x}" for x in spaces])
            out.append(f"Watching     {wiki} hears about " + " and ".join(parts))
    else:
        out.append("Watching     off: no pages named")
    out.append("Finished is  " + ", ".join(x.capitalize() for x in done_states(conf)) + " (a page with that status closes an open item that links it)")
    if conf.get("space"):
        out.append(f"Publishing   into the space {conf['space']}; by themselves: " + (", ".join(auto_wikis(conf)) or "none, only when you run publish"))
    else:
        out.append("Publishing   off")
    return out


# ---- Confluence ----------------------------------------------------------------

class Refused(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Confluence:
    def __init__(self, conf):
        if not conf["url"]:
            die(f"no Confluence address. Set site in {SHARED}, or url in {CONFIG}, or CONFLUENCE_URL. {CMD} confluence --help has the settings.")
        if not conf["url"].startswith(("https://", "http://")):
            die(f"url has to start with https:// (it is {conf['url']})")
        tok, _ = token(conf)
        if not tok:
            die(f"no API token. Set token_cmd in {SHARED}, or CONFLUENCE_API_TOKEN. {CMD} confluence --help has the settings.")
        self.url = conf["url"]
        if conf.get("email"):
            auth = "Basic " + base64.b64encode(f"{conf['email']}:{tok}".encode()).decode()
        else:
            auth = "Bearer " + tok
        self.headers = {"Authorization": auth, "Accept": "application/json", "Content-Type": "application/json"}

    def call(self, method, path, body=None):
        """The JSON Confluence answers with. Raises Refused for a 400, 404 or 409."""
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, headers=self.headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                raw = r.read()
                return json.loads(raw) if raw.strip() else {}
        except urllib.error.HTTPError as e:
            text = e.read().decode("utf-8", "replace")
            try:
                msg = json.loads(text).get("message") or text
            except ValueError:
                msg = text
            if e.code == 401:
                die(f"Confluence refused the sign-in (401) at {self.url}. Check the email and the token: {CMD} confluence config shows what is set.")
            if e.code in (400, 403, 404, 409):
                raise Refused(e.code, " ".join(msg.split())[:300])
            die(f"Confluence answered {e.code} for {method} {path.split('?')[0]}: {' '.join(msg.split())[:200]}")
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            unreachable(f"can't reach {self.url}: {getattr(e, 'reason', e)}")
        except ValueError:
            die(f"{self.url} didn't answer with JSON. Is url the address of Confluence itself? On Cloud it ends in /wiki.")

    def find(self, space, title):
        q = urllib.parse.urlencode({"spaceKey": space, "title": title, "type": "page", "expand": "version,metadata.labels"})
        res = self.call("GET", "/rest/api/content?" + q).get("results") or []
        return res[0] if res else None

    def children(self, page_id):
        out, start = [], 0
        while True:
            d = self.call("GET", f"/rest/api/content/{page_id}/child/page?expand=version,metadata.labels&limit=100&start={start}")
            res = d.get("results") or []
            out += res
            if len(res) < 100:
                return out
            start += len(res)

    def create(self, space, title, body, parent, digest):
        page = {"type": "page", "title": title, "space": {"key": space},
                "body": {"storage": {"value": body, "representation": "storage"}},
                "version": {"number": 1, "message": f"{LABEL} {digest}"}}
        if parent:
            page["ancestors"] = [{"id": str(parent)}]
        made = self.call("POST", "/rest/api/content", page)
        self.call("POST", f"/rest/api/content/{made['id']}/label", [{"prefix": "global", "name": LABEL}])
        return made

    def update(self, page, title, body, digest):
        n = int((page.get("version") or {}).get("number") or 1) + 1
        return self.call("PUT", f"/rest/api/content/{page['id']}", {
            "id": page["id"], "type": "page", "title": title,
            "body": {"storage": {"value": body, "representation": "storage"}},
            "version": {"number": n, "message": f"{LABEL} {digest}"}})


def ours(page):
    labels = (((page.get("metadata") or {}).get("labels") or {}).get("results")) or []
    return any(l.get("name") == LABEL for l in labels)


def digest_of(page):
    m = re.match(rf"{LABEL} ([0-9a-f]+)$", ((page.get("version") or {}).get("message") or "").strip())
    return m.group(1) if m else ""


# ---- markdown to Confluence's storage format -----------------------------------
# The subset the handbook's pages use: headings, paragraphs, lists, fenced code,
# tables, block quotes, rules, and inline code, emphasis, links and images.

INLINE = re.compile(
    r"(`+)(.+?)\1"                                                       # 1,2 code
    r"|!\[([^\]]*)\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)"          # 3,4 image
    r"|\[((?:[^\[\]]|\[[^\[\]]*\])*)\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)"  # 5,6 link
    r"|\*\*(?=\S)(.+?)(?<=\S)\*\*"                                       # 7 strong
    r"|(?<![A-Za-z0-9*])\*(?=[^\s*])(.+?)(?<=[^\s*])\*(?![A-Za-z0-9*])"  # 8 em
    r"|(?<![A-Za-z0-9_])_(?=[^\s_])(.+?)(?<=[^\s_])_(?![A-Za-z0-9_])"    # 9 em
    r"|~~(?=\S)(.+?)(?<=\S)~~"                                           # 10 strike
    r"|(https?://[^\s<>()\[\]]*[^\s<>()\[\].,;:!?'\"])"                  # 11 bare URL
)


def cdata(text):
    return "<![CDATA[" + text.replace("]]>", "]]]]><![CDATA[>") + "]]>"


class Renderer:
    def __init__(self, source_path="", titles=None):
        """source_path: the page's path inside its wiki. titles: path -> Confluence title."""
        self.dir = posixpath.dirname(source_path)
        self.titles = titles or {}

    def link(self, inner, url):
        if re.match(r"(?i)(https?|mailto):", url):
            return f"<a href={quoteattr(url)}>{inner}</a>"
        target = url.split("#", 1)[0]
        if target:
            path = posixpath.normpath(posixpath.join(self.dir, urllib.parse.unquote(target)))
            if path in self.titles:
                return (f"<ac:link><ri:page ri:content-title={quoteattr(self.titles[path])}/>"
                        f"<ac:link-body>{inner}</ac:link-body></ac:link>")
        # A heading on this page, a raw note, a file, another wiki: nothing to link to there.
        return inner

    def inline(self, text):
        out, pos = [], 0
        for m in INLINE.finditer(text):
            out.append(escape(text[pos:m.start()]))
            pos = m.end()
            if m.group(1):
                out.append(f"<code>{escape(m.group(2).strip())}</code>")
            elif m.group(4):
                src = m.group(4)
                if re.match(r"(?i)https?:", src):
                    out.append(f"<ac:image ac:alt={quoteattr(m.group(3))}><ri:url ri:value={quoteattr(src)}/></ac:image>")
                else:
                    out.append(f"<em>{escape(m.group(3) or posixpath.basename(src))} (image not published)</em>")
            elif m.group(6):
                out.append(self.link(self.inline(m.group(5)), m.group(6)))
            elif m.group(7):
                out.append(f"<strong>{self.inline(m.group(7))}</strong>")
            elif m.group(8) or m.group(9):
                out.append(f"<em>{self.inline(m.group(8) or m.group(9))}</em>")
            elif m.group(10):
                out.append(f"<del>{self.inline(m.group(10))}</del>")
            else:
                out.append(f"<a href={quoteattr(m.group(11))}>{escape(m.group(11))}</a>")
        out.append(escape(text[pos:]))
        return "".join(out)

    def blocks(self, lines):
        out, i, n = [], 0, len(lines)
        para = []

        def flush():
            if para:
                out.append("<p>" + self.inline(" ".join(s.strip() for s in para)) + "</p>")
                del para[:]

        while i < n:
            line = lines[i]
            fence = re.match(r"\s{0,3}(```+|~~~+)\s*([A-Za-z0-9_+#.-]*)", line)
            if fence:
                flush()
                mark, lang, code = fence.group(1), fence.group(2), []
                i += 1
                while i < n and not re.match(rf"\s{{0,3}}{re.escape(mark[0])}{{{len(mark)},}}\s*$", lines[i]):
                    code.append(lines[i])
                    i += 1
                i += 1
                param = f'<ac:parameter ac:name="language">{escape(lang)}</ac:parameter>' if lang else ""
                out.append(f'<ac:structured-macro ac:name="code">{param}'
                           f"<ac:plain-text-body>{cdata(chr(10).join(code))}</ac:plain-text-body></ac:structured-macro>")
                continue
            if not line.strip():
                flush()
                i += 1
                continue
            h = re.match(r"\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$", line)
            if h:
                flush()
                out.append(f"<h{len(h.group(1))}>{self.inline(h.group(2))}</h{len(h.group(1))}>")
                i += 1
                continue
            if re.match(r"\s{0,3}([-*_])(\s*\1){2,}\s*$", line):
                flush()
                out.append("<hr/>")
                i += 1
                continue
            if re.match(r"\s{0,3}>", line):
                flush()
                quote = []
                while i < n and re.match(r"\s{0,3}>", lines[i]):
                    quote.append(re.sub(r"^\s{0,3}> ?", "", lines[i]))
                    i += 1
                out.append("<blockquote>" + self.blocks(quote) + "</blockquote>")
                continue
            if "|" in line and i + 1 < n and re.match(r"\s*\|?\s*:?-{1,}:?\s*(\|\s*:?-{1,}:?\s*)*\|?\s*$", lines[i + 1]) and "|" in lines[i + 1]:
                flush()
                rows = [line]
                i += 2
                while i < n and "|" in lines[i] and lines[i].strip():
                    rows.append(lines[i])
                    i += 1
                out.append(self.table(rows))
                continue
            if re.match(r"\s*([-*+]|\d+[.)])\s+", line):
                flush()
                item = []
                first = re.match(r"(\s*)([-*+]|\d+[.)])\s+", line)
                while i < n:
                    # A bulleted item after a numbered one, or the reverse, starts a new list.
                    m = re.match(r"(\s*)([-*+]|\d+[.)])\s+", lines[i])
                    if (m and item and len(m.group(1).expandtabs(4)) <= len(first.group(1).expandtabs(4))
                            and m.group(2)[0].isdigit() != first.group(2)[0].isdigit()):
                        break
                    if not lines[i].strip():
                        # A blank line ends the list unless an indented line or another item follows.
                        j = i
                        while j < n and not lines[j].strip():
                            j += 1
                        if j < n and (re.match(r"\s+\S", lines[j]) or re.match(r"([-*+]|\d+[.)])\s+", lines[j])):
                            item.append("")
                            i += 1
                            continue
                        break
                    if not re.match(r"\s*([-*+]|\d+[.)])\s+", lines[i]) and not re.match(r"\s+\S", lines[i]) and item and not item[-1].strip():
                        break
                    item.append(lines[i])
                    i += 1
                out.append(self.list(item))
                continue
            para.append(line)
            i += 1
        flush()
        return "".join(out)

    def table(self, rows):
        def cells(row):
            row = row.strip()
            row = row[1:] if row.startswith("|") else row
            row = row[:-1] if row.endswith("|") and not row.endswith("\\|") else row
            return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", row)]
        out = ["<table><tbody><tr>"]
        out += [f"<th>{self.inline(c)}</th>" for c in cells(rows[0])]
        out.append("</tr>")
        for row in rows[1:]:
            out.append("<tr>" + "".join(f"<td>{self.inline(c)}</td>" for c in cells(row)) + "</tr>")
        out.append("</tbody></table>")
        return "".join(out)

    def list(self, lines):
        """One list: the items at the indent of its first line, each with what is under it."""
        first = re.match(r"(\s*)([-*+]|\d+[.)])\s+", lines[0])
        indent = len(first.group(1).expandtabs(4))
        tag = "ol" if first.group(2)[0].isdigit() else "ul"
        items, cur = [], None
        for line in lines:
            m = re.match(r"(\s*)([-*+]|\d+[.)])\s+(.*)", line)
            if m and len(m.group(1).expandtabs(4)) <= indent:
                cur = [m.group(3)]
                items.append(cur)
            elif cur is not None:
                cur.append(line)
        out = [f"<{tag}>"]
        for item in items:
            head, rest = [item[0]], item[1:]
            while rest and rest[0].strip() and not re.match(r"\s*([-*+]|\d+[.)])\s+", rest[0]) and not re.match(r"\s*(```|~~~)", rest[0]):
                head.append(rest.pop(0).strip())
            # What is left belongs to the item: take off the indent it shares.
            pad = min((len(l) - len(l.lstrip()) for l in rest if l.strip()), default=0)
            body = self.blocks([l[pad:] for l in rest]) if any(l.strip() for l in rest) else ""
            out.append("<li>" + self.inline(" ".join(head)) + body + "</li>")
        out.append(f"</{tag}>")
        return "".join(out)


def split_front(text):
    """(frontmatter as a dict of its plain `key: value` lines, the body's lines)"""
    lines = text.splitlines()
    front = {}
    if lines and lines[0].strip() == "---":
        for j in range(1, len(lines)):
            if lines[j].strip() == "---":
                for l in lines[1:j]:
                    m = re.match(r"([A-Za-z_][\w-]*):\s*(.*)$", l)
                    if m:
                        front[m.group(1)] = m.group(2).strip().strip("\"'")
                return front, lines[j + 1:]
    return front, lines


def title_of(front, body, fallback):
    if front.get("title"):
        return front["title"]
    for l in body:
        m = re.match(r"#\s+(.*?)\s*#*\s*$", l)
        if m:
            return re.sub(r"[*_`]", "", m.group(1))
        if l.strip():
            break
    return fallback


def render(text, wiki="", source_path="", titles=None):
    front, body = split_front(text)
    # Confluence shows the title itself, so the page's own first heading goes.
    k = 0
    while k < len(body) and not body[k].strip():
        k += 1
    if k < len(body) and re.match(r"#\s+", body[k]):
        body = body[k + 1:]
    banner = ('<ac:structured-macro ac:name="info"><ac:rich-text-body><p>'
              + (f"This page is a copy of <code>{escape(source_path)}</code> in the <strong>{escape(wiki)}</strong> wiki, " if wiki else "This page is a copy, ")
              + "published by llm-wiki. Changes made here are overwritten: ask an agent to change the wiki."
              + "</p></ac:rich-text-body></ac:structured-macro>")
    meta = " · ".join(f"{k.capitalize()} {escape(front[k])}" for k in ("updated", "verified") if front.get(k))
    return banner + (f"<p><em>{meta}</em></p>" if meta else "") + Renderer(source_path, titles).blocks(body)


# ---- watching ------------------------------------------------------------------

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "llm-wiki", "extensions", "confluence")
PAGE_REF = re.compile(r"/pages/(\d+)|[?&]pageId=(\d+)")
NOTED = re.compile(r"^Confluence-page: (\d+) \| version (\d+) \| status (.*)$")
# A note this extension saved. A second in the same second is named <stamp>-confluence-2.md.
OWN_NOTE = re.compile(r"-confluence(-\d+)?\.md$")


def target(text):
    """("page", id), ("space", KEY) or (None, None) for what someone wrote."""
    text = text.strip()
    if text.lower().startswith("space:"):
        key = text[6:].strip()
        return ("space", key) if key else (None, None)
    m = PAGE_REF.search(text)
    if m:
        return "page", m.group(1) or m.group(2)
    return ("page", text) if text.isdigit() else (None, None)


class PageText(html.parser.HTMLParser):
    """A Confluence page as plain text: enough to read, and to see what changed."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []

    def handle_starttag(self, tag, attrs):
        if len(tag) == 2 and tag[0] == "h" and tag[1].isdigit():
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag in ("p", "div", "tr", "table", "ul", "ol", "blockquote", "br"):
            self.out.append("\n")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("td", "th"):
            self.out.append(" | ")
        elif tag == "ac:plain-text-body":
            self.out.append("\n    ")

    def handle_endtag(self, tag):
        if (len(tag) == 2 and tag[0] == "h" and tag[1].isdigit()) or tag in ("p", "table", "ul", "ol", "ac:plain-text-body"):
            self.out.append("\n")

    def handle_data(self, data):
        self.out.append(data)

    def unknown_decl(self, data):
        if data.startswith("CDATA["):
            self.out.append(data[6:].replace("\n", "\n    "))


def page_text(storage, limit=30000):
    parser = PageText()
    try:
        parser.feed(storage or "")
        parser.close()
    except Exception:
        return ""
    lines = [re.sub(r"[ \t]+", " ", l).rstrip() for l in "".join(parser.out).split("\n")]
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
    return text if len(text) <= limit else text[:limit] + "\n(cut here: the page is longer)"


def fetch_page(c, pid):
    """{id, title, version, by, when, link, text}, or None for a page that can't be read."""
    try:
        d = c.call("GET", f"/rest/api/content/{pid}?expand=version,body.storage")
    except Refused:
        return None
    v = d.get("version") or {}
    return {"id": str(d.get("id") or pid), "title": d.get("title") or f"page {pid}", "version": int(v.get("number") or 0),
            "by": (v.get("by") or {}).get("displayName") or "", "when": v.get("when") or "",
            "link": c.url + ((d.get("_links") or {}).get("webui") or f"/pages/viewpage.action?pageId={pid}"),
            "text": page_text(((d.get("body") or {}).get("storage") or {}).get("value") or "")}


def page_state(c, pid):
    """The page's status, such as Verified, or nothing where it has none or the server has no such thing."""
    try:
        d = c.call("GET", f"/rest/api/content/{pid}/state")
    except Refused:
        return ""
    return ((d.get("contentState") or {}).get("name") or "") if isinstance(d, dict) else ""


def available_states(c, pid):
    try:
        d = c.call("GET", f"/rest/api/content/{pid}/state/available")
    except Refused:
        return []
    return [x.get("name") for x in (d.get("spaceContentStates") or []) + (d.get("customContentStates") or []) if x.get("name")]


def space_pages(c, key, since):
    """Ids of the pages in a space changed at or after `since`. The search is asked for a
    day earlier, since it reads dates in the account's own time zone, and narrowed here."""
    asked = (since - datetime.timedelta(days=1)).strftime("%Y-%m-%d %H:%M")
    q = urllib.parse.urlencode({"cql": f'space = "{key}" and type = page and lastmodified >= "{asked}"', "expand": "version", "limit": 100})
    try:
        res = c.call("GET", "/rest/api/content/search?" + q).get("results") or []
    except Refused:
        return None
    out = []
    for r in res:
        when = parse_when(((r.get("version") or {}).get("when")) or "")
        if when is None or when >= since:
            out.append(str(r.get("id")))
    return out


def parse_when(text):
    try:
        t = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)


def note_order(name):
    """Oldest first: by the stamp, then by the number a same-second note was given."""
    m = re.match(r"(.*)-confluence(?:-(\d+))?\.md$", name)
    return (m.group(1), int(m.group(2) or 1)) if m else (name, 0)


def noted(root):
    """{page id: (version, status)} as the wiki's own notes last recorded it. The notes
    are in git, so every machine that syncs the wiki reads the same answer."""
    out = {}
    raw = os.path.join(root, "raw")
    try:
        names = sorted((n for n in os.listdir(raw) if OWN_NOTE.search(n)), key=note_order)
    except OSError:
        return out
    for n in names:
        try:
            with open(os.path.join(raw, n), encoding="utf-8", errors="replace") as f:
                for line in f:
                    m = NOTED.match(line.rstrip("\n"))
                    if m:
                        out[m.group(1)] = (int(m.group(2)), m.group(3).strip())
        except OSError:
            pass
    return out


def waiting_lines(wiki_cmd, root, wiki):
    """The lines of this extension's notes that no compile has taken yet."""
    r = subprocess.run([wiki_cmd, "pending", wiki], capture_output=True, text=True)
    names = [l.split()[0][len("raw/"):] for l in r.stdout.splitlines() if l.startswith("raw/")] if r.returncode == 0 else []
    lines = set()
    for n in names:
        if OWN_NOTE.search(n):
            try:
                with open(os.path.join(root, "raw", n), encoding="utf-8", errors="replace") as f:
                    lines.update(f.read().splitlines())
            except OSError:
                pass
    return lines


def cache_path(pid):
    return os.path.join(STATE, "pages", f"{pid}.txt")


def read_cache(pid):
    try:
        with open(cache_path(pid), encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def since_path(key):
    return os.path.join(STATE, f"space-{re.sub(r'[^A-Za-z0-9~._-]', '_', key)}.since")


def cmd_check(args):
    save = "--save" in args
    rest = [a for a in args if a != "--save"]
    if any(a.startswith("-") for a in rest) or len(rest) > 1:
        die_usage(f"check takes --save and a wiki's name. {CMD} confluence --help")
    conf = settings()
    need_sign_in(conf)
    wikis_dir = os.environ.get("WIKIS_DIR") or die("WIKIS_DIR isn't set. Run this as: wiki confluence")
    wiki_cmd = os.environ.get("LLM_WIKI") or die("LLM_WIKI isn't set. Run this as: wiki confluence")
    only = rest[0] if rest else None
    if only and not is_wiki(only):
        die(f"{only} isn't a wiki here. {CMD} status lists the wikis.")
    lists = {w: refs for w, refs in watch_lists(conf).items() if not only or w == only}
    c = Confluence(conf)
    now = datetime.datetime.now(datetime.timezone.utc)
    finished = done_states(conf)
    found = {}     # wiki -> [change]
    closes = {}    # wiki -> [heading]
    waiting = {}   # wiki -> the lines of its notes no compile has taken yet
    bad = 0
    seen_spaces = []

    for wiki, refs in lists.items():
        if not is_wiki(wiki):
            print(warn(f"watch.{wiki} names a wiki that isn't here. Take it out of {CONFIG}."))
            bad = 1
            continue
        print(f"== {wiki}")
        root = os.path.join(wikis_dir, wiki)
        known = noted(root)
        ids = []
        for ref in refs:
            kind, val = target(ref)
            if kind == "page":
                ids.append(val)
            elif kind == "space":
                try:
                    with open(since_path(val), encoding="utf-8") as f:
                        since = parse_when(f.read().strip())
                except OSError:
                    since = None
                if since is None:
                    print(f"  space {val}: watched from now on. Pages changed after this will be noted.")
                    seen_spaces.append(val)
                    continue
                got = space_pages(c, val, since)
                if got is None:
                    print("  " + warn(f"the space {val} can't be read. Check it in watch.{wiki} in {CONFIG}."))
                    bad = 1
                    continue
                seen_spaces.append(val)
                print(f"  space {val}: {len(got)} page(s) changed since {since:%Y-%m-%d %H:%M} UTC")
                ids += [i for i in got if i not in ids]
            else:
                print("  " + warn(f"{ref} isn't a page's address, an id, or space:KEY. Fix watch.{wiki} in {CONFIG}."))
                bad = 1
        for pid in ids:
            page = fetch_page(c, pid)
            if page is None:
                print("  " + warn(f"{pid} isn't a page you can read. Take it out of watch.{wiki} in {CONFIG}."))
                bad = 1
                continue
            page["status"] = page_state(c, pid)
            was = known.get(pid)
            who = f"by {page['by']} " if page["by"] else ""
            if was is None:
                page["kind"] = "first read"
            elif page["version"] > was[0]:
                page["kind"] = f"changed {who}on {page['when'][:10]}"
            elif page["status"] != was[1]:
                page["kind"] = "status changed"
            else:
                page["kind"] = ""
            page["was"] = was
            stat = f"version {page['version']}" + (f", {page['status']}" if page["status"] else "")
            print(f"  {page['title'][:44]:<44} {stat:<28} {page['kind'] or 'unchanged'}")
            if page["kind"]:
                found.setdefault(wiki, []).append(page)

    # An open item whose heading links a page closes when the page's status means finished.
    r = subprocess.run([wiki_cmd, "open", "--data"] + ([only] if only else []), capture_output=True, text=True)
    for line in r.stdout.splitlines() if r.returncode == 0 else []:
        f = line.split("\t")
        if len(f) < 8 or f[1] not in ("open", "overdue"):
            continue
        m = PAGE_REF.search(f[7])
        if not m:
            continue
        st = page_state(c, m.group(1) or m.group(2))
        if st and st.lower() in finished:
            if f[0] not in found and f[0] not in closes and f[0] not in lists:
                print(f"== {f[0]}")
            print(f"  open item: {f[7][:70]}")
            if f[0] not in waiting:
                waiting[f[0]] = waiting_lines(wiki_cmd, os.path.join(wikis_dir, f[0]), f[0])
            if f"Done: {f[7]}" in waiting[f[0]]:
                # A waiting note already asks for it: leave it out.
                print(f"      its page is {st}: already noted as done, waiting for a compile")
            else:
                print(f"      its page is {st}, which means finished: the item closes")
                closes.setdefault(f[0], []).append((f[7], st))

    n = sum(len(v) for v in found.values()) + sum(len(v) for v in closes.values())
    print()
    if not lists and not closes:
        print(f"No wiki watches a page yet. Run: {CMD} extensions setup confluence. {GUIDE}")
    if n == 0:
        if lists:
            print("Nothing changed.")
    elif not save:
        print(f"{n} change(s) to note. To note them in the wiki: {CMD} confluence check --save")
    else:
        for wiki in sorted(set(found) | set(closes)):
            pages = found.get(wiki, [])
            note = [f"# Confluence: what changed, as of {now:%Y-%m-%d}", "",
                    f"Source: {c.url}, read by `wiki confluence` on {now:%Y-%m-%d %H:%M} UTC.", ""]
            for page in pages:
                old = read_cache(page["id"])
                note += [f"## {page['title']}", "", f"- page: {page['link']}",
                         f"- change: {page['kind']}" + (f", version {page['version']}" if "version" not in page["kind"] else ""),
                         "- status: " + (page["status"] or "none")
                         + (f" (was {page['was'][1] or 'none'})" if page["was"] and page["was"][1] != page["status"] else ""), ""]
                if page["kind"] != "status changed":
                    diff = None
                    if old is not None and old != page["text"]:
                        diff = "\n".join(difflib.unified_diff(old.split("\n"), page["text"].split("\n"), "before", "now", lineterm="", n=2))
                    if diff and len(diff) < len(page["text"]):
                        note += ["What changed in the page's text:", "", "````diff", diff, "````", ""]
                    else:
                        note += ["The page's text:", "", "````text", page["text"], "````", ""]
            for page in pages:
                note.append(f"Confluence-page: {page['id']} | version {page['version']} | status {page['status']}")
            for h, st in closes.get(wiki, []):
                note += ["", f"The page this item waits on is {st}.", f"Done: {h}"]
            r = subprocess.run([wiki_cmd, "capture", wiki, "confluence"], input="\n".join(note) + "\n", text=True, capture_output=True)
            if r.returncode != 0:
                die(f"couldn't save the note in {wiki}: {r.stderr.strip()}")
            r = subprocess.run([wiki_cmd, "sync", wiki, "-m", f"Confluence: {len(pages) + len(closes.get(wiki, []))} change(s)"], capture_output=True, text=True)
            if r.returncode != 0:
                die(f"saved the note in {wiki}, but the sync failed. Run: {CMD} sync {wiki}")
            for page in pages:
                try:
                    os.makedirs(os.path.dirname(cache_path(page["id"])), exist_ok=True)
                    with open(cache_path(page["id"]), "w", encoding="utf-8") as f:
                        f.write(page["text"])
                except OSError:
                    pass
            print(f"{wiki}: noted {len(pages) + len(closes.get(wiki, []))} change(s). The next compile works them into the wiki.")
    if save:
        for key in seen_spaces:
            try:
                os.makedirs(STATE, exist_ok=True)
                with open(since_path(key), "w", encoding="utf-8") as f:
                    f.write(now.isoformat())
            except OSError:
                pass
    return bad


