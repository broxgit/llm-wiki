def summary(conf):
    """What is set, a line for each lever, in words."""
    out = []
    missing = sign_in_missing(conf)
    out.append("Sign-in      " + (f"not set up: {missing}" if missing else conf["url"] + (f", as {conf['email']}" if conf.get("email") else "")))
    lists = watch_lists(conf)
    if lists:
        for wiki, refs in lists.items():
            pages = sum(1 for r in refs if not r.startswith("space:"))
            spaces = [r[len("space:"):] for r in refs if r.startswith("space:")]
            parts = ([f"{pages} page(s)"] if pages else []) + ([f"the space {x}" for x in spaces])
            out.append(f"Watching     {wiki} hears about " + " and ".join(parts))
    else:
        out.append("Watching     off: no pages named")
    out.append("Finished is  " + ", ".join(x.capitalize() for x in done_states(conf)) + " (a page with that status closes an open item that links it)")
    if conf.get("space"):
        out.append(f"Publishing   into the space {conf['space']}; by themselves: " + (", ".join(auto_wikis(conf)) or "none, only when you run publish"))
    else:
        out.append("Publishing   off")
    return out


# ---- Confluence ----------------------------------------------------------------

class Refused(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Confluence:
    def __init__(self, conf):
        if not conf["url"]:
            die(f"no Confluence address. Set site in {SHARED}, or url in {CONFIG}, or CONFLUENCE_URL. {CMD} confluence --help has the settings.")
        if address_trouble():
            die(f"{address_trouble()}. Do: fix it, in a terminal: {CMD} extensions setup confluence")
        # Before the token is read: with a saved file that can't be used, nothing is asked for and nothing is sent.
        if TRUST_PROBLEM:
            die(TRUST_PROBLEM)
        tok, _ = token(conf)
        if not tok:
            die(f"no API token. Set token_cmd in {SHARED}, or CONFLUENCE_API_TOKEN. {CMD} confluence --help has the settings.")
        self.url = conf["url"]
        if conf.get("email"):
            auth = "Basic " + base64.b64encode(f"{conf['email']}:{tok}".encode()).decode()
        else:
            auth = "Bearer " + tok
        self.headers = {"Authorization": auth, "Accept": "application/json", "Content-Type": "application/json"}
        self.date = ""

    def call(self, method, path, body=None):
        """The JSON object Confluence answers with. Raises Refused for a 400, 403, 404 or 409, and for an answer
        that couldn't be read: one that isn't a JSON object, or one cut off. Either way the caller has nothing."""
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, headers=self.headers, method=method)
        try:
            with OPENER.open(req, timeout=30) as r:
                # The server's own time, for a space's watch: see space_pages.
                self.date = r.headers.get("Date") or ""
                raw = r.read()
            got = json.loads(raw) if raw.strip() else {}
        except urllib.error.HTTPError as e:
            try:
                text = e.read().decode("utf-8", "replace")
            except (OSError, http.client.HTTPException):
                text = ""
            try:
                parsed = json.loads(text)
            except ValueError:
                parsed = None
            msg = server_text(parsed.get("message") if isinstance(parsed, dict) else None) or server_text(text)
            if e.code == 401:
                die(f"Confluence refused the sign-in (401) at {self.url}. Check the email and the token: {CMD} confluence config shows what is set.")
            if e.code in (400, 403, 404, 409):
                raise Refused(e.code, msg[:300] or f"Confluence answered {e.code}")
            die(f"Confluence answered {e.code} for {method} {path.split('?')[0]}: {msg[:200]}")
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            no_answer(e, self.url)
        except http.client.HTTPException:
            raise Refused(0, UNREADABLE)
        except ValueError:
            die(f"{self.url} didn't answer with JSON. Is url the address of Confluence itself? On Cloud it ends in /wiki.")
        if not isinstance(got, dict):
            raise Refused(0, UNREADABLE)
        return got

    def find(self, space, title):
        q = urllib.parse.urlencode({"spaceKey": space, "title": title, "type": "page", "expand": "version,metadata.labels"})
        res = results(self.call("GET", "/rest/api/content?" + q))
        return res[0] if res else None

    def children(self, pid):
        out, start = [], 0
        while True:
            res = results(self.call("GET", f"/rest/api/content/{pid}/child/page?expand=version,metadata.labels&limit=100&start={start}"))
            out += res
            if len(res) < 100:
                return out
            start += len(res)

    def create(self, space, title, body, parent, digest):
        page = {"type": "page", "title": title, "space": {"key": space},
                "body": {"storage": {"value": body, "representation": "storage"}},
                "version": {"number": 1, "message": f"{LABEL} {digest}"}}
        if parent:
            page["ancestors"] = [{"id": str(parent)}]
        made = self.call("POST", "/rest/api/content", page)
        if not page_id(made.get("id")):
            raise Refused(0, f"{UNREADABLE}, so the page may have been made. {AFTER_HALF}")
        made["id"] = page_id(made.get("id"))
        try:
            self.label(made["id"])
        except Refused as e:
            raise Refused(e.code, f"the page was made, but Confluence refused its label: {e.message}. The next publish finishes it")
        return made

    def label(self, pid):
        self.call("POST", f"/rest/api/content/{pid}/label", [{"prefix": "global", "name": LABEL}])

    def unlabel(self, pid):
        self.call("DELETE", f"/rest/api/content/{pid}/label?" + urllib.parse.urlencode({"name": LABEL}))

    def update(self, page, title, body, digest):
        n = version_of(page)
        if n is None:
            raise Refused(0, UNREADABLE)
        return self.call("PUT", f"/rest/api/content/{page['id']}", {
            "id": page["id"], "type": "page", "title": title,
            "body": {"storage": {"value": body, "representation": "storage"}},
            "version": {"number": n + 1, "message": f"{LABEL} {digest}"}})


UNREADABLE = "Confluence's answer couldn't be read"
AFTER_HALF = ("If an earlier publish made it, add the label llm-wiki to it in Confluence, or delete it there, "
              "then publish again.")


def obj(value):
    """value if it is a JSON object, else an empty one: an answer of another shape reads as having nothing."""
    return value if isinstance(value, dict) else {}


def page_id(value):
    """A page's id as Confluence gives it, or "" for one that isn't digits. It goes into request paths, file
    names and a note's record lines, so nothing else is taken."""
    if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
        value = str(value)
    return value if isinstance(value, str) and re.fullmatch(r"[0-9]{1,30}", value) else ""


def version_of(page):
    """A page's version number, or None where it isn't a whole number."""
    n = obj(page.get("version")).get("number")
    return n if isinstance(n, int) and not isinstance(n, bool) and n >= 0 else None


def results(answer):
    """The pages in a list answer, each an object whose id is digits. Refused for any other shape."""
    res = answer.get("results")
    res = [] if res is None else res
    if not isinstance(res, list) or not all(isinstance(r, dict) and page_id(r.get("id")) for r in res):
        raise Refused(0, UNREADABLE)
    for r in res:
        r["id"] = page_id(r["id"])
    return res


def labels_of(page):
    """The names of a page's labels, or None where the answer doesn't say: that is not the same as none."""
    labels = obj(page.get("metadata")).get("labels")
    found = labels.get("results") if isinstance(labels, dict) else None
    if not isinstance(found, list):
        return None
    return [server_text(obj(l).get("name")) for l in found]


def ours(page):
    return LABEL in (labels_of(page) or [])


def looks_published(page):
    """Whether a page's version message is the one publish writes."""
    msg = obj(page.get("version")).get("message")
    return isinstance(msg, str) and bool(re.fullmatch(rf"{LABEL} [0-9a-f]{{16}}", msg))


def half_made(c, page):
    """Whether a page without the label is one an earlier run made and then couldn't label: Confluence makes a
    page and labels it in two calls. It says it has no labels, it is still version 1, so nobody has edited it,
    the version's message is the one publish writes, and its text has publish's banner. A page a person
    made, or edited since, fails at least one of those, and is never taken."""
    if labels_of(page) != [] or version_of(page) != 1 or not looks_published(page):
        return False
    try:
        d = c.call("GET", f"/rest/api/content/{page['id']}?expand=version,body.storage,metadata.labels")
    except Refused:
        return False
    if labels_of(d) != [] or version_of(d) != 1 or page_id(d.get("id")) != page["id"]:
        return False
    # Folded, as Confluence may break the sentence across lines: that changes no decision about whose page it is.
    return BANNER in " ".join(page_text(obj(obj(d.get("body")).get("storage")).get("value")).split())


def digest_of(page):
    msg = obj(page.get("version")).get("message")
    m = re.match(rf"{LABEL} ([0-9a-f]+)$", msg.strip()) if isinstance(msg, str) else None
    return m.group(1) if m else ""


# ---- markdown to Confluence's storage format -----------------------------------
# The subset the handbook's pages use: headings, paragraphs, lists, fenced code,
# tables, block quotes, rules, and inline code, emphasis, links and images.

INLINE = re.compile(
    r"(`+)(.+?)\1"                                                       # 1,2 code
    r"|!\[([^\]]*)\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)"          # 3,4 image
    r"|\[((?:[^\[\]]|\[[^\[\]]*\])*)\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)"  # 5,6 link
    r"|\*\*(?=\S)(.+?)(?<=\S)\*\*"                                       # 7 strong
    r"|(?<![A-Za-z0-9*])\*(?=[^\s*])(.+?)(?<=[^\s*])\*(?![A-Za-z0-9*])"  # 8 em
    r"|(?<![A-Za-z0-9_])_(?=[^\s_])(.+?)(?<=[^\s_])_(?![A-Za-z0-9_])"    # 9 em
    r"|~~(?=\S)(.+?)(?<=\S)~~"                                           # 10 strike
    r"|(https?://[^\s<>()\[\]]*[^\s<>()\[\].,;:!?'\"])"                  # 11 bare URL
)


def cdata(text):
    return "<![CDATA[" + text.replace("]]>", "]]]]><![CDATA[>") + "]]>"


ITEM = re.compile(r"(\s*)([-*+]|\d+[.)])\s+")
# The one rule for a line that opens a fenced block, wherever one is recognised: the mark, then at most a
# language word. A line such as "```foo``` is inline code" opens nothing.
FENCE_OPENER = re.compile(r"(\s*)(`{3,}|~{3,})\s*([A-Za-z0-9_+#.-]*)\s*$")


def fence_opens(line, any_indent=False):
    """The mark a line opens a fenced block with, or "". At the top level the fence is indented three spaces at
    most; inside a list item, as far as the item's text is, so any indent counts there."""
    m = FENCE_OPENER.match(line)
    return m.group(2) if m and (any_indent or len(m.group(1)) <= 3) else ""


def fence_closes(line, mark, any_indent=False):
    """Whether a line ends the block `mark` opened: the same mark, as long or longer, and nothing else on it."""
    m = re.match(rf"(\s*){re.escape(mark[0])}{{{len(mark)},}}\s*$", line)
    return bool(m) and (any_indent or len(m.group(1)) <= 3)


def marked(line):
    """(mark, column, what follows it, on an item's line) for a line that carries a fence's mark, after a list
    item's marker if it has one, or None."""
    m = ITEM.match(line)
    start = m.end() if m else 0
    f = re.match(r"(\s*)(`{3,}|~{3,})(.*)$", line[start:])
    return (f.group(2), start + len(f.group(1)), f.group(3), bool(m)) if f else None


class Fences:
    """Where a fenced block that opens inside a list closes. Only the lines that carry a fence's mark are looked
    at, once each to find them, so a page with many lines costs one pass."""
    def __init__(self, lines):
        self.lines = lines
        self.marks = [i for i, l in enumerate(lines) if marked(l)]
        self.at = {i: k for k, i in enumerate(self.marks)}

    def close(self, i):
        """The index of the line that closes the block lines[i] opens, or None when it opens none, or none that
        closes. The close is the first later line with the same mark, as long or longer: it closes the block
        if nothing else is on it, it isn't an item's line, and it is indented at least as far as the opening
        mark. Any other such line, such as another block's opening mark, means this one is never closed, and
        it then ends with its item, as it always did."""
        if i not in self.at:
            return None
        mark, col, after, _ = marked(self.lines[i])
        if not re.fullmatch(r"\s*[A-Za-z0-9_+#.-]*\s*", after):
            return None
        for j in range(self.at[i] + 1, len(self.marks)):
            m2, col2, after2, on_item = marked(self.lines[self.marks[j]])
            k = self.marks[j]
            if m2[0] == mark[0] and len(m2) >= len(mark):
                return k if not after2.strip() and not on_item and col2 >= col else None
        return None


def indent_of(line):
    return len(line) - len(line.lstrip())


class Renderer:
    def __init__(self, source_path="", titles=None):
        """source_path: the page's path inside its wiki. titles: path -> Confluence title."""
        self.dir = posixpath.dirname(source_path)
        self.titles = titles or {}

    def link(self, inner, url):
        if re.match(r"(?i)(https?|mailto):", url):
            return f"<a href={quoteattr(url)}>{inner}</a>"
        target = url.split("#", 1)[0]
        if target:
            path = posixpath.normpath(posixpath.join(self.dir, urllib.parse.unquote(target)))
            if path in self.titles:
                return (f"<ac:link><ri:page ri:content-title={quoteattr(self.titles[path])}/>"
                        f"<ac:link-body>{inner}</ac:link-body></ac:link>")
        # A heading on this page, a raw note, a file, another wiki: nothing to link to there.
        return inner

    def inline(self, text):
        out, pos = [], 0
        for m in INLINE.finditer(text):
            out.append(escape(text[pos:m.start()]))
            pos = m.end()
            if m.group(1):
                out.append(f"<code>{escape(m.group(2).strip())}</code>")
            elif m.group(4):
                src = m.group(4)
                if re.match(r"(?i)https?:", src):
                    out.append(f"<ac:image ac:alt={quoteattr(m.group(3))}><ri:url ri:value={quoteattr(src)}/></ac:image>")
                else:
                    out.append(f"<em>{escape(m.group(3) or posixpath.basename(src))} (image not published)</em>")
            elif m.group(6):
                out.append(self.link(self.inline(m.group(5)), m.group(6)))
            elif m.group(7):
                out.append(f"<strong>{self.inline(m.group(7))}</strong>")
            elif m.group(8) or m.group(9):
                out.append(f"<em>{self.inline(m.group(8) or m.group(9))}</em>")
            elif m.group(10):
                out.append(f"<del>{self.inline(m.group(10))}</del>")
            else:
                out.append(f"<a href={quoteattr(m.group(11))}>{escape(m.group(11))}</a>")
        out.append(escape(text[pos:]))
        return "".join(out)

    def blocks(self, lines, in_item=False):
        """in_item: the lines are what a list item holds, where a fence may be indented further."""
        out, i, n = [], 0, len(lines)
        para = []
        fences = None   # where a block in a list closes, read the first time a list is met

        def flush():
            if para:
                out.append("<p>" + self.inline(" ".join(s.strip() for s in para)) + "</p>")
                del para[:]

        while i < n:
            line = lines[i]
            fence = FENCE_OPENER.match(line) if fence_opens(line, in_item) else None
            if fence:
                flush()
                mark, lang, code = fence.group(2), fence.group(3), []
                # In an item, the block's lines lose the indent its fence has, as far as each has it.
                cut = len(fence.group(1)) if in_item else 0
                i += 1
                while i < n and not fence_closes(lines[i], mark, in_item):
                    code.append(lines[i][min(cut, indent_of(lines[i])):])
                    i += 1
                i += 1
                param = f'<ac:parameter ac:name="language">{escape(lang)}</ac:parameter>' if lang else ""
                out.append(f'<ac:structured-macro ac:name="code">{param}'
                           f"<ac:plain-text-body>{cdata(chr(10).join(code))}</ac:plain-text-body></ac:structured-macro>")
                continue
            if not line.strip():
                flush()
                i += 1
                continue
            h = re.match(r"\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$", line)
            if h:
                flush()
                out.append(f"<h{len(h.group(1))}>{self.inline(h.group(2))}</h{len(h.group(1))}>")
                i += 1
                continue
            if re.match(r"\s{0,3}([-*_])(\s*\1){2,}\s*$", line):
                flush()
                out.append("<hr/>")
                i += 1
                continue
            if re.match(r"\s{0,3}>", line):
                flush()
                quote = []
                while i < n and re.match(r"\s{0,3}>", lines[i]):
                    quote.append(re.sub(r"^\s{0,3}> ?", "", lines[i]))
                    i += 1
                out.append("<blockquote>" + self.blocks(quote) + "</blockquote>")
                continue
            if "|" in line and i + 1 < n and re.match(r"\s*\|?\s*:?-{1,}:?\s*(\|\s*:?-{1,}:?\s*)*\|?\s*$", lines[i + 1]) and "|" in lines[i + 1]:
                flush()
                rows = [line]
                i += 2
                while i < n and "|" in lines[i] and lines[i].strip():
                    rows.append(lines[i])
                    i += 1
                out.append(self.table(rows))
                continue
            if re.match(r"\s*([-*+]|\d+[.)])\s+", line):
                flush()
                item = []
                first = re.match(r"(\s*)([-*+]|\d+[.)])\s+", line)
                fences = fences or Fences(lines)
                until = -1
                while i < n:
                    if i <= until:
                        # From the line that opens a fenced block to the one that closes it, every line is the
                        # item's, a blank one, an unindented one, or one that looks like an item.
                        item.append(lines[i])
                        i += 1
                        continue
                    # A bulleted item after a numbered one, or the reverse, starts a new list.
                    m = re.match(r"(\s*)([-*+]|\d+[.)])\s+", lines[i])
                    if (m and item and len(m.group(1).expandtabs(4)) <= len(first.group(1).expandtabs(4))
                            and m.group(2)[0].isdigit() != first.group(2)[0].isdigit()):
                        break
                    if not lines[i].strip():
                        # A blank line ends the list unless an indented line or another item follows.
                        j = i
                        while j < n and not lines[j].strip():
                            j += 1
                        if j < n and (re.match(r"\s+\S", lines[j]) or re.match(r"([-*+]|\d+[.)])\s+", lines[j])):
                            item.append("")
                            i += 1
                            continue
                        break
                    if not re.match(r"\s*([-*+]|\d+[.)])\s+", lines[i]) and not re.match(r"\s+\S", lines[i]) and item and not item[-1].strip():
                        break
                    shut = fences.close(i)
                    until = until if shut is None else shut
                    item.append(lines[i])
                    i += 1
                out.append(self.list(item))
                continue
            para.append(line)
            i += 1
        flush()
        return "".join(out)

    def table(self, rows):
        def cells(row):
            row = row.strip()
            row = row[1:] if row.startswith("|") else row
            row = row[:-1] if row.endswith("|") and not row.endswith("\\|") else row
            return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", row)]
        out = ["<table><tbody><tr>"]
        out += [f"<th>{self.inline(c)}</th>" for c in cells(rows[0])]
        out.append("</tr>")
        for row in rows[1:]:
            out.append("<tr>" + "".join(f"<td>{self.inline(c)}</td>" for c in cells(row)) + "</tr>")
        out.append("</tbody></table>")
        return "".join(out)

    def list(self, lines):
        """One list: the items at the indent of its first line, each with what is under it."""
        first = re.match(r"(\s*)([-*+]|\d+[.)])\s+", lines[0])
        indent = len(first.group(1).expandtabs(4))
        tag = "ol" if first.group(2)[0].isdigit() else "ul"
        fences = Fences(lines)
        items, cur, until = [], None, -1
        for k, line in enumerate(lines):
            m = re.match(r"(\s*)([-*+]|\d+[.)])\s+(.*)", line)
            if k <= until:
                # A line in a fenced block is code, though it looks like an item.
                cur.append(line)
                continue
            shut = fences.close(k)
            if m and len(m.group(1).expandtabs(4)) <= indent:
                # An item whose text is a fence's opening mark: the block is its body, at the column of its text.
                cur = [" " * m.start(3) + m.group(3), True] if shut is not None else [m.group(3), False]
                items.append(cur)
            elif cur is not None:
                cur.append(line)
            until = until if shut is None else shut
        out = [f"<{tag}>"]
        for item in items:
            if item[1]:
                head, rest = [], [item[0]] + item[2:]
            else:
                head, rest = [item[0]], item[2:]
                while rest and rest[0].strip() and not re.match(r"\s*([-*+]|\d+[.)])\s+", rest[0]) and not re.match(r"\s*(```|~~~)", rest[0]):
                    head.append(rest.pop(0).strip())
            # What is left belongs to the item: take off the indent it shares, measured on the lines outside a
            # fenced block. A line inside one loses at most that much.
            inner, inside, until = Fences(rest), [], -1
            for k in range(len(rest)):
                inside.append(k <= until)
                shut = None if k <= until else inner.close(k)
                until = until if shut is None else shut
            pad = min((indent_of(l) for l, code in zip(rest, inside) if l.strip() and not code), default=0)
            body = self.blocks([l[min(pad, indent_of(l)):] for l in rest], True) if any(l.strip() for l in rest) else ""
            out.append("<li>" + self.inline(" ".join(head)) + body + "</li>")
        out.append(f"</{tag}>")
        return "".join(out)


def split_front(text):
    """(frontmatter as a dict of its plain `key: value` lines, the body's lines)"""
    lines = text.splitlines()
    front = {}
    if lines and lines[0].strip() == "---":
        for j in range(1, len(lines)):
            if lines[j].strip() == "---":
                for l in lines[1:j]:
                    m = re.match(r"([A-Za-z_][\w-]*):\s*(.*)$", l)
                    if m:
                        front[m.group(1)] = m.group(2).strip().strip("\"'")
                return front, lines[j + 1:]
    return front, lines


def title_of(front, body, fallback):
    if front.get("title"):
        return front["title"]
    for l in body:
        m = re.match(r"#\s+(.*?)\s*#*\s*$", l)
        if m:
            return re.sub(r"[*_`]", "", m.group(1))
        if l.strip():
            break
    return fallback


# Every page publish writes opens with it. A page with no label is taken as one an earlier run left half made
# only if its text has it.
BANNER = "published by llm-wiki. Changes made here are overwritten: ask an agent to change the wiki."


def render(text, wiki="", source_path="", titles=None):
    front, body = split_front(text)
    # Confluence shows the title itself, so the page's own first heading goes.
    k = 0
    while k < len(body) and not body[k].strip():
        k += 1
    if k < len(body) and re.match(r"#\s+", body[k]):
        body = body[k + 1:]
    banner = ('<ac:structured-macro ac:name="info"><ac:rich-text-body><p>'
              + (f"This page is a copy of <code>{escape(source_path)}</code> in the <strong>{escape(wiki)}</strong> wiki, " if wiki else "This page is a copy, ")
              + BANNER
              + "</p></ac:rich-text-body></ac:structured-macro>")
    meta = " · ".join(f"{k.capitalize()} {escape(front[k])}" for k in ("updated", "verified") if front.get(k))
    return banner + (f"<p><em>{meta}</em></p>" if meta else "") + Renderer(source_path, titles).blocks(body)


# ---- watching ------------------------------------------------------------------

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "llm-wiki", "extensions", "confluence")
PAGE_REF = re.compile(r"/pages/(\d+)|[?&]pageId=(\d+)")
NOTED = re.compile(r"^Confluence-page: (\d+) \| version (\d+) \| status (.*)$")
# A note this extension saved. A second in the same second is named <stamp>-confluence-2.md.
OWN_NOTE = re.compile(r"-confluence(-\d+)?\.md$")


def target(text):
    """("page", id), ("space", KEY) or (None, None) for what someone wrote."""
    text = text.strip()
    if text.lower().startswith("space:"):
        # A space's key is letters, digits and a few marks. Anything else is left out: the key
        # goes into a search Confluence runs, and a quote in it would change the search.
        key = text[6:].strip()
        return ("space", key) if re.fullmatch(r"[A-Za-z0-9~_-]{1,255}", key) else (None, None)
    m = PAGE_REF.search(text)
    if m:
        return "page", m.group(1) or m.group(2)
    return ("page", text) if text.isdigit() else (None, None)


class PageText(html.parser.HTMLParser):
    """A Confluence page as plain text: enough to read, and to see what changed."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []

    def handle_starttag(self, tag, attrs):
        if len(tag) == 2 and tag[0] == "h" and tag[1].isdigit():
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag in ("p", "div", "tr", "table", "ul", "ol", "blockquote", "br"):
            self.out.append("\n")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("td", "th"):
            self.out.append(" | ")
        elif tag == "ac:plain-text-body":
            self.out.append("\n    ")

    def handle_endtag(self, tag):
        if (len(tag) == 2 and tag[0] == "h" and tag[1].isdigit()) or tag in ("p", "table", "ul", "ol", "ac:plain-text-body"):
            self.out.append("\n")

    def handle_data(self, data):
        self.out.append(data)

    def unknown_decl(self, data):
        if data.startswith("CDATA["):
            self.out.append(data[6:].replace("\n", "\n    "))


# What str.splitlines() ends a line at, besides a newline.
LINE_ENDS = re.compile(r"\r\n?|[\x0b\x0c\x1c-\x1e\x85  ]")


def page_text(storage, limit=30000):
    parser = PageText()
    try:
        parser.feed(storage if isinstance(storage, str) else "")
        parser.close()
    except Exception:
        return ""
    # Every character any reader takes for a line's end is one, so a line of the page is a line of the note and
    # of its diff. Any other control character is a space.
    text = LINE_ENDS.sub("\n", "".join(parser.out))
    text = "".join(" " if unicodedata.category(ch) == "Cc" and ch not in "\n\t" else ch for ch in text)
    lines = [re.sub(r"[ \t]+", " ", l).rstrip() for l in text.split("\n")]
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
    return text if len(text) <= limit else text[:limit] + "\n(cut here: the page is longer)"


def fetch_page(c, pid):
    """{id, title, version, by, when, link, text}, or None for a page that can't be read, and for an answer
    that isn't that page: one whose id isn't the one asked for, or whose version isn't a number."""
    try:
        d = c.call("GET", f"/rest/api/content/{pid}?expand=version,body.storage")
    except Refused:
        return None
    v = obj(d.get("version"))
    if page_id(d.get("id")) != pid or version_of(d) is None:
        return None
    # What the server says goes into a note and a printed line, one line each: see server_text.
    return {"id": pid, "title": server_text(d.get("title")) or f"page {pid}", "version": version_of(d),
            "by": server_text(obj(v.get("by")).get("displayName")), "when": server_text(v.get("when")),
            "link": c.url + (web_path(obj(d.get("_links")).get("webui")) or f"/pages/viewpage.action?pageId={pid}"),
            "text": page_text(obj(obj(d.get("body")).get("storage")).get("value"))}


def web_path(value):
    """A link Confluence gives, as one line with no spaces in it, for printing and for a note."""
    return server_text(value).replace(" ", "%20")


def page_state(c, pid):
    """The page's status, such as Verified, or nothing where it has none or the server has no such thing."""
    try:
        d = c.call("GET", f"/rest/api/content/{pid}/state")
    except Refused:
        return ""
    return server_text(obj(d.get("contentState")).get("name"))


def available_states(c, pid):
    try:
        d = c.call("GET", f"/rest/api/content/{pid}/state/available")
    except Refused:
        return []
    found = [x for k in ("spaceContentStates", "customContentStates") if isinstance(d.get(k), list) for x in d[k]]
    return [obj(x).get("name") for x in found if isinstance(obj(x).get("name"), str) and obj(x).get("name")]


# A space's next check starts this long before the time its last one began, by the earlier of the two clocks,
# this machine's and Confluence's. A change the search hadn't taken in yet, or one stamped by a clock behind
# the other, is still found. A page read again is noted only if its version or its status is new to the wiki.
OVERLAP = datetime.timedelta(minutes=10)
# Confluence's clock is believed when it is at most this far from this machine's. Further off, the date is
# wrong, and this machine's time is used.
SANE_CLOCK = datetime.timedelta(hours=24)
# The most requests one check makes for one space's changes: 200 pages of results.
MOST_REQUESTS = 200


def server_time(c, began):
    """The time Confluence's answer was sent, when its Date says one within SANE_CLOCK of this machine's."""
    try:
        t = email.utils.parsedate_to_datetime(c.date)
        t = t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)
        return t if abs(t - began) <= SANE_CLOCK else None
    except (TypeError, ValueError, IndexError, OverflowError):
        return None


def first_mark(c, key):
    """The time a space is watched from, the first time: now, by the earlier of the two clocks, as every later
    check's time is. None when the space can't be read."""
    began = datetime.datetime.now(datetime.timezone.utc)
    q = urllib.parse.urlencode({"cql": f'space = "{key}" and type = page', "limit": 1})
    try:
        results(c.call("GET", "/rest/api/content/search?" + q))
    except Refused:
        return None
    return min(began, server_time(c, began) or began)


def space_pages(c, key, since):
    """({page id: version} for the pages in a space changed at or after `since`, the time the next check of
    the space starts from), with every page of results read. (None, why) when a request is refused, an
    answer can't be read, or the results don't end, and then nothing in the space counts as read. The search
    is asked for a day earlier, since it reads dates in the account's own time zone, and narrowed here."""
    asked = (since - datetime.timedelta(days=1)).strftime("%Y-%m-%d %H:%M")
    # Newest first: a page changed while the results are read moves to the front, not past the place
    # already read, and the next check finds it.
    cql = f'space = "{key}" and type = page and lastmodified >= "{asked}" order by lastmodified desc'
    began = datetime.datetime.now(datetime.timezone.utc)
    server = None
    out, seen, start = {}, set(), 0
    for n in range(MOST_REQUESTS):
        # Every request is built here. A next link Confluence gives only says there is more: the path in it
        # isn't followed, so a link that drops the search can't stand in for it.
        path = "/rest/api/content/search?" + urllib.parse.urlencode({"cql": cql, "expand": "version", "limit": 100, "start": start})
        try:
            d = c.call("GET", path)
            res = results(d)
        except Refused as e:
            if n == 0:
                return None, "can't be read"
            if e.code == 0:
                return None, f"was read only in part: page {n + 1} of its changes couldn't be read"
            return None, f"was read only in part: Confluence refused page {n + 1} of its changes"
        if n == 0:
            server = server_time(c, began)
        if not res:
            # The end is a page with nothing on it. One that says there is more, with nothing on it, is no end.
            if obj(d.get("_links")).get("next"):
                return None, f"was read only in part: page {n + 1} of its changes was empty, and Confluence said there were more"
            mark = min(began, server or began) - OVERLAP
            return out, max(mark, since)
        if n > 0 and all(r["id"] in seen for r in res):
            return None, f"was read only in part: page {n + 1} of its changes held only pages already read"
        for r in res:
            seen.add(r["id"])
            v = obj(r.get("version"))
            when = parse_when(server_text(v.get("when")))
            if when is None or when >= since:
                out.setdefault(r["id"], version_of(r) or 0)
        start += len(res)
    return None, f"has more changes than one check reads ({MOST_REQUESTS} pages of results)"


def parse_when(text):
    try:
        t = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)


def note_order(name):
    """Oldest first: by the stamp, then by the number a same-second note was given."""
    m = re.match(r"(.*)-confluence(?:-(\d+))?\.md$", name)
    return (m.group(1), int(m.group(2) or 1)) if m else (name, 0)


def note_lines(text):
    """The lines of a note outside its fenced blocks, as a markdown reader finds them. The page's text, and the
    diff of it, are in fenced blocks: a line there that reads as a record or a Done: line is the page's, and
    never the note's. A block left open runs to the note's end."""
    out, mark = [], ""
    for line in text.splitlines():
        if mark:
            mark = "" if fence_closes(line, mark) else mark
        elif fence_opens(line):
            mark = fence_opens(line)
        else:
            out.append(line)
    return out


def fence_for(*texts):
    """A fence of backticks that no line of the texts can close: longer than any run of backticks in them."""
    return "`" * max([4] + [len(r) + 1 for t in texts for r in re.findall(r"`+", t)])


def noted(root):
    """{page id: (version, status)} as the wiki's own notes last recorded it. The notes
    are in git, so every machine that syncs the wiki reads the same answer."""
    out = {}
    raw = os.path.join(root, "raw")
    try:
        names = sorted((n for n in os.listdir(raw) if OWN_NOTE.search(n)), key=note_order)
    except OSError:
        return out
    for n in names:
        try:
            with open(os.path.join(raw, n), encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        for line in note_lines(text):
            m = NOTED.match(line)
            if m:
                out[m.group(1)] = (int(m.group(2)), m.group(3).strip())
    return out


def waiting_lines(wiki_cmd, root, wiki, wikis_dir):
    """The lines of this extension's notes that no compile has taken yet, outside their fenced blocks."""
    r = subprocess.run([wiki_cmd, "pending", wiki], capture_output=True, text=True, env=in_collection(wikis_dir))
    names = [l.split()[0][len("raw/"):] for l in r.stdout.splitlines() if l.startswith("raw/")] if r.returncode == 0 else []
    lines = set()
    for n in names:
        if OWN_NOTE.search(n):
            try:
                with open(os.path.join(root, "raw", n), encoding="utf-8", errors="replace") as f:
                    lines.update(note_lines(f.read()))
            except OSError:
                pass
    return lines


def cache_path(pid):
    if not page_id(pid):
        raise ValueError("a page's id is digits")
    return os.path.join(STATE, "pages", f"{pid}.txt")


def read_cache(pid):
    try:
        with open(cache_path(pid), encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def since_path(key):
    return os.path.join(STATE, f"space-{re.sub(r'[^A-Za-z0-9~._-]', '_', key)}.since")


def cmd_check(args):
    save = "--save" in args
    rest = [a for a in args if a != "--save"]
    if any(a.startswith("-") for a in rest) or len(rest) > 1:
        die_usage(f"check takes --save and a wiki's name. {CMD} confluence --help")
    conf = settings()
    need_sign_in(conf)
    os.environ.get("WIKIS_DIR") or die("WIKIS_DIR isn't set. Run this as: wiki confluence")
    wiki_cmd = os.environ.get("LLM_WIKI") or die("LLM_WIKI isn't set. Run this as: wiki confluence")
    only = which_wiki(rest[0]) if rest else None
    if rest and not only:
        die(f"{rest[0]} isn't a wiki here. {CMD} status lists the wikis.")
    here = here_collection()
    c = Confluence(conf)
    now = datetime.datetime.now(datetime.timezone.utc)
    finished = done_states(conf)
    found = {}     # (collection, wiki) -> [change]
    closes = {}    # (collection, wiki) -> [heading]
    waiting = {}   # (collection, wiki) -> the lines of its notes no compile has taken yet
    bad = 0
    # Space key -> the time its next check starts from. A space that wasn't read whole in this run, for any
    # wiki, keeps the time it had, so every change in it is read again.
    marks = {}
    unread = set()

    # What each watch.<wiki> names, in the collection it names. Each wiki's notes go into it there.
    lists = {}     # (collection, wiki) -> [what it watches]
    named = 0
    for entry, refs in watch_lists(conf).items():
        coll, wiki, why = find_wiki(entry)
        if only and (wiki != only[2] or (not why and coll != only[0])):
            continue
        named += 1
        if why == "missing":
            print(warn(f"watch.{entry} names a wiki that isn't here. Take it out of {CONFIG}."))
        elif why:
            print(warn(entry_fault(f"watch.{entry}", entry, why, watch_as) + ". Nothing was checked for it."))
        if why:
            bad = 1
            continue
        lists.setdefault((coll, wiki), [])
        lists[(coll, wiki)] += [r for r in refs if r not in lists[(coll, wiki)]]

    for (coll, wiki), refs in lists.items():
        shown = label(coll, wiki)
        print(f"== {shown}")
        root = os.path.join(collection_folder(coll), wiki)
        known = noted(root)
        ids = []
        named_ids = []
        space_of = {}   # page id -> the space it was found in
        for ref in refs:
            kind, val = target(ref)
            if kind == "page":
                ids.append(val)
                named_ids.append(val)
            elif kind == "space":
                try:
                    with open(since_path(val), encoding="utf-8") as f:
                        since = parse_when(f.read().strip())
                except OSError:
                    since = None
                if since is None:
                    first = first_mark(c, val)
                    if first is None:
                        unread.add(val)
                        print("  " + warn(f"the space {val} can't be read. Check it in watch.{shown} in {CONFIG}."))
                        bad = 1
                        continue
                    print(f"  space {val}: watched from now on. Pages changed after this will be noted.")
                    marks[val] = min(first, marks.get(val, first))
                    continue
                got, why = space_pages(c, val, since)
                if got is None:
                    unread.add(val)
                    if why == "can't be read":
                        print("  " + warn(f"the space {val} can't be read. Check it in watch.{shown} in {CONFIG}."))
                    else:
                        print("  " + warn(f"the space {val} {why}. Nothing in it is noted, and the next check reads it again."))
                    bad = 1
                    continue
                marks[val] = min(why, marks.get(val, why))
                # A page read again, from the overlap, whose version and status the wiki has noted is left out.
                # Its status is asked for: a status changes with no new version.
                fresh = [i for i, v in got.items()
                         if not (i in known and v and v <= known[i][0] and page_state(c, i) == known[i][1])]
                print(f"  space {val}: {len(fresh)} page(s) changed since {since:%Y-%m-%d %H:%M} UTC")
                for i in fresh:
                    space_of.setdefault(i, val)
                ids += [i for i in fresh if i not in ids]
            else:
                print("  " + warn(f"{ref} isn't a page's address, an id, or space:KEY. Fix watch.{shown} in {CONFIG}."))
                bad = 1
        for pid in ids:
            page = fetch_page(c, pid)
            if page is None:
                if pid in space_of:
                    # The space's time stays, so the page is read again next time, or no longer listed.
                    unread.add(space_of[pid])
                if pid in named_ids or pid not in space_of:
                    print("  " + warn(f"{pid} isn't a page you can read. Take it out of watch.{shown} in {CONFIG}."))
                else:
                    print("  " + warn(f"{pid}, changed in the space {space_of[pid]}, can't be read now. The next check reads the space again."))
                bad = 1
                continue
            page["status"] = page_state(c, pid)
            was = known.get(pid)
            who = f"by {page['by']} " if page["by"] else ""
            if was is None:
                page["kind"] = "first read"
            elif page["version"] > was[0]:
                page["kind"] = f"changed {who}on {page['when'][:10]}"
            elif page["status"] != was[1]:
                page["kind"] = "status changed"
            else:
                page["kind"] = ""
            page["was"] = was
            stat = f"version {page['version']}" + (f", {page['status']}" if page["status"] else "")
            print(f"  {page['title'][:44]:<44} {stat:<28} {page['kind'] or 'unchanged'}")
            if page["kind"]:
                found.setdefault((coll, wiki), []).append(page)

    # An open item whose heading links a page closes when the page's status means finished. In
    # this collection, any wiki's; in another, only a wiki that a watch.<wiki> names there.
    colls = [only[0]] if only else [here] + [k[0] for k in lists if k[0] != here]
    for coll in [x for i, x in enumerate(colls) if x not in colls[:i]]:
        folder = collection_folder(coll)
        r = subprocess.run([wiki_cmd, "open", "--data"] + ([only[2]] if only else []), capture_output=True, text=True,
                           env=in_collection(folder))
        for line in r.stdout.splitlines() if r.returncode == 0 else []:
            f = line.split("\t")
            if len(f) < 8 or f[1] not in ("open", "overdue"):
                continue
            key = (coll, f[0])
            if coll != here and not only and key not in lists:
                continue
            m = PAGE_REF.search(f[7])
            if not m:
                continue
            st = page_state(c, m.group(1) or m.group(2))
            if st and st.lower() in finished:
                if key not in found and key not in closes and key not in lists:
                    print(f"== {label(coll, f[0])}")
                print(f"  open item: {f[7][:70]}")
                if key not in waiting:
                    waiting[key] = waiting_lines(wiki_cmd, os.path.join(folder, f[0]), f[0], folder)
                if f"Done: {f[7]}" in waiting[key]:
                    # A waiting note already asks for it: leave it out.
                    print(f"      its page is {st}: already noted as done, waiting for a compile")
                else:
                    print(f"      its page is {st}, which means finished: the item closes")
                    closes.setdefault(key, []).append((f[7], st))

    n = sum(len(v) for v in found.values()) + sum(len(v) for v in closes.values())
    print()
    if not named and not closes:
        print(f"No wiki watches a page yet. Run: {CMD} extensions setup confluence. {GUIDE}")
    if n == 0:
        if named:
            print("Nothing changed.")
    elif not save:
        print(f"{n} change(s) to note. To note them in the wiki: {CMD} confluence check --save")
    else:
        for key in sorted(set(found) | set(closes)):
            coll, wiki = key
            folder, shown = collection_folder(coll), label(coll, wiki)
            pages = found.get(key, [])
            note = [f"# Confluence: what changed, as of {now:%Y-%m-%d}", "",
                    f"Source: {c.url}, read by `wiki confluence` on {now:%Y-%m-%d %H:%M} UTC.", ""]
            for page in pages:
                old = read_cache(page["id"])
                # Saved by an earlier version, it may hold line ends that page_text now makes plain ones.
                old = None if old is None else LINE_ENDS.sub("\n", old)
                note += [f"## {page['title']}", "", f"- page: {page['link']}",
                         f"- change: {page['kind']}" + (f", version {page['version']}" if "version" not in page["kind"] else ""),
                         "- status: " + (page["status"] or "none")
                         + (f" (was {page['was'][1] or 'none'})" if page["was"] and page["was"][1] != page["status"] else ""), ""]
                if page["kind"] != "status changed":
                    diff = None
                    if old is not None and old != page["text"]:
                        diff = "\n".join(difflib.unified_diff(old.split("\n"), page["text"].split("\n"), "before", "now", lineterm="", n=2))
                    # A fence the text can't close, so nothing in the page reads as the note's own line.
                    if diff and len(diff) < len(page["text"]):
                        fence = fence_for(diff)
                        note += ["What changed in the page's text:", "", fence + "diff", diff, fence, ""]
                    else:
                        fence = fence_for(page["text"])
                        note += ["The page's text:", "", fence + "text", page["text"], fence, ""]
            for page in pages:
                note.append(f"Confluence-page: {page['id']} | version {page['version']} | status {page['status']}")
            for h, st in closes.get(key, []):
                note += ["", f"The page this item waits on is {st}.", f"Done: {h}"]
            # From the wikis' folder, so a ticket folder's name isn't written into a note about pages. And in
            # the wiki's own collection, which needn't be the one this run is in.
            r = subprocess.run([wiki_cmd, "capture", wiki, "confluence"], input="\n".join(note) + "\n", text=True, capture_output=True,
                               cwd=folder or None, env=in_collection(folder))
            if r.returncode != 0:
                die(f"couldn't save the note in {shown}: {r.stderr.strip()}")
            r = subprocess.run([wiki_cmd, "sync", wiki, "-m", f"Confluence: {len(pages) + len(closes.get(key, []))} change(s)"],
                               capture_output=True, text=True, env=in_collection(folder))
            if r.returncode != 0:
                again = f"{CMD} sync {wiki}" + ("" if coll == here else f" --collection {coll}")
                die(f"saved the note in {shown}, but the sync failed. Run: {again}")
            for page in pages:
                try:
                    os.makedirs(os.path.dirname(cache_path(page["id"])), exist_ok=True)
                    with open(cache_path(page["id"]), "w", encoding="utf-8") as f:
                        f.write(page["text"])
                except OSError:
                    pass
            print(f"{shown}: noted {len(pages) + len(closes.get(key, []))} change(s). The next compile works them into the wiki.")
    if save:
        # Only once every wiki's note is saved: a run that stops before then reads the same changes again.
        for key, mark in marks.items():
            if key in unread:
                continue
            try:
                os.makedirs(STATE, exist_ok=True)
                with open(since_path(key), "w", encoding="utf-8") as f:
                    f.write(mark.isoformat())
            except OSError:
                pass
    return bad


# ---- commands ------------------------------------------------------------------

def wiki_pages(wiki_cmd, root, wiki, wikis_dir):
    """[(path in the wiki, title, text)], the index first. Which pages there are, and
    the title each goes by, come from `wiki pages --data`."""
    def read(p):
        with open(p, encoding="utf-8", errors="replace") as f:
            return f.read()
    r = subprocess.run([wiki_cmd, "pages", wiki, "--data"], capture_output=True, text=True, env=in_collection(wikis_dir))
    if r.returncode != 0:
        die((r.stderr.strip() or f"couldn't list the pages of {wiki}").replace("error: ", "", 1))
    pages = []
    for line in r.stdout.splitlines():
        f = line.split("\t")
        if len(f) >= 4:
            pages.append((f[0], f[3], read(os.path.join(root, f[0]))))
    seen = {}
    for rel, title, _ in pages:
        seen.setdefault(title.lower(), []).append(rel)
    out = [("index.md", f"{wiki} wiki", read(os.path.join(root, "index.md")))]
    for rel, title, text in pages:
        # Confluence wants one title per space, so each carries its wiki's name.
        full = f"{wiki}: {title}"
        if len(seen[title.lower()]) > 1:
            full += f" ({rel[len('wiki/'):-3]})"
        out.append((rel, full[:255], text))
    return out


def which_wiki(name):
    """A wiki named on the command line: (collection, folder, wiki). A bare name is the
    collection's this runs in; collection/wiki names one in another."""
    wikis_dir = os.environ.get("WIKIS_DIR") or die("WIKIS_DIR isn't set. Run this as: wiki confluence")
    if "/" not in name:
        if not is_wiki(name):
            return None
        return here_collection(), wikis_dir, name
    coll, wiki, why = find_wiki(name)
    if why:
        return None
    return coll, collection_folder(coll), wiki


def cmd_publish(args, target=None):
    """publish <wiki>, or with target, (collection, folder, wiki), a wiki an event publishes."""
    dry = "--dry-run" in args
    rest = [a for a in args if a != "--dry-run"]
    if target is None:
        if len(rest) != 1 or rest[0].startswith("-"):
            die_usage(f"usage: {CMD} confluence publish <wiki> [--dry-run]")
        target = which_wiki(rest[0]) or die(f"no wiki called {rest[0]}")
    coll, wikis_dir, wiki = target
    root = os.path.join(wikis_dir, wiki)
    conf = settings()
    need_sign_in(conf)
    space, fault = per_wiki(conf, "space", coll, wiki)
    parent, fault2 = per_wiki(conf, "parent", coll, wiki)
    if fault or fault2:
        die(f"{fault or fault2}. Nothing was published")
    space = space or conf.get("space")
    parent = parent or conf.get("parent") or ""
    shown = label(coll, wiki)
    if not space:
        die(f"no space to publish {shown} into. Run: {CMD} extensions setup confluence (or set space.{shown} in {CONFIG}). {GUIDE}")
    wiki_cmd = os.environ.get("LLM_WIKI") or die("LLM_WIKI isn't set. Run this as: wiki confluence")
    pages = wiki_pages(wiki_cmd, root, wiki, wikis_dir)
    titles = {rel: title for rel, title, _ in pages}
    c = Confluence(conf)
    print(f"{'Would publish' if dry else 'Publishing'} {len(pages)} page(s) of {shown} to the space {space} at {c.url}")

    made = changed = same = 0
    problems = []

    def taken(title, page=None):
        if page is not None and looks_published(page):
            # Its version message is publish's, but it fails another test of a page an earlier run left half
            # made, such as a label something else added, a line break in the banner, or another parent.
            return (f"{title}: a page of that name is in the space with publish's version note but not the llm-wiki label, "
                    f"so it isn't taken as llm-wiki's. {AFTER_HALF}")
        return (f"{title}: a page of that name is already in the space, and llm-wiki didn't make it. "
                "Rename that page in Confluence, or change this page's title in the wiki.")
    finished = set()   # ids of the pages this run labelled, for a change that then fails

    def finish(page, title):
        """Label a page an earlier run made and didn't label, and go on with it as one of ours. The label call
        has no version check, so the page is read again after it: one a person saved a new version of in the
        meantime has the label taken off again, and is theirs. Refused, saying so, for that."""
        if not dry:
            c.label(page["id"])
            try:
                now_v = version_of(c.call("GET", f"/rest/api/content/{page['id']}?expand=version"))
            except Refused:
                now_v = None
            if now_v != 1:
                try:
                    c.unlabel(page["id"])
                    undone = "and its llm-wiki label was taken off again"
                except Refused:
                    undone = "and publish couldn't take its llm-wiki label off again: take it off in Confluence"
                raise Refused(0, f"someone saved a new version of it while publish was finishing it, so it is left as theirs, {undone}")
            finished.add(page["id"])
        print(f"  {'would finish' if dry else 'finished'}: {title} (an earlier run made it and didn't label it)")
        metadata = page["metadata"] = obj(page.get("metadata"))
        metadata["labels"] = {"results": [{"name": LABEL}]}

    def unfinish(page):
        """Take the label off a page this run labelled, whose change then failed: a person may have saved it."""
        if page is not None and page.get("id") in finished:
            try:
                c.unlabel(page["id"])
                return ". Its llm-wiki label was taken off again, as someone may have saved it in the meantime"
            except Refused:
                return ". Someone may have saved it in the meantime: take its llm-wiki label off in Confluence"
        return ""

    clashes = [0]
    root_title = pages[0][1]
    try:
        top = c.find(space, root_title)
    except Refused as e:
        die(f"can't read the space {space}: {e.message}. Check space in {CONFIG}, or run: {CMD} extensions setup confluence. {GUIDE}")
    if top is not None and not ours(top):
        if not half_made(c, top):
            if looks_published(top):
                die(f"the space {space} already has a page called \"{root_title}\" with publish's version note but not the "
                    f"llm-wiki label, so it isn't taken as llm-wiki's. {AFTER_HALF}")
            die(f"the space {space} already has a page called \"{root_title}\" that llm-wiki didn't make. Rename it, or publish to another space.")
        try:
            finish(top, root_title)
        except Refused as e:
            die(f"couldn't publish \"{root_title}\": {e.message}")
    existing = {}
    if top is not None:
        try:
            for p in c.children(top["id"]):
                existing[server_text(p.get("title"))] = p
        except Refused as e:
            die(f"couldn't read the pages under \"{root_title}\": {e.message}")

    def put(rel, title, text, page, parent_id):
        nonlocal made, changed, same
        body = render(text, wiki, rel, titles)
        digest = hashlib.sha256((title + "\n" + body).encode()).hexdigest()[:16]
        if page is not None:
            if not ours(page):
                if not half_made(c, page):
                    problems.append(taken(title, page))
                    return page
                try:
                    finish(page, title)
                except Refused as e:
                    problems.append(f"{title}: {e.message}" if e.code == 0 else f"{title}: Confluence refused its label: {e.message}")
                    return page
            if digest_of(page) == digest:
                same += 1
                return page
            changed += 1
            print(f"  {'would update' if dry else 'updated'}: {title}")
            if dry:
                return page
            try:
                done_page = c.update(page, title, body, digest)
            except Refused as e:
                raise Refused(e.code, e.message + unfinish(page))
            # Its answer is used only if it is this page.
            return done_page if page_id(done_page.get("id")) == page["id"] else page
        if dry:
            # A page of that name anywhere in the space stops the real run, so look now.
            if c.find(space, title) is not None:
                problems.append(taken(title))
                return None
            made += 1
            print(f"  would create: {title}")
            return None
        new = c.create(space, title, body, parent_id, digest)
        made += 1
        print(f"  created: {title}")
        return new

    try:
        top = put("index.md", root_title, pages[0][2], top, parent)
    except Refused as e:
        die(f"couldn't publish \"{root_title}\": {e.message}")
    for rel, title, text in pages[1:]:
        try:
            put(rel, title, text, existing.get(title), top["id"] if top else None)
        except Refused as e:
            changed -= 1 if title in existing else 0
            problems.append(taken(title) if "already exists" in e.message.lower() else f"{title}: {e.message}")
            # Someone else wrote the page between our read and our write.
            clashes[0] += 1 if e.code == 409 else 0
    gone = sorted(t for t, p in existing.items() if t not in titles.values() and ours(p))

    print(f"{shown}: {made} {'to create' if dry else 'created'}, {changed} {'to update' if dry else 'updated'}, {same} unchanged.")
    for t in gone:
        print(f"  no longer in the wiki, left in Confluence: {t}")
    for p in problems:
        print(f"  not published: {p}")
    if top and not dry:
        link = web_path(obj(top.get("_links")).get("webui")) or f"/pages/viewpage.action?pageId={top['id']}"
        print(f"{c.url}{link}")
    if problems and EVENT and clashes[0] == len(problems):
        return 75
    return 1 if problems else 0


def cmd_render(args):
    if len(args) != 1:
        die_usage(f"usage: {CMD} confluence render <file.md>")
    try:
        with open(args[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError as e:
        die(f"can't read {args[0]}: {e.strerror}")
    print(render(text, "", os.path.basename(args[0])))
    return 0


def cmd_config(args):
    if args:
        die_usage("config takes no arguments")
    conf = settings()
    # The address is checked before the token is fetched, as everywhere else.
    bad = address_trouble()
    if bad:
        die(f"{bad}. Do: fix it, in a terminal: {CMD} extensions setup confluence")
    # And so is the saved certificates file: with one that can't be used, nothing is asked for.
    if TRUST_PROBLEM:
        die(TRUST_PROBLEM)
    _, where = token(conf)
    print(f"shared    {SHARED}{'' if os.path.isfile(SHARED) else ' (not there yet)'}")
    print(f"file      {CONFIG}{'' if os.path.isfile(CONFIG) else ' (not there yet)'}")
    print(f"url       {conf['url'] or 'not set'}{came_from(conf, 'url')}")
    print(f"email     {conf.get('email') or 'not set, so the token is sent as a Data Center personal access token'}{came_from(conf, 'email')}")
    print(f"token     {'from ' + where if where else 'not set'}")
    for wiki, refs in watch_lists(conf).items():
        print(f"watch     {wiki}: {', '.join(refs)}")
        why = find_wiki(wiki)[2]
        if why == "missing":
            print(warn(f"watch.{wiki} names a wiki that isn't here. Take it out of {CONFIG}."))
        elif why:
            print(warn(entry_fault(f"watch.{wiki}", wiki, why, watch_as) + ". Nothing is checked for it."))
    if not watch_lists(conf):
        print("watch     off: no pages named")
    print(f"finished  {', '.join(x.capitalize() for x in done_states(conf))}")
    print(f"space     {conf.get('space') or 'not set'}")
    print(f"auto      {', '.join(auto_wikis(conf)) or 'off'}")
    for w in auto_wikis(conf):
        why = find_wiki(w)[2]
        if why == "missing":
            print(warn(f"auto names {w}, which isn't a wiki here. Take it out of auto in {CONFIG}."))
        elif why:
            print(warn(entry_fault("auto", w, why, auto_as) + ". Nothing is published for it by itself."))
    for k in sorted(conf):
        if k.startswith(("space.", "parent")) and k != "_from":
            print(f"{k:<9} {conf[k]}")
            # A bare one that more than one collection has counts for none: each of them without a
            # setting of its own is refused when published, and named here.
            key, _, wiki = k.partition(".")
            if key not in ("space", "parent") or not conf[k] or not NAME_OK.match(wiki):
                continue
            found = having(wiki)
            lacking = [c for c in found if not conf.get(f"{key}.{c}/{wiki}")]
            if len(found) > 1 and lacking:
                pick = here_collection() if here_collection() in lacking else lacking[0]
                which = " and ".join(f"{c}/{wiki}" for c in lacking)
                print(warn(f"{k} names {wiki}, and {how_many(len(found))} collections have a wiki called {wiki}: {', '.join(found)}, "
                           f"so it counts for none of them. {which} {'is' if len(lacking) == 1 else 'are'} not published until you "
                           f"say which in {CONFIG}, such as {key}.{pick}/{wiki} = {conf[k]}."))
    if not conf["url"] or not where:
        print(f"\nNot set up: {sign_in_missing(conf)}. Run: {CMD} extensions setup confluence. {GUIDE}")
        return 1
    try:
        me = Confluence(conf).call("GET", "/rest/api/user/current")
    except Refused as e:
        die(f"{conf['url']} has no Confluence API at /rest/api ({e.code}). Is url the address of Confluence itself? On Cloud it ends in /wiki.")
    print(f"\nSigned in as {me.get('displayName') or me.get('username') or '?'}.")
    if not watch_lists(conf) and not conf.get("space"):
        print(f"Nothing is chosen yet: no pages to watch, and no space to publish into. Run: {CMD} extensions setup confluence. {GUIDE}")
    elif not conf.get("space"):
        print("Publishing is off: no space is set.")
    return 0


def is_wiki(name):
    """A wiki of this collection, by name. An extension is one file and can import no other,
    so this is a copy of wiki.sh's is_wiki, with the others it names."""
    return wiki_in(os.environ.get("WIKIS_DIR", ""), name)


def wiki_folder(path):
    """wiki.sh's is_wiki: an index.md, and an AGENTS.md that is the handbook, which its
    "Handbook version N." line says. A handbook that can't be read counts, as it does there.
    The same test is in wiki.sh, internal/routing, hooks/reminders.py, hooks/session-start.sh,
    mcp/server.py and extensions/wiki-confluence: change them together. A folder whose
    AGENTS.md, index.md, raw or wiki is a link is not a wiki (code review M24)."""
    if any(os.path.islink(os.path.join(path, p)) for p in ("AGENTS.md", "index.md", "raw", "wiki")):
        return False
    agents = os.path.join(path, "AGENTS.md")
    if not (os.path.isfile(agents) and os.path.isfile(os.path.join(path, "index.md"))):
        return False
    try:
        with open(agents, "rb") as f:
            data = f.read()
    except OSError:
        return True
    for line in data.split(b"\n"):
        # A line ends at a NUL byte, as bash 3.2 reads it.
        line = line.split(b"\0", 1)[0]
        if line.startswith(b"Handbook version ") and line[17:18].isdigit():
            return True
    return False


def auto_wikis(conf):
    return [w.strip() for w in conf.get("auto", "").split(",") if w.strip()]


# ---- which wiki a setting names ------------------------------------------------------------
# The settings are one file a machine, and every collection has a wiki called global. So a
# setting names a wiki as `wiki` or `collection/wiki`, and a bare name names a wiki only where
# no other collection has one of that name. One that more than one has names none of them:
# nothing is published or watched for it, and the run says what to write instead.

NAME_OK = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*\Z")
COLLECTION_OK = re.compile(r"[A-Za-z0-9_-]+\Z")
# What llm-wiki calls a folder that no collection is listed for, such as a test's WIKIS_DIR. No
# collection can have the name, so no setting can name it.
UNNAMED = "(unnamed)"


def here_collection():
    """The name of the collection this run is in, as llm-wiki hands it over."""
    return os.environ.get("LLM_WIKI_COLLECTION") or UNNAMED


def collections():
    """[(name, folder)]: the collections on this machine, from LLM_WIKI_COLLECTIONS, with the one
    this run is in at the folder in WIKIS_DIR. Run by an older llm-wiki, or by hand, only that one.
    A line whose name no collection can have is left out."""
    here, folder = here_collection(), os.environ.get("WIKIS_DIR", "")
    out = []
    for line in os.environ.get("LLM_WIKI_COLLECTIONS", "").split("\n"):
        name, tab, path = line.partition("\t")
        if not tab or not path or any(n == name for n, _ in out):
            continue
        if name == here:
            out.append((name, folder))
        elif COLLECTION_OK.match(name):
            out.append((name, path))
    if not any(n == here for n, _ in out):
        out.append((here, folder))
    return out


def collection_folder(name):
    return next((f for n, f in collections() if n == name), None)


_LISTED = {}


def wiki_in(folder, wiki):
    """Whether folder holds a wiki called exactly wiki: a name wiki.sh's own rule takes (letters,
    digits, dots, dashes and underscores, not starting with a dot or a dash), spelled as the folder
    lists it, so a disk that ignores case can't make Global and global one wiki."""
    if not folder or not NAME_OK.match(wiki or ""):
        return False
    if folder not in _LISTED:
        try:
            _LISTED[folder] = set(os.listdir(folder))
        except OSError:
            _LISTED[folder] = set()
    return wiki in _LISTED[folder] and wiki_folder(os.path.join(folder, wiki))


def having(wiki):
    """The collections that have a wiki of that name."""
    return [n for n, f in collections() if wiki_in(f, wiki)]


def find_wiki(entry):
    """What an entry of a setting names: (collection, wiki, why). why is "" when it names one wiki;
    "form" when it is neither a name nor collection/wiki; "collection" when this machine has no
    collection of that name; "missing" when there is no such wiki; "several" for a bare name that
    more than one collection has, which names none of them."""
    coll, slash, wiki = entry.partition("/")
    if slash:
        if not COLLECTION_OK.match(coll) or not NAME_OK.match(wiki):
            return coll, wiki, "form"
        folder = collection_folder(coll)
        if folder is None:
            return coll, wiki, "collection"
        return coll, wiki, "" if wiki_in(folder, wiki) else "missing"
    if not NAME_OK.match(entry):
        return None, entry, "form"
    found = having(entry)
    if len(found) > 1:
        return None, entry, "several"
    return (found[0], entry, "") if found else (here_collection(), entry, "missing")


def names(entry, coll, wiki):
    """Whether an entry of a setting names this wiki of this collection, and it alone."""
    return find_wiki(entry) == (coll, wiki, "")


def label(coll, wiki):
    """A wiki as a person reads it: with its collection's name when that isn't the collection this
    run is in, or when another collection has a wiki of that name."""
    return f"{coll}/{wiki}" if coll != here_collection() or len(having(wiki)) > 1 else wiki


def in_collection(folder):
    """The environment for a call into llm-wiki about a wiki of the collection in folder."""
    env = dict(os.environ)
    env["WIKIS_DIR"] = folder
    return env


def watch_as(w):
    return f"watch.{w}"


def auto_as(w):
    return f"auto = {w}"


def how_many(n):
    return {2: "two", 3: "three", 4: "four", 5: "five"}.get(n, str(n))


def several(wiki, example):
    """The words for a bare name that more than one collection has, ending with the fix. example
    gives the setting as it should be written, from collection/wiki."""
    found = having(wiki)
    pick = here_collection() if here_collection() in found else found[0]
    return (f"{how_many(len(found))} collections have a wiki called {wiki}: {', '.join(found)}. "
            f"Say which in {CONFIG}, such as {example(pick + '/' + wiki)}")


def entry_fault(setting, entry, why, example):
    """Why an entry of a setting names no wiki, in one line with its fix, for every why but "missing",
    whose words each caller has. example is as for several()."""
    if why == "several":
        return f"{setting} names {entry}, and " + several(entry, example)
    if why == "collection":
        return (f"{setting} names {entry}, and this machine has no collection called {entry.partition('/')[0]}. "
                f"Take it out of {CONFIG}, or fix the name")
    if why == "form":
        return f"{setting} names {entry}, which is neither a wiki's name nor collection/wiki. Fix it in {CONFIG}"
    return ""


def bare_twin(own, entry):
    """For watch.<collection>/<wiki>: (the bare watch.<wiki>,) when the file has one and it names that
    same wiki, so the one with its collection takes its place in the same write. Else ()."""
    coll, slash, wiki = entry.partition("/")
    if slash and f"watch.{wiki}" in own and find_wiki(wiki) == (coll, wiki, ""):
        return (f"watch.{wiki}",)
    return ()


def per_wiki(conf, key, coll, wiki):
    """space.<wiki> or parent.<wiki> for one wiki: (value, fault). The entry with its collection
    wins. A bare one counts only where no other collection has a wiki of that name."""
    if conf.get(f"{key}.{coll}/{wiki}"):
        return conf[f"{key}.{coll}/{wiki}"], ""
    if conf.get(f"{key}.{wiki}"):
        if len(having(wiki)) > 1:
            value = conf[f"{key}.{wiki}"]
            return "", f"{key}.{wiki} names {wiki}, and " + several(wiki, lambda w: f"{key}.{w} = {value}")
        return conf[f"{key}.{wiki}"], ""
    return "", ""


def on_event(args):
    """Run by llm-wiki for an event. On tick it checks the watched pages and notes what
    changed, then catches up on publishing. On sync it publishes a wiki that auto names."""
    global EVENT
    EVENT = True
    conf = settings()
    auto = auto_wikis(conf)
    worst = 0
    if args[:1] == ["tick"]:
        worst = cmd_check(["--save"])
    if not auto:
        print("auto is empty, so nothing was published.")
        return worst
    if args[:1] == ["sync"] and len(args) > 1:
        # The sync was of this wiki in the collection this run is in, and auto has to name that one.
        wiki, here = args[1], here_collection()
        unclear = [e for e in auto if e == wiki and find_wiki(e)[2] == "several"]
        for e in unclear:
            print(entry_fault("auto", e, "several", auto_as) + ".")
        if not any(names(e, here, wiki) for e in auto):
            if unclear:
                print("Nothing was published.")
                return 1
            print(f"{label(here, wiki)} isn't in auto, so it wasn't published.")
            return 0
        try:
            with open(os.environ.get("LLM_WIKI_CHANGED", ""), encoding="utf-8", errors="replace") as f:
                paths = f.read().split("\n")
        except OSError:
            paths = ["index.md"]
        if not any(p == "index.md" or p.startswith("wiki/") for p in paths):
            print(f"no page of {label(here, wiki)} changed, so nothing was published.")
            return 1 if unclear else 0
        code = cmd_publish([], (here, os.environ.get("WIKIS_DIR", ""), wiki))
        return code if code or not unclear else 1
    if args[:1] == ["tick"]:
        # Catch up on a publish that a sync couldn't make. Unchanged pages cost a read. Each wiki
        # is published from its own collection, whichever one this tick started in.
        done = []
        for entry in auto:
            coll, wiki, why = find_wiki(entry)
            if why == "missing":
                print(f"auto names {entry}, which isn't a wiki here. Take it out of auto in {CONFIG}.")
            elif why:
                print(entry_fault("auto", entry, why, auto_as) + ". Nothing was published for it.")
            if why:
                worst = 1
                continue
            if (coll, wiki) in done:
                continue
            done.append((coll, wiki))
            # One wiki that can't be published, such as for a setting that names it unclearly, says
            # why in the log and the rest are still published. The run fails at the end.
            try:
                code = cmd_publish([], (coll, collection_folder(coll), wiki))
            except SystemExit as e:
                sys.stderr.flush()
                code = e.code if isinstance(e.code, int) else 1
            code = 1 if code not in (0, 1, 75) else code
            worst = code if code == 1 or worst == 0 else worst
        return worst
    return 0


# ---- what a session can change: llm-wiki's contract, version 4 -------------------------

# Where a value came from, in the words --wiki-settings uses.
SOURCES = {"this file": "file", "the shared file": "shared file", "token_cmd": "file",
           "token_cmd in the shared file": "shared file", "Jira's settings": "file",
           "token_cmd in Jira's settings": "file"}


def source_name(src):
    if not src:
        return "default"
    if src in SOURCES:
        return SOURCES[src]
    return f"environment ({src})"


def own_value(own, env_name, key):
    """A setting of Confluence's own, from the environment (where there is a name for it) or its file."""
    if env_name and os.environ.get(env_name):
        return os.environ[env_name], source_name(env_name)
    if own.get(key):
        return own[key], "file"
    return "", "default"


PUBLISH = "Publishing writes to Confluence, so the user sets it in a terminal: " + f"{CMD} extensions setup confluence"


def on_mac():
    """Whether the keychain preset fits this machine. LLM_WIKI_TEST_OS lets the tests see both answers."""
    return (os.environ.get("LLM_WIKI_TEST_OS") or sys.platform) == "darwin"


def setting_rows():
    """One row for each setting a session may look at: key, value, where from, meaning, and
    whether a session can change it. Reads files and the environment only: it never runs
    token_cmd and never touches the network, and a token's value is never in it."""
    own = read_conf(CONFIG)
    shared = read_conf(SHARED)
    jira = read_conf(os.path.join(CONFIG_DIR, "jira"))
    conf = settings()
    src = conf["_from"]
    mac = on_mac()
    if os.environ.get("ATLASSIAN_SITE"):
        site, site_from = os.environ["ATLASSIAN_SITE"], "environment (ATLASSIAN_SITE)"
    elif shared.get("site"):
        site, site_from = shared["site"], "shared file"
    else:
        site, site_from = jira.get("url", ""), ("file" if jira.get("url") else "default")
    rows = [
        ("site", site.rstrip("/"), site_from, f"The Atlassian site. The user runs {CMD} extensions setup confluence in a terminal: it asks for the address, the account and where the token "
         f"comes from. Then {CMD} confluence config tests it. On Cloud, Confluence is at its /wiki",
         "terminal"),
        ("email", conf.get("email", ""), source_name(src["email"]), "Your Atlassian account's email. Empty on Data Center. Part of that setup", "terminal"),
    ]
    tok_env = next((n for n in TOKEN_ENV if os.environ.get(n)), "")
    tok_from = source_name(tok_env) if tok_env else (source_name(src["token_cmd"]) if conf.get("token_cmd") else "")
    rows.append(("token", "set" if tok_env else ("not checked (token_cmd is set)" if conf.get("token_cmd") else "not set"), tok_from,
                 "The user makes one at https://id.atlassian.com/manage-profile/security/api-tokens "
                 "(Data Center: a personal access token) and "
                 + ("runs in their own terminal: security add-generic-password -a \"$USER\" -s atlassian -U -w \"$(pbpaste)\""
                    if mac else "keeps it in their own password manager, such as pass"), "terminal"))
    cmd = conf.get("token_cmd", "")
    shown = "keychain" if cmd == KEYCHAIN_CMD else ("custom command" if cmd else "")
    what = "Where the token comes from: the keychain command the setup offers, or a command of your own. Part of that setup"
    rows.append(("token_cmd", shown, source_name(src["token_cmd"]) if cmd else "default", what, "terminal"))
    url, url_from = own_value(own, "CONFLUENCE_URL", "url")
    rows.append(("url", url, url_from, "Confluence's own address, only where the site isn't on Atlassian Cloud. Part of that setup", "terminal"))
    watching = sorted(k for k in own if k.startswith("watch.") and own[k].strip())
    watch_what = "Pages that wiki hears about when they change: page addresses or ids, or space:KEY for a whole space, which only the user sets, in a terminal. Watching only reads"
    for k in watching:
        rows.append((k, own[k], "file", watch_what, "set"))
    if not watching:
        rows.append(("watch.<wiki>", "", "default", watch_what, "set"))
    value, where = own_value(own, "", "done_states")
    rows.append(("done_states", value, where, "Page statuses that mean finished, which close an open item that links the page. Verified if unset", "set"))
    for key, env_name in (("space", "CONFLUENCE_SPACE"), ("auto", "CONFLUENCE_AUTO")):
        value, where = own_value(own, env_name, key)
        rows.append((key, value, where, PUBLISH, "terminal"))
    for k in sorted(own):
        if k.startswith(("space.", "parent")) and own[k]:
            rows.append((k, own[k], "file", PUBLISH, "terminal"))
    if not own.get("parent"):
        rows.append(("parent", "", "default", PUBLISH, "terminal"))
    return rows


LOCAL_HOSTS = ("localhost", "127.0.0.1", "::1")


def address_problem(url):
    """Why an address can't be used, in words that don't repeat it, or nothing: https://, or http:// only for this machine; a
    host; no login, query or fragment; no space or control character. A person types it, or a file or the environment holds
    it, and the sign-in is sent there, so it is read by a parser and not by how the string ends."""
    if not url or unfit(url) or any(c.isspace() or c == "\\" for c in url):
        return "has a space, a backslash or a control character in it, or is empty"
    try:
        u = urllib.parse.urlsplit(url)
        host = u.hostname or ""
        u.port  # noqa: B018 (a bad port raises here)
    except ValueError:
        return "isn't an address"
    if u.scheme not in ("http", "https") or not host:
        return "isn't an address: it starts with https:// and names a host"
    if "@" in u.netloc or u.username is not None or u.password is not None:
        return "has a login in it, which is never sent"
    if u.query or u.fragment or "?" in url or "#" in url:
        return "has a query or a # in it: give only the address"
    if u.scheme == "http" and host.lower() not in LOCAL_HOSTS:
        return "is plain http:// to another machine, where the sign-in would cross the network in the clear: use https://"
    return ""


def is_cloud(site):
    """Whether an address is on Atlassian Cloud: its parsed host, not how the string ends."""
    try:
        host = (urllib.parse.urlsplit(site).hostname or "").lower()
    except ValueError:
        return False
    return host.endswith(".atlassian.net") and not address_problem(site)


def signin_key(key, name):
    """A sign-in setting is never set, changed or cleared from a session, whatever it is now: a session that was misled
    could otherwise have the token sent somewhere else."""
    die_usage(f"{key} is part of the sign-in, and a session never sets it: a session that was misled could have the token sent somewhere else. "
              f"The user sets up sign-in in a terminal: {CMD} extensions setup {name}")


def wiki_settings():
    for row in setting_rows():
        print("\t".join(" ".join(str(f).split()) for f in row))
    return 0


def secret_key(key):
    k = key.lower()
    if k == "token_cmd":
        return False
    return any(w in k for w in ("token", "password", "passwd", "secret", "api_key", "apikey"))


def wiki_set(args):
    """--wiki-set <key> <value>: check the key and the shape of the value, then write it where
    the interactive setup would. A - clears it. Exit 2, and one line why, for what it refuses.
    Publishing is never set from here: it sends a wiki to a space."""
    if len(args) != 2:
        die_usage("usage: --wiki-set <key> <value>")
    for what, text in (("key", args[0]), ("value", args[1])):
        if unfit(text):
            die_usage(f"the {what} {unfit(text)}, so nothing was written")
    key, value = args[0].strip(), args[1].strip()
    if secret_key(key):
        die_usage(f"{key} is a secret, and a session never sets one. The user puts the token in their keychain themselves, and then sets up sign-in in a terminal: {CMD} extensions setup confluence")
    if key in ("space", "parent", "auto") or key.startswith(("space.", "parent.")):
        die_usage(f"{key} is for publishing, which writes to Confluence. The user sets it in a terminal: {CMD} extensions setup confluence")
    if key in ("site", "email", "token_cmd", "url"):
        signin_key(key, "confluence")
    fixed = ("site", "email", "token_cmd", "url", "done_states")
    if key not in fixed and not (key.startswith("watch.") and len(key) > 6):
        die_usage(f"no setting a session can change is called {key}. Settings: watch.<wiki>, done_states")
    if not value:
        die_usage(f"give {key} a value, or - to clear it")
    if "#" in value:
        die_usage(f"{key} can't hold a #, which starts a comment in the settings file")
    clear = value == "-"
    path = CONFIG
    drop = ()
    if key == "done_states":
        out = "" if clear else value
    else:
        entry = key[len("watch."):]
        _, wiki, why = find_wiki(entry)
        if why == "missing":
            die_usage(f"{entry} isn't one of your wikis, so it can't hear about pages. {CMD} list shows them")
        if why:
            die_usage(entry_fault(key, entry, why, watch_as) + ". Nothing was written")
        own = read_conf(CONFIG)
        out = ""
        if not clear:
            # Watching a whole space saves every page in it as a note, from now on, so it takes a
            # terminal. One already in this setting may stay; a session adds none.
            had = [x.strip() for x in own.get(key, "").split(",") if x.strip()]
            kept = []
            for t in [x.strip() for x in value.split(",") if x.strip()]:
                kind, ref = target(t)
                if kind is None:
                    die_usage(f"each entry of {key} is a page's address, an id, or space:KEY")
                if kind == "space" and f"space:{ref}" not in had:
                    die_usage(f"space:{ref} watches a whole space, which saves every page in it as a note, so a session doesn't set it. "
                              f"The user sets it in a terminal: {CMD} extensions setup confluence")
                kept.append(f"space:{ref}" if kind == "space" else ref)
            out = ", ".join(kept)
            drop = bare_twin(own, entry)
    set_conf(path, key, out, drop)
    line = f"{key} {'cleared' if not out else 'set'} in {path}"
    print(line)
    for k in drop:
        print(f"{k} taken out: {key} names the same wiki with its collection")
    return 0


def main(argv):
    # A settings file may hold bytes that aren't UTF-8, kept as they are when read. Printing one
    # shows it escaped rather than ending the run.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="backslashreplace")
        except (AttributeError, ValueError):
            pass
    if argv and argv[0] == "--wiki-settings":
        return wiki_settings()
    if argv and argv[0] == "--wiki-set":
        return wiki_set(argv[1:])
    if argv and argv[0] == "--wiki-event":
        return on_event(argv[1:])
    if argv and argv[0] == "--wiki-ready":
        msg = not_ready(settings())
        if msg:
            print(msg)
        return 1 if msg else 0
    if argv and argv[0] == "--wiki-setup":
        # Its answers are saved as settings, a sign-in among them, which a session never sets.
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die(f"setup asks questions and saves what you answer, so a person answers them at a terminal. "
                f"Agents: run {CMD} setup --guide confluence and follow it with the user in this session, "
                f"or tell the user to run {CMD} extensions setup confluence in a terminal.")
        return setup()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0 if argv else 1
    cmds = {"check": cmd_check, "publish": cmd_publish, "render": cmd_render, "config": cmd_config}
    if argv[0] not in cmds:
        die_usage(f"confluence takes check, publish, render or config. {CMD} confluence --help")
    return cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
