def wiki_pages(wiki_cmd, root, wiki):
    """[(path in the wiki, title, text)], the index first. Which pages there are, and
    the title each goes by, come from `wiki pages --data`."""
    def read(p):
        with open(p, encoding="utf-8", errors="replace") as f:
            return f.read()
    r = subprocess.run([wiki_cmd, "pages", wiki, "--data"], capture_output=True, text=True)
    if r.returncode != 0:
        die((r.stderr.strip() or f"couldn't list the pages of {wiki}").replace("error: ", "", 1))
    pages = []
    for line in r.stdout.splitlines():
        f = line.split("\t")
        if len(f) >= 4:
            pages.append((f[0], f[3], read(os.path.join(root, f[0]))))
    seen = {}
    for rel, title, _ in pages:
        seen.setdefault(title.lower(), []).append(rel)
    out = [("index.md", f"{wiki} wiki", read(os.path.join(root, "index.md")))]
    for rel, title, text in pages:
        # Confluence wants one title per space, so each carries its wiki's name.
        full = f"{wiki}: {title}"
        if len(seen[title.lower()]) > 1:
            full += f" ({rel[len('wiki/'):-3]})"
        out.append((rel, full[:255], text))
    return out


def cmd_publish(args):
    dry = "--dry-run" in args
    rest = [a for a in args if a != "--dry-run"]
    if len(rest) != 1 or rest[0].startswith("-"):
        die_usage(f"usage: {CMD} confluence publish <wiki> [--dry-run]")
    wiki = rest[0]
    wikis_dir = os.environ.get("WIKIS_DIR") or die("WIKIS_DIR isn't set. Run this as: wiki confluence")
    root = os.path.join(wikis_dir, wiki)
    if "/" in wiki or not (os.path.isfile(os.path.join(root, "AGENTS.md")) and os.path.isfile(os.path.join(root, "index.md"))):
        die(f"no wiki called {wiki}")
    conf = settings()
    need_sign_in(conf)
    space = conf.get(f"space.{wiki}") or conf.get("space")
    parent = conf.get(f"parent.{wiki}") or conf.get("parent") or ""
    if not space:
        die(f"no space to publish {wiki} into. Run: {CMD} extensions setup confluence (or set space.{wiki} in {CONFIG})")
    wiki_cmd = os.environ.get("LLM_WIKI") or die("LLM_WIKI isn't set. Run this as: wiki confluence")
    pages = wiki_pages(wiki_cmd, root, wiki)
    titles = {rel: title for rel, title, _ in pages}
    c = Confluence(conf)
    print(f"{'Would publish' if dry else 'Publishing'} {len(pages)} page(s) of {wiki} to the space {space} at {c.url}")

    made = changed = same = 0
    problems = []

    def taken(title):
        return (f"{title}: a page of that name is already in the space, and llm-wiki didn't make it. "
                "Rename that page in Confluence, or change this page's title in the wiki.")
    clashes = [0]
    root_title = pages[0][1]
    try:
        top = c.find(space, root_title)
    except Refused as e:
        die(f"can't read the space {space}: {e.message}. Check space in {CONFIG}, or run: {CMD} extensions setup confluence")
    if top is not None and not ours(top):
        die(f"the space {space} already has a page called \"{root_title}\" that llm-wiki didn't make. Rename it, or publish to another space.")
    existing = {}
    if top is not None:
        for p in c.children(top["id"]):
            existing[p.get("title", "")] = p

    def put(rel, title, text, page, parent_id):
        nonlocal made, changed, same
        body = render(text, wiki, rel, titles)
        digest = hashlib.sha256((title + "\n" + body).encode()).hexdigest()[:16]
        if page is not None:
            if not ours(page):
                problems.append(taken(title))
                return page
            if digest_of(page) == digest:
                same += 1
                return page
            changed += 1
            print(f"  {'would update' if dry else 'updated'}: {title}")
            return page if dry else (c.update(page, title, body, digest) or page)
        if dry:
            # A page of that name anywhere in the space stops the real run, so look now.
            if c.find(space, title) is not None:
                problems.append(taken(title))
                return None
            made += 1
            print(f"  would create: {title}")
            return None
        new = c.create(space, title, body, parent_id, digest)
        made += 1
        print(f"  created: {title}")
        return new

    try:
        top = put("index.md", root_title, pages[0][2], top, parent)
    except Refused as e:
        die(f"couldn't publish \"{root_title}\": {e.message}")
    for rel, title, text in pages[1:]:
        try:
            put(rel, title, text, existing.get(title), top["id"] if top else None)
        except Refused as e:
            changed -= 1 if title in existing else 0
            problems.append(taken(title) if "already exists" in e.message.lower() else f"{title}: {e.message}")
            # Someone else wrote the page between our read and our write.
            clashes[0] += 1 if e.code == 409 else 0
    gone = sorted(t for t, p in existing.items() if t not in titles.values() and ours(p))

    print(f"{wiki}: {made} {'to create' if dry else 'created'}, {changed} {'to update' if dry else 'updated'}, {same} unchanged.")
    for t in gone:
        print(f"  no longer in the wiki, left in Confluence: {t}")
    for p in problems:
        print(f"  not published: {p}")
    if top and not dry:
        link = ((top.get("_links") or {}).get("webui")) or f"/pages/viewpage.action?pageId={top['id']}"
        print(f"{c.url}{link}")
    if problems and EVENT and clashes[0] == len(problems):
        return 75
    return 1 if problems else 0


def cmd_render(args):
    if len(args) != 1:
        die_usage(f"usage: {CMD} confluence render <file.md>")
    try:
        with open(args[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError as e:
        die(f"can't read {args[0]}: {e.strerror}")
    print(render(text, "", os.path.basename(args[0])))
    return 0


def cmd_config(args):
    if args:
        die_usage("config takes no arguments")
    conf = settings()
    _, where = token(conf)
    print(f"shared    {SHARED}{'' if os.path.isfile(SHARED) else ' (not there yet)'}")
    print(f"file      {CONFIG}{'' if os.path.isfile(CONFIG) else ' (not there yet)'}")
    print(f"url       {conf['url'] or 'not set'}{came_from(conf, 'url')}")
    print(f"email     {conf.get('email') or 'not set, so the token is sent as a Data Center personal access token'}{came_from(conf, 'email')}")
    print(f"token     {'from ' + where if where else 'not set'}")
    print(f"space     {conf.get('space') or 'not set'}")
    print(f"auto      {', '.join(auto_wikis(conf)) or 'off'}")
    for w in auto_wikis(conf):
        if not is_wiki(w):
            print(warn(f"auto names {w}, which isn't a wiki here. Take it out of auto in {CONFIG}."))
    for k in sorted(conf):
        if k.startswith(("space.", "parent")) and k != "_from":
            print(f"{k:<9} {conf[k]}")
    if not conf["url"] or not where:
        print(f"\nNot set up: {sign_in_missing(conf)}. Run: {CMD} extensions setup confluence")
        return 1
    try:
        me = Confluence(conf).call("GET", "/rest/api/user/current")
    except Refused as e:
        die(f"{conf['url']} has no Confluence API at /rest/api ({e.code}). Is url the address of Confluence itself? On Cloud it ends in /wiki.")
    print(f"\nSigned in as {me.get('displayName') or me.get('username') or '?'}.")
    if not conf.get("space"):
        print(f"No space is set, so publish has nowhere to go yet. Run: {CMD} extensions setup confluence")
    return 0


def is_wiki(name):
    root = os.path.join(os.environ.get("WIKIS_DIR", ""), name)
    return "/" not in name and os.path.isfile(os.path.join(root, "AGENTS.md")) and os.path.isfile(os.path.join(root, "index.md"))


def auto_wikis(conf):
    return [w.strip() for w in conf.get("auto", "").split(",") if w.strip()]


def on_event(args):
    """Run by llm-wiki for an event. Publishes only the wikis that auto names."""
    global EVENT
    EVENT = True
    auto = auto_wikis(settings())
    if not auto:
        print("auto is empty, so nothing was published.")
        return 0
    if args[:1] == ["sync"] and len(args) > 1:
        wiki = args[1]
        if wiki not in auto:
            print(f"{wiki} isn't in auto, so it wasn't published.")
            return 0
        try:
            with open(os.environ.get("LLM_WIKI_CHANGED", ""), encoding="utf-8", errors="replace") as f:
                paths = f.read().split("\n")
        except OSError:
            paths = ["index.md"]
        if not any(p == "index.md" or p.startswith("wiki/") for p in paths):
            print(f"no page of {wiki} changed, so nothing was published.")
            return 0
        return cmd_publish([wiki])
    if args[:1] == ["tick"]:
        # Catch up on a publish that a sync couldn't make. Unchanged pages cost a read.
        worst = 0
        for wiki in auto:
            if not is_wiki(wiki):
                print(f"auto names {wiki}, which isn't a wiki here. Take it out of auto in {CONFIG}.")
                worst = 1
                continue
            code = cmd_publish([wiki])
            worst = code if code == 1 or worst == 0 else worst
        return worst
    return 0


def main(argv):
    if argv and argv[0] == "--wiki-event":
        return on_event(argv[1:])
    if argv and argv[0] == "--wiki-ready":
        msg = not_ready(settings())
        if msg:
            print(msg)
        return 1 if msg else 0
    if argv and argv[0] == "--wiki-setup":
        return setup()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0 if argv else 1
    cmds = {"publish": cmd_publish, "render": cmd_render, "config": cmd_config}
    if argv[0] not in cmds:
        die_usage(f"confluence takes publish, render or config. {CMD} confluence --help")
    return cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
