    print("clone, so it asks about each watched one. The limits are listed before you say yes.")
    setup_fix(conf)
    conf = settings()
    # Asked last, so that the questions before it are in the order they have always been.
    print()
    print("One more: it can tell the next session when someone comments on or reviews one of your open pull")
    print(f"requests: how many and from whom, never what they wrote. {CMD} github comments prints them.")
    set_conf(CONFIG, "comments", "yes" if ask_yn("Tell a session about new comments on your pull requests?", conf["comments"]) else "")
    conf = settings()
    print()
    print("What is set")
    print("  gh        " + ("signed in" if ok else "not signed in"))
    print("  watch     " + (", ".join(conf["watch"]) or "nothing yet"))
    print("  notes     " + ("on: a fixed failure is noted in its wiki" if conf["remember"] else "off"))
