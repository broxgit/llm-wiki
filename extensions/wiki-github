def watched(conf=None):
    """The folders in the watch setting, as written."""
    return cc.watched(CONFIG, conf)


# A test command an agent may run is a plain command: words, no quote, no wildcard, no shell
# character. Never one that is itself a way to reach the network, a shell, or git.
ALLOW_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._/=:@+-]*$")
ALLOW_NEVER = ("git", "gh", "curl", "wget", "ssh", "scp", "sftp", "nc", "ncat", "telnet", "sh", "bash", "zsh", "dash", "fish",
               "ksh", "csh", "env", "sudo", "su", "doas", "eval", "exec", "xargs", "open", "osascript")
MODEL_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@-]*$")


def allow_list(text):
    """(entries that are fine, entries refused) from a comma-separated fix_allow."""
    good, bad = [], []
    for raw in str(text).split(","):
        e = " ".join(raw.split())
        if not e:
            continue
        first = os.path.basename(e.split(" ")[0]).lower()
        if ALLOW_OK.fullmatch(e) and first not in ALLOW_NEVER and len(e) <= 120:
            if e not in good:
                good.append(e)
        else:
            bad.append(e[:60])
    return good, bad


def bounded(text, default, low, high):
    try:
        n = int(str(text).strip())
    except ValueError:
        return default
    return n if low <= n <= high else default


def settings():
    own = read_conf(CONFIG)
    allow, allow_bad = allow_list(own.get("fix_allow", FIX_DEFAULTS["fix_allow"]))
    agent = own.get("fix_agent", "").strip() or FIX_DEFAULTS["fix_agent"]
    model = own.get("fix_model", "").strip()
    return {
        "watch": watched(own),
        "remember": is_yes(own.get("remember", DEFAULTS["remember"])),
        "notice": is_yes(own.get("notice", DEFAULTS["notice"])),
        "desktop": is_yes(own.get("desktop", DEFAULTS["desktop"])),
        "comments": is_yes(own.get("comments", "no")),
