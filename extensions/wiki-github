def read_line():
    """One line from standard input, a byte at a time, so nothing meant for whoever
    reads next is taken. None when the input has ended."""
    buf = b""
    while True:
        c = os.read(0, 1)
        if not c:
            return buf.decode(errors="replace") if buf else None
        if c == b"\n":
            return buf.decode(errors="replace")
        buf += c


def ask_yn(prompt, default=False):
    sys.stdout.write(f"{prompt} [{'Y/n' if default else 'y/N'}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    line = line.strip().lower()
    return default if line == "" else line.startswith("y")


def hosts_file():
    base = os.environ.get("GH_CONFIG_DIR") or os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "gh")
    return os.path.join(base, "hosts.yml")


def ready():
    """Whether gh is there and has been signed in. Files only: no network, no questions."""
    if not shutil.which(GH_BIN):
        return "gh isn't installed"
    try:
        if os.path.getsize(hosts_file()) > 0:
            return ""
    except OSError:
        pass
    return "gh isn't signed in yet"


def ask_text(prompt, default):
    sys.stdout.write(f"{prompt} [{default}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    return line.strip() or default


def setup_fix(conf):
    """Step 4: for each watched clone, whether an unattended fix is on, then what the agent is and may run."""
    if not at_a_terminal():
        print("  This is offered at a terminal only, by a person. Do: run this yourself in a terminal, or later:")
        print(f"  {CMD} github fix on")
        return
    paths = watched()
    if not paths:
        print(f"  No clone is watched yet, so there is nothing to fix. Later: {CMD} github watch, then {CMD} github fix on")
        return
    on = [p for p in conf["fix"] if os.path.realpath(p) in [os.path.realpath(w) for w in paths]]
    shown = False
    for p in paths:
        top = os.path.realpath(p)
        if fix_on(p, conf):
            if not ask_yn(f"  Keep fixing on for {top}?", True):
                on = [q for q in on if os.path.realpath(q) != top]
            continue
        try:
            info = repo_info(p)
        except (NotGitHub, SystemExit):
            print(f"  {top} isn't a clone of a repository GitHub knows, so it is skipped.")
            continue
        if not shown:
            for line in fix_words(conf, info["name"], info["default"]):
                print("  " + line if line else "")
            shown = True
        if ask_yn(f"  Turn fixing on for {info['name']} ({top})?", False):
            on.append(p)
    set_conf(CONFIG, "fix", ", ".join(on))
    if not on:
        return
    agent = ask_text("  Which agent? claude, or a command that reads the prompt on standard input", conf["fix_agent"])
    model = ask_text("  Which model, for claude?", conf["fix_model"])
    allow = ask_text("  Which test commands may it run, separated by commas? Enter keeps them; - clears", ", ".join(conf["fix_allow"]) or "none")
    files = ask_text("  Most files a fix may change?", str(conf["fix_max_files"]))
    lines = ask_text("  Most changed lines (added plus removed)?", str(conf["fix_max_lines"]))
    for key, value in (("fix_agent", agent), ("fix_model", model)):
        if value and not unfit(value) and "#" not in value and (key == "fix_agent" or MODEL_OK.fullmatch(value)):
            set_conf(CONFIG, key, "" if value == FIX_DEFAULTS[key] else value)
        else:
            print(f"  {key} wasn't changed: that isn't something it can hold.")
    if allow in ("-", "none"):
        set_conf(CONFIG, "fix_allow", "")
    elif allow != (", ".join(conf["fix_allow"]) or "none"):
        good, bad = allow_list(allow)
        if bad:
            print(f"  Not allowed, and left out: {', '.join(bad)}. A plain test command only: no git, gh, curl, shell or wildcard.")
        set_conf(CONFIG, "fix_allow", ", ".join(good))
    for key, value, high in (("fix_max_files", files, 100), ("fix_max_lines", lines, 5000)):
        n = bounded(value, 0, 1, high)
        if n:
            set_conf(CONFIG, key, "" if n == FIX_DEFAULTS[key] else str(n))
        else:
            print(f"  {key} wasn't changed: give a number from 1 to {high}.")
    ask_build(conf)


def setup():
    """Run by `wiki setup` and `wiki extensions setup github`, at a terminal."""
    print("GitHub Actions, for your wikis")
    print("When a CI run fails, it can tell you which workflow, job and step, and the first line that")
    print("looks like the error, and keep a short excerpt of the failing log on this machine, in place of")
    print("megabytes of it. It reads GitHub through gh, and it never sees your sign-in. It reads only,")
    print("UNLESS you turn fixing on for a clone, in step 4: then, for a run that starts failing, it can push one")
    print("commit to a pull request's branch you opened, or open a pull request, with nobody watching. It never")
    print("force-pushes, never pushes to the default branch, never reruns or cancels a run, never merges.")
    print()
    print("Enter keeps the answer in brackets. You can run this again at any time:")
    print(f"  {CMD} extensions setup github")
    print()
    print("== Step 1 of 4: sign in")
