        "fix_agent": agent if not unfit(agent) else FIX_DEFAULTS["fix_agent"],
        "fix_model": model if MODEL_OK.fullmatch(model) else FIX_DEFAULTS["fix_model"],
        "fix_allow": allow,
        "fix_allow_bad": allow_bad,
        "fix_max_files": bounded(own.get("fix_max_files", ""), FIX_DEFAULTS["fix_max_files"], 1, 100),
        "fix_max_lines": bounded(own.get("fix_max_lines", ""), FIX_DEFAULTS["fix_max_lines"], 1, 5000),
