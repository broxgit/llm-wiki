def folder_arg(args, what):
    if len(args) > 1 or any(a.startswith("-") for a in args):
        die_usage(f"{what} takes one folder, or none for the current one. Run: {CMD} github --help")
    folder = os.path.abspath(os.path.expanduser(args[0])) if args else os.getcwd()
    if not os.path.isdir(folder):
        die_usage(f"{args[0] if args else folder} isn't a folder. Do: name a clone, or run it inside one")
    return folder


def write_watch(paths):
    set_conf(CONFIG, "watch", ", ".join(paths))


def cmd_watch(args):
    if args == ["--list"]:
        paths = watched()
        if not paths:
            print(f"No folders are watched. Run: {CMD} github watch <folder>")
        for p in paths:
            print(p + ("" if os.path.isdir(p) else "  (gone)"))
        return 0
    folder = folder_arg(args, "watch")
    top = clone_top(folder)
    if not top:
        die(f"{folder} isn't in a git clone. Do: run this in a clone of a GitHub repository, or name one")
    if "," in top or "#" in top:
        die(f"{top} has a comma or a # in its path, which the settings file can't hold. Do: watch a clone whose path has neither")
    paths = watched()
    if top in [os.path.realpath(p) for p in paths]:
        print(f"{top} is already watched.")
        return 0
    write_watch(paths + [top])
    print(f"Watching {top}. The tick event looks at it with the other watched folders, once a day unless {CMD} extensions every github says otherwise.")
    print(f"To look now: {CMD} github check {top}")
    return 0


def cmd_unwatch(args):
    folder = folder_arg(args, "unwatch")
    top = clone_top(folder) or folder
    paths = watched()
    keep = [p for p in paths if os.path.realpath(p) != top and p != top and p != folder]
    # A clone that is no longer watched is no longer fixed either: fixing is on only for a watched one.
    stop_running(top)
    fixed = settings()["fix"]
    fix_keep = [p for p in fixed if os.path.realpath(p) != os.path.realpath(top) and p != folder]
    if len(fix_keep) != len(fixed):
        set_conf(CONFIG, "fix", ", ".join(fix_keep))
        print(f"Fixing is off for {top}.")
    if len(keep) == len(paths):
        print(f"{top} wasn't watched.")
        return 0
    write_watch(keep)
    print(f"No longer watching {top}.")
    return 0


