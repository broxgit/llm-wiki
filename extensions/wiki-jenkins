def load_state():
    return cc.load_state(STATE_FILE)


def record(job, key, entry):
    """Keep what a tick saw: under the state lock, on the file as it is now. False, and a line, when it can't be."""
    return cc.record_workflow(STATE_DIR, STATE_FILE, STATE_LOCK, job, key, entry)


def notice_id(folder, job, key):
    return "jk-" + cc.safe_part(job.replace("/", "__"))[:60] + "-" + hashlib.sha1(f"{folder}|{job}|{key}".encode("utf-8")).hexdigest()[:12]


def commit_subject(folder, sha):
    s = git(folder, "log", "-1", "--format=%s", sha) if re.fullmatch(r"[0-9a-fA-F]{7,64}", sha or "") else ""
    return clean(s, 200)


def put_notice(nid, folder, o, d):
    log = f" The build's log, cut down: {d['excerpt']}." if d["excerpt"] else ""
    where = f"{d['stage']}: " if d["stage"] else ""
    tail = f".{log} More: {CMD} jenkins check"
    head = f"CI failed on {cc.cap(o['branch'])}: " if o["branch"] else "CI failed: "
    text = cc.notice_text(head, f"{cc.cap(o['job'])} #{o['id']} ({o['conclusion']}) / {where}{d['signature']}", tail)
    return cc.put_notice(nid, folder, o["branch"] or "-", text)


def notify_desktop(o, d):
    cc.notify_desktop(f"CI failed: {o['job']}", f"{o['branch'] + ': ' if o['branch'] else ''}{o['workflow']} ({o['conclusion']}): {d['signature']}")


def save_note(folder, o, prev, flaky):
    job = o["job"]
    sha = o["sha"][:7]
    body = []
    if flaky:
        body += ["It failed, then passed on a re-run of the same commit, so nothing changed in between: it may be flaky.", ""]
    body += [f"Job: {job}", f"Branch: {prev.get('branch') or '-'}", f"Stage: {prev.get('stage') or 'not known'}", f"Result: {prev.get('conclusion', '')}",
             f"Signature: {prev['signature']}", "",
             f"Failed build: #{prev['run_id']} {prev.get('url', '')}".rstrip(),
             f"Passing build: #{o['id']} {o['url']}".rstrip()]
    if o["sha"]:
        body.append(f"Commit of the passing build: {sha} {commit_subject(folder, o['sha'])}".rstrip())
    return cc.save_note(folder, job, os.path.basename(folder.rstrip("/")) or "jenkins", "jenkins", f"{job} on {prev['branch']}" if prev.get("branch") else job, body, flaky)


def tick_folder(jk, folder, job, conf):
    """One watched folder and its job. Returns False when something should be tried again. A job that can't be read is
    for the caller, which goes on to the next folder."""
    DEADLINE[0] = time.time() + FOLDER_SECONDS
    try:
        try:
            _, _, builds = fetch(jk, folder, job)
        except NoJob:
            print(f"{folder}: Jenkins has no job {job}, so it was skipped.")
            return True
        repos = load_state().get("repos")
        book = repos.get(job, {}) if isinstance(repos, dict) else {}
        book = book.get("workflows", {}) if isinstance(book, dict) else {}
        ok = True
        for o in builds:
            budget()
            key = o["branch"] or "-"
            prev = book.get(key) if isinstance(book, dict) else None
            prev = prev if isinstance(prev, dict) else None
            was_failing = bool(prev) and prev.get("conclusion") in ("failure", "unstable")
            if failing(o):
                if was_failing and prev.get("run_id") == o["id"]:
                    continue
                d = failure_detail(jk, o)
                entry = {"workflow": o["workflow"], "branch": o["branch"], "run_id": o["id"], "conclusion": o["conclusion"], "sha": o["sha"],
                         "url": o["url"], "stage": d["stage"], "signature": d["signature"], "excerpt": d["excerpt"], "folder": folder}
                print(f"{job}: CI failed{' on ' + o['branch'] if o['branch'] else ''}: {o['workflow']} ({o['conclusion']}){' / ' + d['stage'] if d['stage'] else ''}: {d['signature']}")
                old = stale(o.get("created"))
                if not record(job, key, entry):
                    ok = False
                    continue
                if conf["notice"] and old:
                    print(f"{job}: that build is more than {NOTICE_DAYS} days old, so no notice was left.")
                elif conf["notice"]:
                    put_notice(notice_id(folder, job, key), folder, o, d)
                    if conf["desktop"]:
                        notify_desktop(o, d)
            elif passing(o):
                if was_failing:
                    clear_notice(notice_id(folder, job, key))
                    if conf["remember"] and not save_note(folder, o, prev, bool(o["sha"]) and o["sha"] == prev.get("sha")):
                        ok = False
                        continue
                    if not conf["remember"]:
                        print(f"{job}: {label(o)} passes again.")
                if not record(job, key, {"workflow": o["workflow"], "branch": o["branch"], "run_id": o["id"], "conclusion": "success",
                                         "sha": o["sha"], "url": o["url"], "folder": folder}):
                    ok = False
        return ok
    except OutOfTime:
        print(f"{job}: out of time ({FOLDER_SECONDS} seconds) for this job. The rest waits for the next tick.")
        return True
    finally:
        DEADLINE[0] = 0.0


def on_event(args):
    """Run by llm-wiki for an event. A job that can't be read is logged and skipped, and the others go on: the event ends
    75 only if every folder was out of reach."""
    global EVENT
    EVENT = True
    if args[:1] != ["tick"]:
        return 0
    conf = settings()
    if not conf["watch"]:
        print(f"No folder is watched, so nothing was checked. Run: {CMD} jenkins watch <folder> <job>")
        return 0
    jk = Jenkins(conf)
    begun = time.time()
    all_ok = True
    read = out_of_reach = 0
    for folder, job in conf["watch"]:
        if not os.path.isdir(folder):
            print(f"{folder} is gone, so it was skipped.")
            continue
        if job_problem(job):
            print(f"{folder}: the job {clean(job, 60)!r} isn't a job path, so it was skipped. Do: {CMD} jenkins watch {folder} <job>")
            continue
        if time.time() - begun > 240:
            print(f"Out of time before {folder}. The rest wait for the next tick.")
            break
        try:
            all_ok = tick_folder(jk, folder, job, conf) and all_ok
            read += 1
        except SystemExit as e:
            if e.code not in (1, 75):
                raise
            out_of_reach += 1
            print(f"{folder}: Jenkins couldn't be read for {job} just now, so it was skipped. The rest go on.")
    if out_of_reach and not read:
        return 75
    return 0 if all_ok else 1


