def has_token(conf):
    """Whether a token is set to come from somewhere. The command isn't run to find out."""
    return bool(conf.get("token_cmd")) or bool(os.environ.get(TOKEN_ENV))


def get_token(conf):
    """The API token. Never printed, and never put in a message."""
    if os.environ.get(TOKEN_ENV):
        return os.environ[TOKEN_ENV].strip()
    if conf.get("token_cmd"):
        try:
            out = subprocess.run(conf["token_cmd"], shell=True, capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            die(f"token_cmd took more than 30 seconds. Do: run the command in {CONFIG} yourself to see why")
        if out.returncode != 0 or not out.stdout.strip():
            die(f"token_cmd printed no token (exit {out.returncode}). Do: run the command in {CONFIG} yourself to see why")
        return out.stdout.strip()
    return ""


def url_problem(url):
    """Why an address can't be Jenkins', in words that don't repeat it, or nothing: https:// anywhere, http:// only on this
    machine; a host; no login, query or fragment; no space or control character. It is read by a parser, not by how the
    string ends. A token sent over plain http to another host would cross the network in the clear."""
    if not url or unfit(url) or any(c.isspace() or c == "\\" for c in url):
        return "has a space, a backslash or a control character in it, or is empty"
    try:
        u = urllib.parse.urlsplit(url)
        host = u.hostname or ""
        u.port  # noqa: B018 (a bad port raises here)
    except ValueError:
        return "isn't an address"
    if u.scheme not in ("http", "https") or not host:
        return "isn't an address: it starts with https:// and names a host"
    if "@" in u.netloc or u.username is not None or u.password is not None:
        return "has a login in it, which is never sent"
    if u.query or u.fragment or "?" in url or "#" in url:
        return "has a query or a # in it: give only the address of Jenkins"
    if u.scheme == "http" and host.lower() not in ("localhost", "127.0.0.1", "::1"):
        return "is plain http:// to another machine, where the token would cross the network in the clear: use https://"
    return ""


def sign_in_missing(conf):
    """What the sign-in lacks, in a few words, or nothing."""
    if not conf["url"]:
        return "no Jenkins address yet"
    if not conf["user"]:
        return "no Jenkins user yet"
    if not has_token(conf):
        return "no API token yet"
    return ""


def need_sign_in(conf):
    msg = sign_in_missing(conf)
    if msg:
        if EVENT:
            not_now(f"Jenkins isn't set up: {msg}")
        die(f"Jenkins isn't set up: {msg}. Run: {CMD} extensions setup jenkins. {GUIDE}")
    why = url_problem(conf["url"])
    if why:
        where = "JENKINS_URL" if conf["_from"].get("url") == "JENKINS_URL" else f"url in {CONFIG}"
        if EVENT:
            not_now(f"{where} {why}")
        die(f"{where} {why}. Do: fix it, in a terminal: {CMD} extensions setup jenkins")


def origin(url):
    u = urllib.parse.urlsplit(url)
    port = u.port or (443 if u.scheme == "https" else 80)
    return (u.scheme, (u.hostname or "").lower(), port)


class SameOrigin(urllib.request.HTTPRedirectHandler):
    """A redirect is followed only to the same address it came from: the sign-in is never sent anywhere else."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        try:
            if origin(urllib.parse.urljoin(req.full_url, newurl)) != origin(req.full_url):
                return None
        except ValueError:
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


class Jenkins:
    def __init__(self, conf):
        need_sign_in(conf)
        self.url = conf["url"]
        self.user = conf["user"]
        tok = get_token(conf)
        if not tok:
            die(f"no API token. Set token_cmd in {CONFIG}, or {TOKEN_ENV}. {CMD} jenkins --help has the settings.")
        if ":" in self.user or unfit(self.user):
            die(f"the Jenkins user can't hold a colon or a control character. Do: set it again, in a terminal: {CMD} extensions setup jenkins")
        self.headers = {"Authorization": "Basic " + base64.b64encode(f"{self.user}:{tok}".encode()).decode(), "Accept": "application/json"}
        self.opener = urllib.request.build_opener(SameOrigin())

    def open(self, path, headers=None):
        """The open response to one GET of an address under the Jenkins address, or the code Jenkins refused it with."""
        h = dict(self.headers)
        h.update(headers or {})
        req = urllib.request.Request(self.url + path, headers=h, method="GET")
        return self.opener.open(req, timeout=TIMEOUT)

    def fail(self, e, path):
        """What an HTTP error means: sign-in refused, a redirect that wasn't followed, or a server trouble."""
        if e.code in (401, 403):
            if EVENT:
                not_now(f"Jenkins refused the sign-in ({e.code})")
            die(f"Jenkins refused the sign-in ({e.code}) at {self.url}. Do: check the user and the token: {CMD} jenkins config")
        if 300 <= e.code < 400:
            die(f"{self.url} redirected to another address, which wasn't followed, so the sign-in stays with {self.url}. "
                f"Do: set url to the address Jenkins really answers at, in a terminal: {CMD} extensions setup jenkins")
        unreachable(f"Jenkins answered {e.code}")

    def get_json(self, path, soft=False):
        """The JSON at path, or None where Jenkins says there is no such thing (and, when soft, for any refusal)."""
        body = bytearray()
        try:
            with self.open(path) as r:
                deadline = time.time() + STREAM_SECONDS
                while len(body) <= JSON_BYTES:
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    body += chunk
                    if time.time() > deadline:
                        unreachable(f"Jenkins took more than {STREAM_SECONDS} seconds to answer for {clean(path, 80)}")
        except urllib.error.HTTPError as e:
            if e.code == 404 or (soft and e.code not in (401, 403) and not 300 <= e.code < 400):
                return None
            self.fail(e, path)
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            unreachable(f"can't reach {self.url}: {clean(str(getattr(e, 'reason', e)), 120)}")
        if len(body) > JSON_BYTES:
            unreachable(f"Jenkins answered with more than {JSON_BYTES // 1024 // 1024} MB for {clean(path, 80)}")
        try:
            return json.loads(body.decode("utf-8", "replace"))
        except (ValueError, RecursionError):
            if soft:
                return None
            die(f"{self.url} didn't answer with JSON. Do: check that url is the address of Jenkins itself")

    def get_tail(self, path):
        """The last TAIL_BYTES of a text, or None where there is none. It asks for only that much with a Range header,
        and a server that sends the whole is read as a stream that keeps only the end, so a console of any size is
        never held. A server that sent the end has no first line to trust."""
        try:
            r = self.open(path, {"Range": f"bytes=-{TAIL_BYTES}", "Accept": "text/plain"})
        except urllib.error.HTTPError as e:
            if e.code == 416:
                return b""
            if e.code in (401, 403) or 300 <= e.code < 400:
                self.fail(e, path)
            return None
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            unreachable(f"can't reach {self.url}: {clean(str(getattr(e, 'reason', e)), 120)}")
        buf = bytearray()
        cut = False
        if getattr(r, "status", 200) == 206:
            # A range that starts at byte 0 is the whole log, with a first line to trust.
            m = re.match(r"^\s*bytes\s+(\d+)-", r.headers.get("Content-Range") or "")
            cut = not (m and int(m.group(1)) == 0)
        total = 0
        deadline = time.time() + STREAM_SECONDS
        try:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                total += len(chunk)
                buf += chunk
                if len(buf) > TAIL_BYTES:
                    del buf[:len(buf) - TAIL_BYTES]
                    cut = True
                if total > STREAM_BYTES or time.time() > deadline:
                    return None
        except (TimeoutError, OSError):
            return None
        finally:
            r.close()
        out = bytes(buf)
        if cut and b"\n" in out:
            out = out.split(b"\n", 1)[1]
        return out


# ---- which job, and its address ----------------------------------------------------------------

PART_CHARS = " ._-"


ESCAPE = re.compile(r"%([0-9A-Fa-f]{2})")


def part_ok(p):
    """One part of a job's path: letters, digits, space and ._-, and %XX where a job's own name holds one, as the name of a
    project in a GitLab or GitHub organization folder does (group%2Fapp). An escape has to stand for a printing character
    other than %, and the part with its escapes read can't be . or hold a .., so no reading of it climbs out of the job."""
    if not p or p != p.strip() or p in (".", ".."):
        return False
    for m in ESCAPE.finditer(p):
        c = int(m.group(1), 16)
        if c < 0x20 or c > 0x7e or c == 0x25:
            return False
    plain = ESCAPE.sub("", p)
    if not all(c.isalnum() or c in PART_CHARS for c in plain):
        return False
    read = urllib.parse.unquote(p)
    return ".." not in read and read.strip() not in ("", ".")


def job_problem(job):
    """Why a job's path as Jenkins shows it can't be one, or nothing: parts joined by /, each one part_ok, none empty or
    starting or ending with a space, no .. anywhere."""
    if not job or len(job) > 300:
        return "is empty or too long"
    if ".." in job:
        return "has a .. in it"
    parts = job.split("/")
    if len(parts) > 8:
        return "has more than 8 parts"
    for p in parts:
        if not part_ok(p):
            return "isn't a job path: each part is letters, digits, spaces and . _ - only, and parts are joined by /"
    return ""


def job_from(text, conf):
    """The job's path from what a person gave: a path such as team/app, or the job's address on the configured Jenkins."""
    text = text.strip()
    if "://" in text:
        base = conf["url"]
        if not base or not text.startswith(base + "/job/"):
            die_usage(f"that address isn't a job on {base or 'your Jenkins (no url is set)'}. Give the job's path, such as team/app")
        segs = urllib.parse.urlsplit(text).path.split("/")
        basesegs = urllib.parse.urlsplit(base).path.rstrip("/").split("/") if urllib.parse.urlsplit(base).path.strip("/") else []
        rest = [s for s in segs[len(basesegs):] if s != ""]
        if len(rest) < 2 or len(rest) % 2 or any(rest[i] != "job" for i in range(0, len(rest), 2)):
            die_usage("that address isn't a job's own address (/job/<name>/job/<name>/). Give the job's path, such as team/app")
        text = "/".join(urllib.parse.unquote(rest[i]) for i in range(1, len(rest), 2))
    why = job_problem(text)
    if why:
        die_usage(f"{clean(text, 60)!r} {why}")
    return text


def job_base(job):
    """/job/<part>/job/<part>, each part percent-encoded."""
    return "".join("/job/" + urllib.parse.quote(p, safe="") for p in job.split("/"))


def branch_part(branch):
    """A branch as Jenkins names its job in a multibranch project: the name has / and other characters percent-encoded (feature/x
    is the job feature%2Fx), and that name is encoded again in the address, so a % becomes %25. A name that is . or .. is
    no part of an address."""
    if branch in (".", "..") or ".." in branch:
        raise ValueError("not a branch name")
    return urllib.parse.quote(urllib.parse.quote(branch, safe=""), safe="")


BRANCH_OK = re.compile(r"^[A-Za-z0-9._/-]+$")


def branch_ok(b):
    """A branch name that can go into an address and be passed as an argument: no .., no leading -."""
    return isinstance(b, str) and bool(b) and bool(BRANCH_OK.match(b)) and ".." not in b and not b.startswith("-") and b != "."


def git(folder, *args):
    return cc.git(folder, *args)


def default_branch(folder):
    ref = git(folder, "symbolic-ref", "refs/remotes/origin/HEAD")
    if ref.startswith("refs/remotes/origin/"):
        b = ref[len("refs/remotes/origin/"):]
        if branch_ok(b):
            return b
    for b in ("main", "master"):
        if git(folder, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{b}") or git(folder, "rev-parse", "--verify", "-q", f"refs/heads/{b}"):
            return b
    return ""


# ---- the watch list: folder=job ------------------------------------------------------------------

def watch_entries(conf=None):
    """[(folder, job)] in the watch setting, as written."""
    conf = conf if conf is not None else read_conf(CONFIG)
    out = []
    for raw in conf.get("watch", "").split(","):
        if "=" not in raw:
            continue
        folder, job = raw.rsplit("=", 1)
        folder, job = os.path.expanduser(folder.strip()), job.strip()
        if folder and job:
            out.append((folder, job))
    return out


def write_watch(entries):
    set_conf(CONFIG, "watch", ", ".join(f"{f}={j}" for f, j in entries))


# ---- a job worked out from the clone's remote ------------------------------------------------------

PLACEHOLDERS = ("{path}", "{folders}", "{name}")
REMOTE_PART = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$")
REMOTE_TEXT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")


def pattern_problem(pat):
    """Why a job_pattern can't be one, or nothing: a job path with at least one of {path}, {folders} and {name} in it."""
    if not any(p in pat for p in PLACEHOLDERS):
        return "has none of {path}, {folders} and {name} in it, so it would name the same job for every clone"
    plain = pat
    for p in PLACEHOLDERS:
        plain = plain.replace(p, "a")
    if "{" in plain or "}" in plain:
        return "has a { or } that isn't {path}, {folders} or {name}"
    if re.search(r"%[0-9A-Fa-f]?\{", pat):
        return "has a % right before a placeholder, which would make an escape out of the clone's name"
    return job_problem(plain)


def remote_of(folder):
    """(host, [parts of the path]) of a clone's origin, lower-case host, or nothing when it has none or one that isn't
    plainly host and path: https://host/a/b.git, ssh://git@host/a/b.git or git@host:a/b.git. Each part is letters,
    digits and ._- only, so nothing in a remote can put a slash, a % or a .. into a job's name."""
    url = git(folder, "config", "--get", "remote.origin.url")
    if not url or len(url) > 500:
        return None
    m = re.match(r"^(?:https?|ssh|git)://(?:[^@/]*@)?([^/:]+)(?::\d+)?/(.+)$", url) or re.match(r"^(?:[^@/]+@)?([^/:]+):(?!/)(.+)$", url)
    if not m:
        return None
    host, path = m.group(1).lower(), m.group(2)
    if path.endswith(".git"):
        path = path[:-4]
    parts = path.strip("/").split("/")
    if not REMOTE_PART.match(host) or not parts or len(parts) > 8 or any(not REMOTE_PART.match(p) or ".." in p for p in parts):
        return None
    return host, parts


def derived_job(folder, conf):
    """The job job_pattern names for a clone, or nothing: the clone has a Jenkinsfile at its top, its remote is one
    job_remote allows, and what comes out is a job path."""
    pat = conf["job_pattern"]
    top = clone_top(folder)
    if not pat or pattern_problem(pat) or not top or not os.path.isfile(os.path.join(top, "Jenkinsfile")):
        return ""
    rem = remote_of(top)
    if not rem:
        return ""
    host, parts = rem
    want = conf["job_remote"].lower().strip("/")
    if want and not (host + "/" + "/".join(parts) + "/").lower().startswith(want + "/"):
        return ""
    job = pat.replace("{path}", "%2F".join(parts)).replace("{folders}", "/".join(parts)).replace("{name}", parts[-1])
    return "" if job_problem(job) else job


def pattern_from(folder, job):
    """The job_pattern a job watched by hand suggests, or nothing: its last part is the remote's path with %2F, or it
    ends with the remote's path as folders."""
    rem = remote_of(folder)
    if not rem or len(rem[1]) < 2:
        return ""
    parts = rem[1]
    segs = job.split("/")
    if segs[-1] == "%2F".join(parts):
        return "/".join(segs[:-1] + ["{path}"])
    if segs[-len(parts):] == parts:
        return "/".join(segs[:-len(parts)] + ["{folders}"])
    return ""


def skipped(top, conf):
    """Whether unwatch took this clone off for good. A work tree of that clone counts as it."""
    if top in [os.path.realpath(p) for p in conf["job_skip"]]:
        return True
    mine = cc.common_dir(top)
    return bool(mine) and any(cc.common_dir(p) == mine for p in conf["job_skip"])


def unskip(top, conf):
    if skipped(top, conf):
        mine = cc.common_dir(top)
        set_conf(CONFIG, "job_skip", ", ".join(p for p in conf["job_skip"] if os.path.realpath(p) != top and not (mine and cc.common_dir(p) == mine)))


def path_fits_file(top):
    """A path the settings file can hold in a list: no comma, =, # or control character."""
    return not any(c in top for c in ",#=") and not unfit(top)


def int_or_none(v):
    return v if isinstance(v, int) and not isinstance(v, bool) else None


# ---- builds ---------------------------------------------------------------------------------------

class NoJob(Exception):
    pass


class OutOfTime(Exception):
    """One job has used the time a tick gives it."""


DEADLINE = [0.0]


def budget():
    if DEADLINE[0] and time.time() > DEADLINE[0]:
        raise OutOfTime()


def iso_from_ms(ms):
    n = int_or_none(ms)
    if n is None or n <= 0:
        return ""
    try:
        return datetime.datetime.fromtimestamp(n / 1000.0, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (OverflowError, OSError, ValueError):
        return ""


def build_of(jk, b, job, path, branch):
    """One build as the rest of this reads it, or None. The address shown is made here, from the Jenkins address that was
    set and the build's number: nothing Jenkins said picks it."""
    if not isinstance(b, dict):
        return None
    n = int_or_none(b.get("number"))
    if n is None or n < 0:
        return None
    result = b.get("result") if isinstance(b.get("result"), str) else ""
    status = "RUNNING" if b.get("building") or not result else clean(result, 20).upper()
    sha, cause = "", ""
    actions = b.get("actions")
    for a in actions if isinstance(actions, list) else []:
        if not isinstance(a, dict):
            continue
        rev = a.get("lastBuiltRevision")
        if not sha and isinstance(rev, dict) and isinstance(rev.get("SHA1"), str) and re.fullmatch(r"[0-9a-fA-F]{7,64}", rev["SHA1"]):
            sha = rev["SHA1"]
        causes = a.get("causes")
        if not cause and isinstance(causes, list) and causes and isinstance(causes[0], dict):
            cause = clean(causes[0].get("shortDescription") or "", 120)
    return {"id": n, "job": job, "branch": branch, "path": f"{path}/{n}", "status": status, "conclusion": status.lower(),
            "sha": sha, "cause": cause, "url": f"{jk.url}{path}/{n}/", "title": clean(b.get("displayName") or "", 100),
            "created": iso_from_ms(b.get("timestamp")), "workflow": f"{job} #{n}", "pr": None}


def tree(inner):
    return "?tree=" + urllib.parse.quote(inner, safe="[],")


def fetch(jk, folder, job):
    """(whether it is a multibranch job, [branch names looked at], [the newest build of the job, or of its job for each branch])."""
    path = job_base(job)
    budget()
    d = jk.get_json(f"{path}/api/json" + tree(f"_class,jobs[name],lastBuild[{BUILD_TREE}]"))
    if not isinstance(d, dict):
        raise NoJob()
    multi = "WorkflowMultiBranchProject" in str(d.get("_class", "")) or bool(d.get("jobs"))
    if not multi:
        b = build_of(jk, d.get("lastBuild"), job, path, "")
        return False, [], [b] if b else []
    branches = []
    for b in (clean(git(folder, "branch", "--show-current"), 250), default_branch(folder)):
        if branch_ok(b) and b not in branches:
            branches.append(b)
    builds = []
    for br in branches:
        budget()
        child = f"{path}/job/{branch_part(br)}"
        c = jk.get_json(f"{child}/api/json" + tree(f"lastBuild[{BUILD_TREE}]"), soft=True)
        b = build_of(jk, c.get("lastBuild"), job, child, br) if isinstance(c, dict) else None
        if b:
            builds.append(b)
    return True, branches, builds


def failing(o):
    return o["status"] in FAILING


def passing(o):
    return o["status"] in PASSING


# ---- the failing build, its log, its signature -------------------------------------------------------

# A console note: Jenkins hides a machine-readable annotation in the log between two escape codes. It is found with
# str.find, never a pattern that can backtrack: a log full of notes that never end would take a pattern for ever.
NOTE_START = "\x1b[8mha:"
NOTE_END = "\x1b[0m"


def strip_notes(text):
    """The text with its console notes taken out, in one pass. A note that has no end within NOTE_WINDOW characters is
    dropped to the end of its line, and no further."""
    out, pos, n = [], 0, len(text)
    while pos < n:
        i = text.find(NOTE_START, pos)
        if i < 0:
            out.append(text[pos:])
            break
        out.append(text[pos:i])
        start = i + len(NOTE_START)
        e = text.find(NOTE_END, start, min(n, start + NOTE_WINDOW))
        nl = text.find("\n", start, e) if e >= 0 else -1
        if e >= 0 and nl < 0:
            pos = e + len(NOTE_END)
        else:
            nl = text.find("\n", start)
            pos = n if nl < 0 else nl
    return "".join(out)


JGENERIC = re.compile(r"^(?:ERROR: script returned exit code -?\d+|Finished: (?:FAILURE|UNSTABLE|ABORTED)|Build step '.*' marked build as failure|"
                      r"ERROR: Build step failed.*|Build was aborted|ERROR: Failed to parse.*)\.?$")


def failing_stage(jk, o):
    """The name of the first stage Pipeline's API says failed, or nothing: the API is optional, and a job with no stages has none."""
    d = jk.get_json(f"{o['path']}/wfapi/describe", soft=True)
    stages = d.get("stages") if isinstance(d, dict) else None
    for s in stages if isinstance(stages, list) else []:
        if isinstance(s, dict) and str(s.get("status", "")).upper() in ("FAILED", "UNSTABLE", "FAILURE"):
            return clean(s.get("name") or "", 100)
    return ""


def failure_detail(jk, o):
    """Why a build failed: the stage when Jenkins says, the signature of the error and the saved excerpt. Reads Jenkins only."""
    stage = failing_stage(jk, o)
    raw = jk.get_tail(f"{o['path']}/consoleText")
    lines = cc.excerpt_lines(cc.log_lines(raw, strip_notes)) if raw else []
    key = hashlib.sha1((o["job"] + "|" + o["branch"]).encode("utf-8")).hexdigest()[:8]
    path = cc.save_excerpt(STATE_DIR, LOG_DIR, o["job"].replace("/", "__"), f"{int(o['id'])}-{key}.txt", lines) if lines else ""
    return {"stage": stage, "signature": signature_of(lines, o["workflow"], "build", JGENERIC), "excerpt": path}


def label(o):
    return f"{o['workflow']}" + (f" on {o['branch']}" if o["branch"] else "")


# ---- check ---------------------------------------------------------------------------------------

def clone_top(folder):
    return cc.clone_top(folder)


def jobs_for(folder, conf):
    top = clone_top(folder) or os.path.realpath(folder)
    jobs = [j for f, j in conf["watch"] if os.path.realpath(f) == top]
    if not jobs:
        d = derived_job(folder, conf)
        jobs = [d] if d else []
    return jobs


def cmd_check(args):
    if any(a.startswith("-") for a in args) or len(args) > 2:
        die_usage(f"check takes a folder and a job at most, and no option. Run: {CMD} jenkins --help")
    conf = settings()
    folder = os.path.abspath(os.path.expanduser(args[0])) if args else os.getcwd()
    if not os.path.isdir(folder):
        die_usage(f"{args[0] if args else folder} isn't a command or a folder. Run: {CMD} jenkins --help")
    if len(args) == 2:
        jobs = [job_from(args[1], conf)]
    else:
        jobs = jobs_for(folder, conf)
        for j in jobs:
            if job_problem(j):
                die(f"the job {clean(j, 60)!r} in {CONFIG} isn't a job path. Do: say which job builds it again: {CMD} jenkins watch {folder} <job>")
        if not jobs:
            die(f"no Jenkins job is watched for {folder}, and Jenkins doesn't say which job builds a clone. "
                f"Do: say which: {CMD} jenkins watch {folder} <job>, or look once: {CMD} jenkins check {folder} <job>")
    jk = Jenkins(conf)
    for job in jobs:
        try:
            multi, branches, builds = fetch(jk, folder, job)
        except NoJob:
            die(f"Jenkins has no job {job} at {jk.url}. Do: check the path, as Jenkins shows it: {CMD} jenkins watch {folder} <job>")
        print(f"== {job}  (Jenkins" + (f"; multibranch, looked at: {', '.join(branches) or 'no branch'}" if multi else "") + ")")
        bad = [o for o in builds if failing(o)]
        running = [o for o in builds if o["status"] == "RUNNING"]
        for o in bad:
            d = failure_detail(jk, o)
            where = known_in_wikis(d["signature"])
            print(f"FAILING  build #{o['id']} of {job}" + (f" on {o['branch']}" if o["branch"] else "") + f" ({o['conclusion']})")
            print(f"  build:   {o['url']}")
            print(f"  stage:   {d['stage'] or 'not known'}")
            if o["cause"]:
                print(f"  cause:   {o['cause']}")
            print(f"  error:   {d['signature']}")
            if where is None:
                print("  known:   not looked up (no wiki command to ask)")
            elif where:
                print(f"  known:   yes, in {where}")
            else:
                print("  known:   no wiki or note holds it yet")
            print(f"  log:     {d['excerpt'] or 'none kept: Jenkins has no log for this build'}")
        if not bad:
            print(f"Nothing is failing in CI for {job}." if builds else f"No builds were found for {job}" + (" on those branches." if branches else "."))
        if running:
            print("Still running: " + "; ".join(label(o) for o in running) + ".")
    return 0


# ---- watch ---------------------------------------------------------------------------------------

def cmd_watch(args):
    if args == ["--list"]:
        entries = settings()["watch"]
        if not entries:
            print(f"No folders are watched. Run: {CMD} jenkins watch <folder> <job>")
        for f, j in entries:
            print(f"{f}  {j}" + ("" if os.path.isdir(f) else "  (gone)"))
        return 0
    if len(args) not in (1, 2) or any(a.startswith("-") for a in args):
        die_usage(f"watch takes a clone and the Jenkins job that builds it, such as {CMD} jenkins watch ~/dev/app team/app. Run: {CMD} jenkins --help")
    conf = settings()
    folder = os.path.abspath(os.path.expanduser(args[0]))
    if not os.path.isdir(folder):
        die_usage(f"{args[0]} isn't a folder. Do: name a clone")
    top = clone_top(folder)
    if not top:
        die(f"{folder} isn't in a git clone. Do: run this in a clone, or name one")
    if len(args) == 2:
        job = job_from(args[1], conf)
    else:
        job = derived_job(top, conf)
        if not job:
            if not conf["job_pattern"]:
                die_usage(f"watch takes a clone and the Jenkins job that builds it, such as {CMD} jenkins watch ~/dev/app team/app. Run: {CMD} jenkins --help")
            if pattern_problem(conf["job_pattern"]):
                die(f"job_pattern in {CONFIG} {pattern_problem(conf['job_pattern'])}. Do: set it again, such as: {CMD} extensions set jenkins job_pattern 'Platform/{{path}}'")
            die(f"job_pattern ({conf['job_pattern']}) names no job for {top}: it needs a Jenkinsfile at its top and a remote"
                + (f" under {conf['job_remote']}" if conf["job_remote"] else "") + f". Do: name the job: {CMD} jenkins watch {top} <job>")
    if "," in top or "#" in top or "=" in top:
        die(f"{top} has a comma, a = or a # in its path, which the settings file can't hold. Do: watch a clone whose path has none")
    entries = conf["watch"]
    if (top, job) in [(os.path.realpath(f), j) for f, j in entries]:
        unskip(top, conf)
        print(f"{top} is already watched, for {job}.")
        return 0
    write_watch(entries + [(top, job)])
    unskip(top, conf)
    print(f"Watching {top} for the Jenkins job {job}. The tick event looks at it with the other watched folders, once a day unless {CMD} extensions every jenkins says otherwise.")
    print(f"To look now: {CMD} jenkins check {top}")
    hint = "" if conf["job_pattern"] else pattern_from(top, job)
    if hint:
        print(f"This job is named after the clone's remote. If your other jobs are too, say so once and none needs naming: "
              f"{CMD} extensions set jenkins job_pattern '{hint}'. With {CMD} extensions set jenkins job_auto yes as well, "
              f"such a clone is watched when a session starts in it.")
    return 0


def cmd_unwatch(args):
    if not args or len(args) > 2 or any(a.startswith("-") for a in args):
        die_usage(f"unwatch takes a clone, and a job if it has more than one. Run: {CMD} jenkins --help")
    folder = os.path.abspath(os.path.expanduser(args[0]))
    if not os.path.isdir(folder):
        die_usage(f"{args[0]} isn't a folder. Do: name the clone")
    top = clone_top(folder) or os.path.realpath(folder)
    entries = settings()["watch"]
    job = args[1].strip() if len(args) == 2 else None
    keep = [(f, j) for f, j in entries if not (os.path.realpath(f) == top and (job is None or j == job))]
    if len(keep) == len(entries):
        print(f"{top} wasn't watched.")
        return 0
    write_watch(keep)
    conf = settings()
    gone = not any(os.path.realpath(f) == top for f, _ in keep)
    if gone and conf["job_auto"] and derived_job(top, conf) and not skipped(top, conf) and path_fits_file(top):
        set_conf(CONFIG, "job_skip", ", ".join(conf["job_skip"] + [top]))
        print(f"No longer watching {top}, and job_auto won't watch it again. {CMD} jenkins watch {top} undoes that.")
        return 0
    print(f"No longer watching {top}.")
    return 0


def wiki_watches(args):
    """--wiki-watches <folder>: 0 when the clone is watched, 1 when it isn't. With job_auto on, a clone job_pattern
    fits is added to the watch list here, so that a session starting in it is enough. It reads the settings file and
    asks git; nothing goes to Jenkins."""
    conf = settings()
    code = cc.watches([f for f, _ in conf["watch"]], args)
    if code != 1 or not conf["job_auto"]:
        return code
    top = clone_top(args[0])
    job = derived_job(top, conf) if top else ""
    if not job or skipped(top, conf) or not path_fits_file(top):
        return 1
    write_watch(conf["watch"] + [(top, job)])
    return 0


def signed_in_as(who):
    """The user name Jenkins says is signed in, or nothing: only an answer that says authenticated is true, with a name."""
    if isinstance(who, dict) and who.get("authenticated") is True and isinstance(who.get("name"), str) and who["name"].strip():
        return clean(who["name"], 60)
    return ""


def cmd_config(args):
    if args:
        die_usage("config takes no arguments")
    conf = settings()
    src = conf["_from"]
    print(f"file      {CONFIG}{'' if os.path.isfile(CONFIG) else ' (not there yet)'}")
    print(f"url       {conf['url'] or 'not set'}" + (f"  (from {src['url']})" if conf["url"] and src["url"] != "this file" else ""))
    print(f"user      {conf['user'] or 'not set'}" + (f"  (from {src['user']})" if conf["user"] and src["user"] != "this file" else ""))
    print(f"token     {'set' if has_token(conf) else 'not set'}" + (f"  (from {TOKEN_ENV})" if os.environ.get(TOKEN_ENV) else ("  (from token_cmd)" if conf["token_cmd"] else "")))
    print(f"watch     {', '.join(f'{f}={j}' for f, j in conf['watch']) or 'none'}")
    if conf["job_pattern"]:
        print(f"pattern   {conf['job_pattern']}" + (f", for remotes under {conf['job_remote']}" if conf["job_remote"] else "")
              + (", watched as sessions start (job_auto)" if conf["job_auto"] else ""))
    print(f"remember  {'yes' if conf['remember'] else 'no'}")
    print(f"notice    {'yes' if conf['notice'] else 'no'}")
    print(f"desktop   {'yes' if conf['desktop'] else 'no'}")
    print(f"state     {STATE_DIR}")
    msg = sign_in_missing(conf)
    if msg:
        print(f"\nNot set up: {msg}. Run: {CMD} extensions setup jenkins. {GUIDE}")
        return 1
    jk = Jenkins(conf)
    who = jk.get_json("/whoAmI/api/json" + tree("name,authenticated"), soft=True)
    name = signed_in_as(who)
    if not name:
        print(f"signed in no\n\nThis address doesn't answer as Jenkins, or Jenkins sees no signed-in user. Do: check that url is the address of Jenkins itself, and the user and the token: {CMD} extensions setup jenkins")
        return 1
    print(f"signed in as {name}")
    return 0


