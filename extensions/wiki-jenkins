def read_line():
    """One line from standard input, a byte at a time, so nothing meant for whoever
    reads next is taken. None when the input has ended."""
    buf = b""
    while True:
        c = os.read(0, 1)
        if not c:
            return buf.decode(errors="replace") if buf else None
        if c == b"\n":
            return buf.decode(errors="replace")
        buf += c


def ask(prompt, default=""):
    """Enter keeps the value in brackets, and - clears it."""
    sys.stdout.write(f"{prompt} [{default or 'none'}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    line = line.strip()
    return default if line == "" else ("" if line == "-" else line)


def ask_yn(prompt, default=False):
    sys.stdout.write(f"{prompt} [{'Y/n' if default else 'y/N'}]: ")
    sys.stdout.flush()
    line = read_line()
    if line is None:
        print()
        return default
    line = line.strip().lower()
    return default if line == "" else line.startswith("y")


def on_mac():
    """Whether the keychain preset fits this machine. LLM_WIKI_TEST_OS lets the tests see both answers."""
    return (os.environ.get("LLM_WIKI_TEST_OS") or sys.platform) == "darwin"


def setup():
    """Run by `wiki setup` and `wiki extensions setup jenkins`, at a terminal."""
    print("Jenkins, for your wikis")
    print("When a build fails, it can tell you which job and build, the stage when Jenkins says which, and the")
    print("first line that looks like the error, and keep a short excerpt of the end of the log on this machine.")
    print("It reads Jenkins only: it never starts, aborts or rebuilds anything, never pushes, and starts no agent.")
    print()
    print("Enter keeps the answer in brackets, and a dash, -, clears it. You can run this again at any time:")
    print(f"  {CMD} extensions setup jenkins")
    print()
    print("== Step 1 of 3: sign in")
    conf = settings()
    url = ask("Your Jenkins, such as https://ci.example.com", conf["url"])
    why = url_problem(url) if url else ""
    if why:
        print(f"  {url if len(url) < 80 else url[:80]} {why}, so it wasn't saved.")
    else:
        set_conf(CONFIG, "url", url.rstrip("/"))
    user = ask("Your Jenkins user name", conf["user"])
    if user and (":" in user or unfit(user) or "#" in user):
        print("  A user name can't hold a colon, a # or a control character, so it wasn't saved.")
    else:
        set_conf(CONFIG, "user", user)
    conf = settings()
    if not has_token(conf):
        print()
        print("The API token is kept out of this file. In Jenkins, open your user, then Configure, then API Token,")
        print("and add one. Copy it.")
        if on_mac():
            print("Then put it in your keychain from the clipboard. In another terminal, run:")
            print('  security add-generic-password -a "$USER" -s jenkins -U -w "$(pbpaste)"')
            sys.stdout.write("Press Enter when that is done, or type skip to do it later: ")
            sys.stdout.flush()
            answer = read_line()
            if answer is None:
                print()
            if answer is not None and answer.strip().lower() != "skip":
                set_conf(CONFIG, "token_cmd", KEYCHAIN_CMD)
        else:
            cmd = ask("A command that prints the token, such as: pass show jenkins", "")
            if "#" in cmd or unfit(cmd):
                print("  A command can't hold a # or a control character, so it wasn't saved.")
            else:
                set_conf(CONFIG, "token_cmd", cmd)
    conf = settings()
    miss = sign_in_missing(conf)
    if miss:
        print(f"  Jenkins can't sign in yet: {miss}.")
    else:
        try:
            who = Jenkins(conf).get_json("/whoAmI/api/json" + tree("name,authenticated"), soft=True)
            if signed_in_as(who):
                print(f"  Signed in to Jenkins as {signed_in_as(who)}.")
            else:
                print(f"  {conf['url']} doesn't answer as Jenkins, or sees no signed-in user. Run {CMD} jenkins config to see.")
        except SystemExit:
            print("  The sign-in didn't work. The line above says why.")
    print()
    print("== Step 2 of 3: which job builds which clone")
    print("Jenkins doesn't know which repository a job builds, so you say. A watched clone and its job are")
    print("looked at in the background, by the tick event, once a day: a build that starts failing leaves one")
    print("line for the next session in that clone.")
    cwd = clone_top(os.getcwd())
    entries = conf["watch"]
    found = derived_job(cwd, conf) if cwd else ""
    if found and cwd not in [os.path.realpath(f) for f, _ in entries] and path_fits_file(cwd):
        if ask_yn(f"job_pattern names {found} for {cwd}. Watch it?", True):
            write_watch(entries + [(cwd, found)])
    elif cwd and cwd not in [os.path.realpath(f) for f, _ in entries] and not any(c in cwd for c in ",#="):
        job = ask(f"The Jenkins job that builds {cwd}: its path, such as team/app, or its address in your browser. Enter for none", "")
        if job:
            if job_problem(job) and "://" not in job:
                print(f"  {clean(job, 60)!r} isn't a job path, so it wasn't saved.")
            else:
                try:
                    named = job_from(job, conf)
                    write_watch(entries + [(cwd, named)])
                    hint = "" if conf["job_pattern"] else pattern_from(cwd, named)
                    if hint:
                        print(f"  That job is named after the clone's remote: {hint}")
                        if ask_yn("  Are your other jobs named the same way, so that none of them needs naming?", True):
                            set_conf(CONFIG, "job_pattern", hint)
                            if ask_yn("  Watch a clone like this when a session starts in it, without asking each time?", False):
                                set_conf(CONFIG, "job_auto", "yes")
                except SystemExit:
                    print("  That isn't a job on your Jenkins, so it wasn't saved.")
    elif cwd:
        print(f"  {cwd} is already watched.")
    else:
        print(f"  This folder isn't in a clone. To watch one later: {CMD} jenkins watch <folder> <job>")
    print()
    print("== Step 3 of 3: notes in the wiki")
    print("When a failure the tick saw is fixed, it can save a note in the wiki that covers the clone: what")
    print("failed, the first line of the error, never the log itself. A later session that meets the same")
    print("error finds it. This writes into a wiki, so it is off until you say yes.")
    conf = settings()
    remember = ask_yn("Save a note when a failure is fixed?", conf["remember"])
    set_conf(CONFIG, "remember", "yes" if remember else "")
    conf = settings()
    print()
    print("What is set")
    miss = sign_in_missing(conf)
    print("  Sign-in   " + (f"not set up: {miss}" if miss else f"{conf['url']}, as {conf['user']}"))
    print("  watch     " + (", ".join(f"{f}={j}" for f, j in conf["watch"]) or "nothing yet"))
    if conf["job_pattern"]:
        print("  pattern   " + conf["job_pattern"] + (": such a clone is watched when a session starts in it" if conf["job_auto"] else ": such a clone needs no job named"))
    print("  notes     " + ("on: a fixed failure is noted in its wiki" if conf["remember"] else "off"))
    print("  notices   " + ("on: a failing build is handed to the next session on its branch" if conf["notice"] else "off"))
    print("  desktop   " + ("on: and shown as a desktop notification, if this machine can" if conf["desktop"] else "off"))
    print()
    print("What happens now")
    print(f"  To look now: {CMD} jenkins check")
    print(f"  The tick runs about once a day, when a session starts; {CMD} extensions every jenkins 1h makes it hourly.")
    print(f"  To have it run with no session open, and show a desktop notification: {CMD} extensions schedule on")
    print(f"  Every setting is in {CONFIG}, and {CMD} jenkins --help lists them.")
    return 0


def source_name(src):
    if not src:
        return "default"
    if src == "this file":
        return "file"
    return f"environment ({src})"


def setting_rows():
    """One row for each setting a session may look at: key, value, where from, meaning, and whether a session can change it.
    Reads files and the environment only: it never runs token_cmd and never touches the network, and a token's value
    is never in it."""
    own = read_conf(CONFIG)
    conf = settings()
    src = conf["_from"]
    mac = on_mac()
    # Once there is a way to get the token, the address and the user are not for a session: the token would go to
    # whatever address it set.
    rows = [
        ("url", conf["url"], source_name(src["url"]), f"Your Jenkins. The user runs {CMD} extensions setup jenkins in a terminal: it asks for the address, "
         f"the user and where the token comes from. Then {CMD} jenkins config tests it", "terminal"),
        ("user", conf["user"], source_name(src["user"]), "Your Jenkins user name. Part of that setup", "terminal"),
    ]
    tok_from = "environment (" + TOKEN_ENV + ")" if os.environ.get(TOKEN_ENV) else ("file" if conf["token_cmd"] else "")
    rows.append(("token", "set" if os.environ.get(TOKEN_ENV) else ("not checked (token_cmd is set)" if conf["token_cmd"] else "not set"), tok_from,
                 "The user makes one in Jenkins (user, Configure, API Token) and "
                 + ("runs in their own terminal: security add-generic-password -a \"$USER\" -s jenkins -U -w \"$(pbpaste)\""
                    if mac else "keeps it in their own password manager, such as pass"), "terminal"))
    cmd = conf["token_cmd"]
    shown = "keychain" if cmd == KEYCHAIN_CMD else ("custom command" if cmd else "")
    what = "Where the token comes from: the keychain command the setup offers, or a command of your own. Part of that setup"
    rows.append(("token_cmd", shown, "file" if cmd else "default", what, "terminal"))
    rows += [
        ("watch", ", ".join(f"{f}={j}" for f, j in conf["watch"]), "file" if "watch" in own else "default",
         "folder=job pairs the tick looks at, separated by commas", "set"),
        ("job_pattern", conf["job_pattern"], "file" if "job_pattern" in own else "default",
         "How jobs are named after a clone's remote, such as Platform/{path} ({path}: the path with %2F; {folders}: as folders; "
         "{name}: its last part). A clone with a Jenkinsfile then needs no job named", "set"),
        ("job_remote", conf["job_remote"], "file" if "job_remote" in own else "default",
         "The start of the remotes job_pattern is for, such as gitlab.com/yourgroup. Empty: any", "set"),
        ("job_auto", "yes" if conf["job_auto"] else "no", "file" if "job_auto" in own else "default",
         "yes: such a clone is watched when a session starts in it, without asking", "set"),
        ("remember", "yes" if conf["remember"] else "no", "file" if "remember" in own else "default",
         "yes: save a note when a failure is fixed (the error's first line, never the log)", "set"),
        ("notice", "yes" if conf["notice"] else "no", "file" if "notice" in own else "default",
         "yes: a build that starts failing is handed to the next session in that clone", "set"),
        ("desktop", "yes" if conf["desktop"] else "no", "file" if "desktop" in own else "default",
         "yes: a failing build also shows a desktop notification, if this machine can", "set"),
    ]
    return rows


def wiki_settings():
    for row in setting_rows():
        print("\t".join(" ".join(str(f).split()) for f in row))
    return 0


def secret_key(key):
    k = key.lower()
    if k == "token_cmd":
        return False
    return any(w in k for w in ("token", "password", "passwd", "secret", "api_key", "apikey", "credential", "auth"))


def signin_key(key):
    """A sign-in setting is never set, changed or cleared from a session, whatever it is now: a session that was misled
    could otherwise have the token sent somewhere else."""
    die_usage(f"{key} is part of the sign-in, and a session never sets it: a session that was misled could have the token sent somewhere else. "
              f"The user sets up sign-in in a terminal: {CMD} extensions setup jenkins")


def wiki_set(args):
    """--wiki-set <key> <value>: check the key and the shape of the value, then write it where
    the interactive setup would. A - clears it. Exit 2, and one line why, for what it refuses."""
    if len(args) != 2:
        die_usage("usage: --wiki-set <key> <value>")
    for what, text in (("key", args[0]), ("value", args[1])):
        if unfit(text):
            die_usage(f"the {what} {unfit(text)}, so nothing was written")
    key, value = args[0].strip(), args[1].strip()
    names = [r[0] for r in setting_rows()]
    if secret_key(key):
        die_usage(f"{key} is a secret, and a session never sets one. The user sets up sign-in in a terminal: {CMD} extensions setup jenkins")
    if key in ("url", "user", "token_cmd"):
        signin_key(key)
    if key not in names:
        die_usage(f"no setting called {key}. Settings: {', '.join(n for n in names if n != 'token')}")
    if not value:
        die_usage(f"give {key} a value, or - to clear it")
    if "#" in value:
        die_usage(f"{key} can't hold a #, which starts a comment in the settings file")
    clear = value == "-"
    out = ""
    if key == "watch":
        if not clear:
            parts = [p.strip() for p in value.split(",") if p.strip()]
            if not parts:
                die_usage("watch takes folder=job entries separated by commas, such as ~/dev/app=team/app")
            entries = []
            for p in parts:
                if "=" not in p:
                    die_usage(f"{p} isn't folder=job, such as ~/dev/app=team/app")
                f, j = p.rsplit("=", 1)
                full = os.path.expanduser(f.strip())
                if not os.path.isabs(full):
                    die_usage(f"{f.strip()} isn't an absolute path. Give a path from / or ~/")
                if not os.path.isdir(full):
                    die_usage(f"{f.strip()} isn't a folder that exists")
                why = job_problem(j.strip())
                if why:
                    die_usage(f"the job {clean(j, 60)!r} {why}")
                if (full, j.strip()) not in entries:
                    entries.append((full, j.strip()))
            out = ", ".join(f"{f}={j}" for f, j in entries)
    elif key == "job_pattern":
        if not clear:
            why = pattern_problem(value)
            if why:
                die_usage(f"{clean(value, 80)!r} {why}. It is a job's path with {{path}}, {{folders}} or {{name}} in it, such as Platform/{{path}}")
            out = value
    elif key == "job_remote":
        if not clear:
            if not REMOTE_TEXT.match(value) or ".." in value or len(value) > 200:
                die_usage("job_remote is the start of a remote's address, host first, such as gitlab.com/yourgroup: letters, digits and . _ - / only")
            out = value
    else:
        if not clear and value.lower() not in ("yes", "no"):
            die_usage(f"{key} takes yes or no")
        out = "" if clear else value.lower()
    set_conf(CONFIG, key, out)
    line = f"{key} {'cleared' if not out else 'set'} in {CONFIG}"
    print(line)
    return 0


def main(argv):
    if argv and argv[0] == "--wiki-settings":
        return wiki_settings()
    if argv and argv[0] == "--wiki-set":
        return wiki_set(argv[1:])
    if argv and argv[0] == "--wiki-event":
        return on_event(argv[1:])
    if argv and argv[0] == "--wiki-watches":
        return wiki_watches(argv[1:])
    if argv and argv[0] == "--wiki-ready":
        conf = settings()
        msg = sign_in_missing(conf)
        if not msg and url_problem(conf["url"]):
            msg = f"{'JENKINS_URL' if conf['_from'].get('url') == 'JENKINS_URL' else 'url in ' + CONFIG} {url_problem(conf['url'])}"
        if msg:
            print(msg)
        return 1 if msg else 0
    if argv and argv[0] == "--wiki-setup":
        return setup()
    if argv and argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if argv and argv[0] == "watch":
        return cmd_watch(argv[1:])
    if argv and argv[0] == "unwatch":
        return cmd_unwatch(argv[1:])
    if argv and argv[0] == "config":
        return cmd_config(argv[1:])
    if argv and argv[0] == "check":
        argv = argv[1:]
    return cmd_check(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
