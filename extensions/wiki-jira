# Where a value came from, in the words --wiki-settings uses.
SOURCES = {"this file": "file", "the shared file": "shared file", "token_cmd": "file",
           "token_cmd in the shared file": "shared file"}


def source_name(src):
    if not src:
        return "default"
    if src in SOURCES:
        return SOURCES[src]
    return f"environment ({src})"


def own_value(own, env_name, key):
    """A setting of Jira's own, from the environment or its file, and where it came from."""
    if os.environ.get(env_name):
        return os.environ[env_name], source_name(env_name)
    if own.get(key):
        return own[key], "file"
    return "", "default"


def on_mac():
    """Whether the keychain preset fits this machine. LLM_WIKI_TEST_OS lets the tests see both answers."""
    return (os.environ.get("LLM_WIKI_TEST_OS") or sys.platform) == "darwin"


def setting_rows():
    """One row for each setting a session may look at: key, value, where from, meaning, and
    whether a session can change it. Reads files and the environment only: it never runs
    token_cmd and never touches the network, and a token's value is never in it."""
    own = read_conf(CONFIG)
    conf = settings()
    src = conf["_from"]
    mac = on_mac()
    rows = [
        ("site", conf["url"], source_name(src["url"]), "Jira's address, https://your-company.atlassian.net or your server's", "set"),
        ("email", conf.get("email", ""), source_name(src["email"]), "Atlassian account email; empty on Data Center", "set"),
    ]
    tok_env = next((n for n in TOKEN_ENV if os.environ.get(n)), "")
    tok_from = source_name(tok_env) if tok_env else (source_name(src["token_cmd"]) if conf.get("token_cmd") else "")
    rows.append(("token", "set" if tok_env else ("not checked (token_cmd is set)" if conf.get("token_cmd") else "not set"), tok_from,
                 "The user makes one at https://id.atlassian.com/manage-profile/security/api-tokens "
                 "(Data Center: a personal access token) and "
                 + ("runs in their own terminal: security add-generic-password -a \"$USER\" -s atlassian -U -w \"$(pbpaste)\""
                    if mac else "keeps it in their own password manager, such as pass"), "terminal"))
    cmd = conf.get("token_cmd", "")
    shown = "keychain" if cmd == KEYCHAIN_CMD else ("custom command" if cmd else "")
    if mac:
        what = f"Then set this to keychain, and run {CMD} jira config, which contacts the site, to test sign-in"
    else:
        what = f"A command that prints the token, such as pass show atlassian. The user sets it in a terminal: {CMD} extensions setup jira"
    rows.append(("token_cmd", shown, source_name(src["token_cmd"]) if cmd else "default", what, "set" if mac else "terminal"))
    for key, env_name, what in (
            ("projects", "JIRA_PROJECTS", "Ticket project keys, such as PROJ, OPS; empty: any"),
            ("auto_close", "JIRA_AUTO_CLOSE", "yes: finished tickets close their open items, checked in the background"),
            ("done_statuses", "JIRA_DONE_STATUSES", "Statuses that mean finished, such as Released; empty: what Jira counts as done")):
        value, where = own_value(own, env_name, key)
        rows.append((key, value, where, what, "set"))
    return rows


def wiki_settings():
    for row in setting_rows():
        print("\t".join(" ".join(str(f).split()) for f in row))
    return 0


def secret_key(key):
    k = key.lower()
    if k == "token_cmd":
        return False
    return any(w in k for w in ("token", "password", "passwd", "secret", "api_key", "apikey"))


WIN_ENV = {"projects": "JIRA_PROJECTS", "auto_close": "JIRA_AUTO_CLOSE", "done_statuses": "JIRA_DONE_STATUSES"}


def wiki_set(args):
    """--wiki-set <key> <value>: check the key and the shape of the value, then write it where
    the interactive setup would. A - clears it. Exit 2, and one line why, for what it refuses."""
    if len(args) != 2:
        die_usage("usage: --wiki-set <key> <value>")
    for what, text in (("key", args[0]), ("value", args[1])):
        if unfit(text):
            die_usage(f"the {what} {unfit(text)}, so nothing was written")
    key, value = args[0].strip(), args[1].strip()
    names = [r[0] for r in setting_rows()]
    if secret_key(key):
        die_usage(f"{key} is a secret, and a session never sets one. The user puts the token in their keychain themselves, and then {CMD} extensions set jira token_cmd keychain")
    if key not in names:
        die_usage(f"no setting called {key}. Settings: {', '.join(n for n in names if n != 'token')}")
    if not value:
        die_usage(f"give {key} a value, or - to clear it")
    if "#" in value:
        die_usage(f"{key} can't hold a #, which starts a comment in the settings file")
    clear = value == "-"
    path = CONFIG
    if key == "site":
        path = SHARED
        if not clear and (not value.startswith(("http://", "https://")) or len(value.split()) != 1 or value.count("://") != 1):
            die_usage("site isn't an address: it starts with https:// or http://, with no spaces")
        out = "" if clear else value.rstrip("/")
    elif key == "email":
        path = SHARED
        if not clear and (len(value.split()) != 1 or "@" not in value):
            die_usage(f"{key} isn't an email address: it needs an @ and no spaces")
        out = "" if clear else value
    elif key == "token_cmd":
        path = SHARED
        if clear:
            out = ""
        elif value != "keychain":
            die_usage(f"token_cmd takes only the preset keychain from a session. The user sets a command of their own in a terminal: {CMD} extensions setup jira")
        elif not on_mac():
            die_usage(f"the keychain preset is macOS's. On this machine the user sets token_cmd in a terminal: {CMD} extensions setup jira")
        else:
            out = KEYCHAIN_CMD
    elif key == "projects":
        parts = [x.strip() for x in value.split(",") if x.strip()]
        if not clear and (not parts or not all(re.fullmatch(r"[A-Za-z][A-Za-z0-9]{1,9}", x) for x in parts)):
            die_usage("projects takes project keys separated by commas, such as PROJ, OPS")
        out = "" if clear else ", ".join(x.upper() for x in parts)
    elif key == "auto_close":
        if not clear and value.lower() not in ("yes", "no"):
            die_usage("auto_close takes yes or no")
        out = "yes" if value.lower() == "yes" else ""
    else:
        out = "" if clear else value
    file_key = key
    set_conf(path, file_key, out)
    line = f"{key} {'cleared' if not out else 'set'} in {path}"
    env = WIN_ENV.get(key)
    if env and os.environ.get(env):
        line += f", but {env} is set, and it wins"
    elif key in ("site", "email"):
        for name in (("JIRA_URL", "ATLASSIAN_SITE") if key == "site" else ("JIRA_EMAIL", "ATLASSIAN_EMAIL")):
            if os.environ.get(name):
                line += f", but {name} is set, and it wins"
                break
    print(line)
    return 0


def main(argv):
    if argv and argv[0] == "--wiki-settings":
        return wiki_settings()
    if argv and argv[0] == "--wiki-set":
        return wiki_set(argv[1:])
    if argv and argv[0] == "--wiki-event":
        return on_event(argv[1:])
    if argv and argv[0] == "--wiki-ready":
        msg = sign_in_missing(settings())
        if msg:
            print(msg)
        return 1 if msg else 0
    if argv and argv[0] == "--wiki-setup":
        return setup()
    if argv and argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if argv and argv[0] == "show":
        return cmd_show(argv[1:])
    if argv and argv[0] == "config":
        return cmd_config(argv[1:])
    if argv and argv[0] == "check":
        argv = argv[1:]
    return cmd_check(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
